// Composants réutilisables, dans le style « verre dépoli + pixel » de Misty.

import { Theme, Tr, Assets, Bulle } from "theme.slint";
import { ListView } from "std-widgets.slint";

// ───────────────────────── Textes ─────────────────────────

export component Icon inherits Text {
    font-family: Theme.icon-font;
    font-size: 16px;
    color: Theme.icon;
    horizontal-alignment: center;
    vertical-alignment: center;
}

/// Icône vectorielle du thème Nuit (mêmes tracés que la maquette Figma), par son nom :
/// accueil, decouvrir, garde-robe, instances, amis, reglages, nuage, dossier, plus, fermer,
/// reduire, agrandir, restaurer, chevron, suivant, retour, lien-externe, globe, couches, console,
/// info, check, telecharger, rafraichir ; pleines : jouer, options.
export component IconeNuit inherits Rectangle {
    in property <string> nom;
    in property <length> taille: 20px;
    in property <color> couleur: Theme.icon;
    width: root.taille;
    height: root.taille;
    property <bool> pleine: root.nom == "jouer" || root.nom == "options";
    Path {
        width: root.taille;
        height: root.taille;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.pleine ? transparent : root.couleur;
        stroke-width: max(1.2px, root.taille / 12);
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: root.pleine ? root.couleur : transparent;
        commands: root.nom == "accueil" ? "M3 10.5 12 3l9 7.5 M5 9.5V21h14V9.5 M10 21v-6h4v6"
            : root.nom == "decouvrir" ? "M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M15.5 8.5l-2 5-5 2 2-5 5-2Z"
            : root.nom == "garde-robe" ? "M8 3 3 6l2 4 3-1v12h8V9l3 1 2-4-5-3c0 1.7-1.8 3-4 3S8 4.7 8 3Z"
            : root.nom == "instances" ? "M6 4h12a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z M6 13h12a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2Z"
            : root.nom == "amis" ? "M5.5 8a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0 -7 0 M2.5 20a6.5 6.5 0 0 1 13 0 M16 4.6a3.5 3.5 0 0 1 0 6.8 M18.5 14.2A6.5 6.5 0 0 1 21.5 20"
            : root.nom == "reglages" ? "M9 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0 M12 2.5v2.5 M12 19v2.5 M2.5 12H5 M19 12h2.5 M5.3 5.3l1.8 1.8 M16.9 16.9l1.8 1.8 M5.3 18.7l1.8-1.8 M16.9 7.1l1.8-1.8"
            : root.nom == "nuage" ? "M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"
            : root.nom == "dossier" ? "M3 7a2 2 0 0 1 2-2h4l2 2.5h8a2 2 0 0 1 2 2V18a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"
            : root.nom == "plus" ? "M12 5v14 M5 12h14"
            : root.nom == "fermer" ? "M6 6l12 12 M18 6 6 18"
            : root.nom == "reduire" ? "M5 12h14"
            : root.nom == "agrandir" ? "M7.5 5h9a2.5 2.5 0 0 1 2.5 2.5v9a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 5 16.5v-9A2.5 2.5 0 0 1 7.5 5Z"
            : root.nom == "restaurer" ? "M7 9h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2Z M9 5h8a2 2 0 0 1 2 2v8"
            : root.nom == "chevron" ? "M6 9l6 6 6-6"
            : root.nom == "suivant" ? "M5 12h14 M13 6l6 6-6 6"
            : root.nom == "retour" ? "M19 12H5 M11 18l-6-6 6-6"
            : root.nom == "lien-externe" ? "M14 4h6v6 M20 4l-9 9 M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"
            : root.nom == "globe" ? "M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M3 12h18 M12 3c2.5 2.5 3.5 5.5 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-5.5-3.5-9s1-6.5 3.5-9Z"
            : root.nom == "couches" ? "M12 3 3 7.5l9 4.5 9-4.5L12 3Z M3 12l9 4.5 9-4.5 M3 16.5l9 4.5 9-4.5"
            : root.nom == "console" ? "M4 6l6 6-6 6 M12 18h8"
            : root.nom == "info" ? "M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M12 8h.01 M11 12h1v5h1"
            : root.nom == "check" ? "M5 12l5 5 9-10"
            : root.nom == "telecharger" ? "M12 4v12 M6 11l6 6 6-6 M5 20h14"
            : root.nom == "rafraichir" ? "M21 12a9 9 0 1 1-3-6.7L21 8 M21 3v5h-5"
            : root.nom == "recherche" ? "M4 11a7 7 0 1 0 14 0a7 7 0 1 0 -14 0 M20 20l-3.5-3.5"
            : root.nom == "poubelle" ? "M4 7h16 M10 11v6 M14 11v6 M6 7l1 13h10l1-13 M9 7V4h6v3"
            : root.nom == "crayon" ? "M4 20h4L19 9l-4-4L4 16v4Z"
            : root.nom == "exporter" ? "M12 15V3 M7 8l5-5 5 5 M5 21h14"
            : root.nom == "copier" ? "M10 8h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2Z M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"
            : root.nom == "annuler" ? "M9 14 4 9l5-5 M4 9h10a6 6 0 0 1 0 12h-3"
            : root.nom == "retablir" ? "M15 14l5-5-5-5 M20 9H10a6 6 0 0 0 0 12h3"
            : root.nom == "avertissement" ? "M12 4 2.5 20h19L12 4Z M12 10v4 M12 17h.01"
            : root.nom == "etoile" ? "M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9Z"
            : root.nom == "ailes" ? "M12 7c-3 0-7.5 2-9.5 6.5 2.2-.2 4.2.8 5.2 2.8C8.6 13 10 9.8 12 7Z M12 7c3 0 7.5 2 9.5 6.5-2.2-.2-4.2.8-5.2 2.8C15.4 13 14 9.8 12 7Z"
            : root.nom == "cape" ? "M7 4h10l2 16-7-3-7 3Z M9 4c0 2 1.3 3 3 3s3-1 3-3"
            : root.nom == "etiquette" ? "M3 12V4h8l10 10-8 8L3 12Z M7.5 8.5h.01"
            : root.nom == "cadenas" ? "M7 11h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2Z M8 11V8a4 4 0 0 1 8 0v3"
            : root.nom == "jouer" ? "M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z"
            : root.nom == "options" ? "M3.2 12a1.8 1.8 0 1 0 3.6 0a1.8 1.8 0 1 0 -3.6 0 M10.2 12a1.8 1.8 0 1 0 3.6 0a1.8 1.8 0 1 0 -3.6 0 M17.2 12a1.8 1.8 0 1 0 3.6 0a1.8 1.8 0 1 0 -3.6 0"
            : "";
        animate stroke, fill { duration: Theme.fast; }
    }
}

/// Icône d'un code Segoe MDL2 (« \u{E896} »…) dessinée avec les tracés du thème Nuit quand elle
/// en a un : mêmes icônes sous Windows et Linux (où la police Segoe n'existe pas).
export component IconeAuto inherits Rectangle {
    in property <string> code;
    in property <length> taille: 14px;
    in property <color> couleur: Theme.icon;
    property <string> nom: root.code == "\u{E896}" ? "telecharger"
        : root.code == "\u{E73E}" || root.code == "\u{E74E}" ? "check"
        : root.code == "\u{E74D}" ? "poubelle"
        : root.code == "\u{E895}" || root.code == "\u{E72C}" || root.code == "\u{E777}" ? "rafraichir"
        : root.code == "\u{E710}" ? "plus"
        : root.code == "\u{E8B7}" || root.code == "\u{E838}" || root.code == "\u{E8E5}" || root.code == "\u{E8DA}" ? "dossier"
        : root.code == "\u{E8BB}" || root.code == "\u{E711}" ? "fermer"
        : root.code == "\u{E72B}" ? "retour"
        : root.code == "\u{E72A}" || root.code == "\u{E76C}" ? "suivant"
        : root.code == "\u{E70D}" ? "chevron"
        : root.code == "\u{E7BA}" ? "avertissement"
        : root.code == "\u{E721}" || root.code == "\u{E71E}" ? "recherche"
        : root.code == "\u{E946}" || root.code == "\u{E9CE}" ? "info"
        : root.code == "\u{E77B}" || root.code == "\u{E716}" ? "amis"
        : root.code == "\u{E756}" ? "console"
        : root.code == "\u{E753}" ? "nuage"
        : root.code == "\u{E734}" ? "etoile"
        : root.code == "\u{E7C1}" ? "cape"
        : root.code == "\u{E709}" ? "ailes"
        : root.code == "\u{E8EC}" ? "etiquette"
        : root.code == "\u{E72E}" ? "cadenas"
        : root.code == "\u{E70F}" ? "crayon"
        : root.code == "\u{E713}" ? "reglages"
        : root.code == "\u{E8A7}" ? "lien-externe"
        : root.code == "\u{E768}" ? "jouer"
        : root.code == "\u{E898}" ? "exporter"
        : root.code == "\u{E8C8}" ? "copier"
        : root.code == "\u{E7A7}" ? "annuler"
        : root.code == "\u{E7A6}" ? "retablir"
        : root.code == "\u{E80F}" ? "accueil"
        : root.code == "\u{E8F1}" ? "couches"
        : root.code == "\u{E774}" ? "globe"
        : "";
    width: root.taille;
    height: root.taille;
    if root.nom != "": IconeNuit {
        nom: root.nom;
        taille: root.taille;
        couleur: root.couleur;
    }
    if root.nom == "": Icon {
        text: root.code;
        font-size: root.taille * 0.85;
        color: root.couleur;
    }
}

/// Bouton rond de la barre du haut (52 px, comme la maquette) : gris foncé cerclé, blanc quand il
/// est actif. Il grossit à peine au survol et s'enfonce au clic.
export component BoutonRond inherits Rectangle {
    in property <string> icone;
    in property <bool> actif;
    in property <string> tooltip;
    in property <length> taille: 48px;
    in property <bool> enabled: true;
    callback clicked;
    width: root.taille;
    height: root.taille;
    border-radius: root.taille / 2;
    background: root.actif ? Theme.active : zone.has-hover && root.enabled ? Theme.glass-hover : Theme.control;
    border-width: 1.5px;
    border-color: root.actif ? Theme.active : zone.has-hover && root.enabled ? Theme.ink-3 : Theme.border-strong;
    opacity: root.enabled ? 1 : 0.5;
    transform-scale: zone.pressed && root.enabled ? 0.9 : zone.has-hover && root.enabled ? 1.05 : 1;
    animate background, border-color { duration: Theme.normal; easing: ease-out; }
    animate transform-scale { duration: 200ms; easing: cubic-bezier(0.34, 1.4, 0.64, 1); }
    IconeNuit {
        nom: root.icone;
        taille: root.taille * 0.4;
        couleur: root.actif ? Theme.on-active : Theme.icon;
    }
    zone := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            Bulle.visible = false;
            root.clicked();
        }
    }
    property <bool> survol: zone.has-hover && root.tooltip != "";
    changed survol => {
        if (self.survol) {
            Bulle.texte = root.tooltip;
            Bulle.x = root.absolute-position.x + root.width / 2;
            Bulle.y = root.absolute-position.y + root.height + 8px;
            Bulle.a-droite = false;
            Bulle.visible = true;
        } else if (Bulle.texte == root.tooltip) {
            Bulle.visible = false;
        }
    }
}

/// Petite pastille de texte (« HUD », « Cosmétiques »…), grise et cerclée.
export component Puce inherits Rectangle {
    in property <string> text;
    in property <bool> actif;
    height: 28px;
    width: lab.preferred-width + 24px;
    border-radius: 14px;
    background: root.actif ? Theme.active : Theme.control;
    border-width: 1.5px;
    border-color: root.actif ? Theme.active : Theme.border-strong;
    lab := Text {
        text: root.text;
        font-family: Theme.ui-font;
        font-size: 12.5px;
        color: root.actif ? Theme.on-active : Theme.icon;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// Carte du thème Nuit : fond « surface », bord fin, grands coins.
export component CarteNuit inherits Rectangle {
    background: Theme.surface;
    border-width: 1.5px;
    border-color: Theme.border;
    border-radius: 24px;
}

/// Libellé court en capitales (« COMPTE », « VERSIONS », étiquettes) : police d'interface en gras,
/// un peu espacée. (Le pixel reste pour les grands titres : il est illisible en petit.)
export component PixelLabel inherits Text {
    font-family: Theme.mono-font;
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.8px;
    color: Theme.ink-3;
    vertical-alignment: center;
}

/// Titre de section (dans une page ou une fenêtre).
export component SectionTitle inherits Text {
    font-family: Theme.ui-font;
    font-size: 20px;
    font-weight: 600;
    color: Theme.ink-strong;
}

export component BodyText inherits Text {
    font-family: Theme.ui-font;
    font-size: 13px;
    color: Theme.text-muted;
    wrap: word-wrap;
}

/// Texte avec contour et ombre portée « en bloc » (style titre pixel).
export component OutlinedText inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 48px;
    in property <color> fill: white;
    in property <color> stroke-color: Theme.slate;
    in property <length> thickness: 4px;
    in property <color> shadow: Theme.slate-dark;
    in property <length> depth: 0px;
    in property <TextHorizontalAlignment> align: left;

    min-width: principal.preferred-width + root.thickness * 2;
    min-height: principal.preferred-height + root.thickness * 2 + root.depth;
    preferred-width: self.min-width;
    preferred-height: self.min-height;
    max-height: self.min-height;
    vertical-stretch: 0;

    if root.depth > 0: Text {
        x: root.thickness;
        y: root.thickness + root.depth;
        width: parent.width - root.thickness * 2;
        text: root.text;
        font-family: Theme.pixel-font;
        font-size: root.font-size;
        color: root.shadow;
        stroke: root.shadow;
        stroke-width: root.thickness;
        stroke-style: outside;
        horizontal-alignment: root.align;
    }
    principal := Text {
        x: root.thickness;
        y: root.thickness;
        width: parent.width - root.thickness * 2;
        text: root.text;
        font-family: Theme.pixel-font;
        font-size: root.font-size;
        color: root.fill;
        stroke: root.stroke-color;
        stroke-width: root.thickness;
        stroke-style: outside;
        horizontal-alignment: root.align;
    }
}

// ───────────────────────── Conteneurs ─────────────────────────

export component GlassCard inherits Rectangle {
    background: Theme.surface;
    border-width: 1.5px;
    border-color: Theme.border;
    border-radius: 22px;
}

/// Carré sombre avec une image (icône de projet, de profil…), le bloc d'herbe en attendant.
export component Thumb inherits Rectangle {
    in property <image> source;
    in property <bool> has-image;
    in property <length> radius: 14px;
    in property <length> logo-margin: 14px;
    in property <float> logo-opacity: 0.6;
    in property <length> border: 0px;
    in property <bool> pixel-art: false;

    background: Theme.control;
    border-radius: root.radius;
    border-width: root.border;
    border-color: white;
    clip: true;

    Image {
        x: root.logo-margin;
        y: root.logo-margin;
        width: parent.width - root.logo-margin * 2;
        height: parent.height - root.logo-margin * 2;
        source: Assets.logo;
        image-fit: contain;
        image-rendering: smooth;
        opacity: root.logo-opacity;
        visible: !root.has-image;
    }
    if root.has-image: Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: cover;
        image-rendering: root.pixel-art ? ImageRendering.pixelated : ImageRendering.smooth;
    }
}

/// Petite étiquette colorée ("1.20.1", "FABRIC"…).
export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> couleur: Theme.control;
    in property <length> font-size: 11.5px;
    background: root.couleur;
    border-radius: self.height / 2;
    height: label.preferred-height + 8px;
    width: label.preferred-width + 18px;
    label := Text {
        text: root.text;
        font-family: Theme.ui-font;
        font-size: root.font-size;
        font-weight: 600;
        letter-spacing: 0.4px;
        color: root.couleur == Theme.control ? Theme.ink-4 : root.couleur == Theme.active ? Theme.on-active : white;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ───────────────────────── Boutons ─────────────────────────

/// Bouton texte en pilule (thème Nuit) : il s'éclaircit au survol et s'enfonce un peu au clic.
/// kind : 0 = secondaire, 1 = principal, 2 = danger, 3 = vert.
export component MButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <int> kind: 0;
    in property <bool> enabled: true;
    /// L'icône tourne (recherche en cours) sans changer la taille du bouton
    in property <bool> icon-spin: false;
    callback clicked;

    height: 40px;
    min-width: contenu.preferred-width;
    opacity: root.enabled ? 1 : 0.5;
    animate opacity { duration: Theme.normal; }

    property <color> fond: root.kind == 1 ? Theme.active : root.kind == 2 ? Theme.danger : root.kind == 3 ? Theme.online-text : Theme.control;
    property <color> encre: root.kind == 0 ? Theme.icon : root.kind == 1 ? Theme.on-active : white;
    property <bool> survol: touch.has-hover && root.enabled;
    property <bool> appui: touch.pressed && root.enabled;

    face := Rectangle {
        border-radius: self.height / 2;
        border-width: root.kind == 0 ? 1.5px : 0px;
        border-color: root.survol ? Theme.ink-3 : Theme.border-strong;
        background: root.appui ? root.fond.darker(0.12) : root.survol ? (root.kind == 0 ? Theme.glass-hover : root.fond.brighter(0.08)) : root.fond;
        transform-scale: root.appui ? 0.96 : 1;
        animate background, border-color { duration: Theme.fast; easing: ease-out; }
        animate transform-scale { duration: 140ms; easing: ease-out; }

        contenu := HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            spacing: 8px;
            alignment: center;
            if root.icon != "": VerticalLayout {
                alignment: center;
                IconeAuto {
                    code: root.icon;
                    taille: 15px;
                    couleur: root.encre;
                    transform-rotation: root.icon-spin ? (animation-tick() / 900ms) * 360deg : 0deg;
                }
            }
            Text {
                text: root.text;
                font-family: Theme.ui-font;
                font-size: 13.5px;
                font-weight: 500;
                color: root.encre;
                vertical-alignment: center;
            }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Bouton carré avec une icône (et une bulle d'aide au survol).
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> tooltip;
    in property <bool> enabled: true;
    in property <color> fond: Theme.control;
    in property <color> encre: Theme.icon;
    in property <color> bord: Theme.border-strong;
    in property <length> icon-size: 15px;
    callback clicked;

    width: 40px;
    height: 40px;
    border-radius: self.width / 2;
    border-width: 1.5px;
    border-color: touch.has-hover && root.enabled ? Theme.ink-3 : root.bord;
    background: touch.pressed ? root.fond.darker(0.1) : touch.has-hover && root.enabled ? Theme.glass-hover : root.fond;
    opacity: root.enabled ? 1 : 0.5;
    transform-scale: touch.pressed && root.enabled ? 0.9 : 1;
    animate background, border-color { duration: Theme.fast; }
    animate transform-scale { duration: 140ms; easing: ease-out; }

    IconeAuto {
        code: root.icon;
        taille: root.icon-size + 3px;
        couleur: root.encre;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            Bulle.visible = false;
            root.clicked();
        }
    }

    // Bulle d'aide : affichée par la fenêtre, sous le bouton
    property <bool> survol: touch.has-hover && root.tooltip != "";
    changed survol => {
        if (self.survol) {
            Bulle.texte = root.tooltip;
            Bulle.x = root.absolute-position.x + root.width / 2;
            Bulle.y = root.absolute-position.y + root.height + 6px;
            Bulle.a-droite = false;
            Bulle.visible = true;
        } else if (Bulle.texte == root.tooltip) {
            Bulle.visible = false;
        }
    }
}

/// Bouton de la barre de titre (réduire / agrandir / fermer).
export component ChromeButton inherits Rectangle {
    in property <string> icon;
    in property <bool> close: false;
    in property <color> encre: Theme.icon;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    border-width: 1.5px;
    border-color: touch.has-hover && root.close ? Theme.danger : Theme.border-strong;
    background: touch.has-hover ? (root.close ? Theme.danger : Theme.glass-hover) : Theme.control;
    animate border-color { duration: Theme.fast; }
    transform-scale: touch.pressed ? 0.9 : 1;
    animate background { duration: Theme.fast; }
    animate transform-scale { duration: 120ms; easing: ease-out; }
    Icon {
        text: root.icon;
        font-size: 9px;
        color: touch.has-hover && root.close ? white : root.encre;
        animate color { duration: Theme.fast; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Le gros bouton « JOUER » : une pilule blanche (thème Nuit), le texte en pixel.
export component PlayButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> font-size: 24px;
    /// Icône au-dessus du texte (bouton Logs, à côté de Jouer)
    in property <string> icon;
    in property <length> icon-size: 24px;
    callback clicked;

    property <bool> survol: touch.has-hover && root.enabled;
    property <bool> appui: touch.pressed && root.enabled;
    border-radius: self.height / 2;
    background: !root.enabled ? Theme.control : root.appui ? Theme.active.darker(0.08) : root.survol ? Theme.fill-hover : Theme.active;
    drop-shadow-blur: root.survol ? 22px : 0px;
    drop-shadow-color: Theme.active.with-alpha(0.25);
    transform-scale: root.appui ? 0.97 : root.survol ? 1.02 : 1;
    animate background { duration: Theme.fast; }
    animate transform-scale, drop-shadow-blur { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

    if root.icon == "": HorizontalLayout {
        alignment: center;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            IconeNuit {
                nom: "jouer";
                taille: root.font-size * 0.75;
                couleur: root.enabled ? Theme.on-active : Theme.ink-3;
            }
        }
        Text {
            text: root.text;
            font-family: Theme.pixel-font;
            font-weight: 700;
            font-size: root.font-size;
            letter-spacing: 2px;
            color: root.enabled ? Theme.on-active : Theme.ink-3;
            vertical-alignment: center;
        }
    }
    if root.icon != "": VerticalLayout {
        alignment: center;
        spacing: 6px;
        Text {
            text: root.icon;
            font-family: Theme.icon-font;
            font-size: root.icon-size;
            color: Theme.on-active;
            horizontal-alignment: center;
        }
        if root.text != "": Text {
            text: root.text;
            font-family: Theme.pixel-font;
            font-size: root.font-size;
            color: Theme.on-active;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Onglet en forme de pilule.
export component TabPill inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> has-dot;
    in property <color> dot;
    callback clicked;

    height: 36px;
    min-width: contenu.preferred-width;
    horizontal-stretch: 0;
    border-radius: 18px;
    border-width: 1.5px;
    border-color: root.checked ? Theme.active : touch.has-hover && root.enabled ? Theme.ink-3 : Theme.border-strong;
    background: root.checked ? Theme.active : touch.has-hover && root.enabled ? Theme.glass-hover : Theme.control;
    opacity: root.enabled ? 1 : 0.45;
    transform-scale: touch.pressed && root.enabled ? 0.95 : 1;
    animate background, border-color { duration: Theme.normal; easing: ease-out; }
    animate transform-scale { duration: 140ms; easing: ease-out; }

    contenu := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        if root.has-dot: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 9px;
                height: 9px;
                border-radius: 4.5px;
                background: root.dot;
            }
        }
        if root.icon != "": Icon {
            text: root.icon;
            font-size: 13px;
            color: root.checked ? Theme.on-fill : Theme.navy;
        }
        Text {
            text: root.text;
            font-family: Theme.ui-font;
            font-size: 13px;
            font-weight: 500;
            color: root.checked ? Theme.on-fill : Theme.icon;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ───────────────────────── Saisie ─────────────────────────

/// Champ de texte en verre (avec loupe pour les recherches).
export component GlassInput inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> search: false;
    in property <bool> enabled: true;
    in property <TextHorizontalAlignment> align: left;
    in property <length> font-size: 13px;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted(string);

    height: 42px;
    border-radius: self.height / 2;
    background: Theme.surface-2;
    border-width: 1.5px;
    border-color: input.has-focus ? Theme.ink-3 : Theme.border-field;
    animate background { duration: Theme.normal; }
    opacity: root.enabled ? 1 : 0.6;
    animate border-color { duration: Theme.normal; }

    public function focus-input() {
        input.focus();
    }
    public function select-all() {
        input.select-all();
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        if root.search: Icon {
            text: "\u{E721}";
            font-size: 13px;
            color: Theme.text-muted;
            width: 16px;
        }
        Rectangle {
            input := TextInput {
                width: parent.width;
                height: parent.height;
                enabled: root.enabled;
                single-line: true;
                vertical-alignment: center;
                horizontal-alignment: root.align;
                font-family: Theme.ui-font;
                font-size: root.font-size;
                color: Theme.text;
                selection-background-color: Theme.active.with-alpha(0.3);
                selection-foreground-color: Theme.ink-strong;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
            Text {
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                visible: input.text == "";
                vertical-alignment: center;
                horizontal-alignment: root.align;
                font-family: Theme.ui-font;
                font-size: root.font-size;
                color: Theme.text-muted;
                overflow: elide;
            }
        }
    }
}

/// Liste déroulante en verre.
export component GlassCombo inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: -1;
    in property <bool> enabled: true;
    callback selected(int);

    height: 44px;
    border-radius: self.height / 2;
    border-width: 1.5px;
    border-color: touch.has-hover && root.enabled ? Theme.ink-3 : Theme.border-strong;
    background: touch.has-hover && root.enabled ? Theme.glass-hover : Theme.control;
    opacity: root.enabled ? 1 : 0.55;
    animate border-color { duration: Theme.fast; }
    animate background { duration: Theme.fast; }

    Text {
        x: 18px;
        width: parent.width - 48px;
        text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
        font-family: Theme.ui-font;
        font-size: 13.5px;
        font-weight: 500;
        color: Theme.icon;
        vertical-alignment: center;
        overflow: elide;
    }
    IconeNuit {
        x: parent.width - 34px;
        y: (parent.height - self.height) / 2;
        nom: "chevron";
        taille: 16px;
        couleur: Theme.ink-3;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    property <length> hauteur-liste: min(320px, root.model.length * 36px + 12px);
    // pas la place en dessous du bouton : la liste s'ouvre au-dessus
    property <bool> vers-le-haut: root.absolute-position.y + root.height + 4px + self.hauteur-liste > Bulle.fenetre-hauteur - 8px && root.absolute-position.y > self.hauteur-liste + 8px;
    popup := PopupWindow {
        x: 0;
        y: root.vers-le-haut ? -self.height - 4px : root.height + 4px;
        width: root.width;
        height: root.hauteur-liste;
        Rectangle {
            background: Theme.popup;
            border-radius: 18px;
            border-width: 1.5px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow;
            drop-shadow-offset-y: 4px;
            ListView {
                x: 6px;
                y: 6px;
                width: parent.width - 12px;
                height: parent.height - 12px;
                // le contenu est recréé à chaque ouverture : on recentre la liste sur l'élément choisi
                init => {
                    if root.current-index >= 0 {
                        self.content-y = -max(0px, min(root.current-index * 36px - (self.height - 36px) / 2, root.model.length * 36px - self.height));
                    }
                }
                for item[i] in root.model: Rectangle {
                    height: 36px;
                    border-radius: 12px;
                    background: ligne.has-hover ? Theme.popup-hover : i == root.current-index ? Theme.accent-soft : transparent;
                    animate background { duration: Theme.fast; }
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: item;
                        font-family: Theme.ui-font;
                        font-size: 13px;
                        font-weight: i == root.current-index ? 700 : 500;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    ligne := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-index = i;
                            root.selected(i);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

/// Interrupteur (case à cocher en forme de bascule), avec un texte ou un contenu à droite.
export component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    /// false : l'état est piloté de l'extérieur (le clic demande seulement le changement)
    in property <bool> auto: true;
    callback toggled(bool);

    min-height: 26px;
    opacity: root.enabled ? 1 : 0.45;

    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 48px;
                height: 28px;
                border-radius: 14px;
                background: root.checked ? Theme.toggle-on : Theme.toggle-off;
                border-width: 1.5px;
                border-color: root.checked ? Theme.toggle-on : Theme.border-strong;
                animate background, border-color { duration: 220ms; easing: ease-out; }
                // le bouton : grossit un peu au survol, glisse avec un léger rebond
                Rectangle {
                    property <length> d: zone.has-hover && root.enabled ? 22px : 20px;
                    x: root.checked ? parent.width - self.d - 3px : 3px;
                    y: (parent.height - self.d) / 2;
                    width: self.d;
                    height: self.d;
                    border-radius: self.d / 2;
                    background: root.checked ? Theme.on-active : Theme.ink-3;
                    animate background { duration: 220ms; easing: ease-out; }
                    animate x { duration: 260ms; easing: cubic-bezier(0.34, 1.4, 0.64, 1); }
                    animate d { duration: 140ms; easing: ease-out; }
                }
            }
        }
        if root.text != "": Text {
            text: root.text;
            font-family: Theme.ui-font;
            font-size: 13px;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
        @children
    }
    zone := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            if (root.auto) {
                root.checked = !root.checked;
                root.toggled(root.checked);
            } else {
                root.toggled(!root.checked);
            }
        }
    }
}

/// Curseur en verre.
export component GlassSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in-out property <float> value;
    in property <float> step: 1;
    in property <color> fill: Theme.toggle-on;
    in property <brush> track: Theme.track;
    callback changed(float);

    height: 26px;

    function regler(px: length) {
        if (root.maximum <= root.minimum) {
            return;
        }
        let ratio = clamp((px - 10px) / (root.width - 20px), 0, 1);
        let brut = root.minimum + ratio * (root.maximum - root.minimum);
        let v = clamp(round(brut / root.step) * root.step, root.minimum, root.maximum);
        if (v != root.value) {
            root.value = v;
            root.changed(v);
        }
    }

    property <float> ratio: root.maximum > root.minimum ? (root.value - root.minimum) / (root.maximum - root.minimum) : 0;
    property <bool> actif: zone.pressed || zone.has-hover;

    // piste, puis la partie remplie en dégradé
    Rectangle {
        y: (parent.height - 6px) / 2;
        height: 6px;
        border-radius: 3px;
        background: root.track;
    }
    Rectangle {
        x: 0;
        y: (parent.height - 6px) / 2;
        height: 6px;
        width: 10px + (root.width - 20px) * root.ratio;
        border-radius: 3px;
        background: root.fill;
    }
    // le bouton : cerclé de la couleur, grossit pendant qu'on le tire
    Rectangle {
        property <length> d: zone.pressed ? 22px : root.actif ? 20px : 18px;
        x: 10px + (root.width - 20px) * root.ratio - self.d / 2;
        y: (parent.height - self.d) / 2;
        width: self.d;
        height: self.d;
        border-radius: self.d / 2;
        background: Theme.on-active;
        border-width: 3px;
        border-color: root.fill;
        drop-shadow-blur: root.actif ? 8px : 3px;
        drop-shadow-color: root.fill.with-alpha(0.45);
        animate d, drop-shadow-blur { duration: 140ms; easing: ease-out; }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.regler(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.regler(self.mouse-x);
            }
        }
    }
}

/// Barre de progression fine.
export component SlimProgress inherits Rectangle {
    in property <float> progress;
    height: 8px;
    border-radius: 4px;
    background: Theme.track;
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.progress, 0, 1);
        border-radius: 4px;
        background: Theme.active;
        animate width { duration: 250ms; easing: ease-out; }
    }
}

/// Icône qui tourne (chargement).
export component Spinner inherits Rectangle {
    min-height: 44px;
    Icon {
        text: "\u{E895}";
        font-size: 30px;
        color: Theme.ink-2;
        transform-rotation: (animation-tick() / 1200ms) * 360deg;
    }
}

/// Liste déroulante des langues (avec drapeaux).
export struct LangItem {
    name: string,
    /// Nom de la langue en anglais (« French »), affiché en gris
    english: string,
    flag: image,
    /// Code de la langue en majuscules (« FR »), affiché dans une pastille
    code: string,
}

export component LangCombo inherits Rectangle {
    in property <[LangItem]> model;
    in-out property <int> current-index: -1;
    callback selected(int);

    height: 44px;
    border-radius: self.height / 2;
    border-width: 1.5px;
    border-color: Theme.border-strong;
    background: touch.has-hover ? Theme.glass-hover : Theme.control;
    animate background { duration: Theme.fast; }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 36px;
        spacing: 10px;
        if root.current-index >= 0 && root.current-index < root.model.length: VerticalLayout {
            alignment: center;
            Image {
                width: 24px;
                height: 16px;
                source: root.model[root.current-index].flag;
                image-fit: cover;
            }
        }
        Text {
            text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index].name : "";
            font-family: Theme.ui-font;
            font-size: 13px;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    Icon {
        x: parent.width - 30px;
        width: 18px;
        text: "\u{E70D}";
        font-size: 10px;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    property <length> hauteur-liste: root.model.length * 40px + 12px;
    property <bool> vers-le-haut: root.absolute-position.y + root.height + 4px + self.hauteur-liste > Bulle.fenetre-hauteur - 8px && root.absolute-position.y > self.hauteur-liste + 8px;
    popup := PopupWindow {
        x: 0;
        y: root.vers-le-haut ? -self.height - 4px : root.height + 4px;
        width: root.width;
        height: root.hauteur-liste;
        Rectangle {
            background: Theme.popup;
            border-radius: 18px;
            border-width: 1.5px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow;
            VerticalLayout {
                padding: 6px;
                for item[i] in root.model: Rectangle {
                    height: 40px;
                    border-radius: 12px;
                    background: ligne.has-hover ? Theme.popup-hover : i == root.current-index ? Theme.accent-soft : transparent;
                    animate background { duration: Theme.fast; }
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                width: 24px;
                                height: 16px;
                                source: item.flag;
                                image-fit: cover;
                            }
                        }
                        Text {
                            text: item.name;
                            font-family: Theme.ui-font;
                            font-size: 13px;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }
                    ligne := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-index = i;
                            root.selected(i);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

/// Rangée de filtres en pastilles (« TOUS », « FABRIC »…) : celui choisi est plein.
export component Puces inherits HorizontalLayout {
    in property <[string]> model;
    in property <int> current;
    callback selected(int);
    spacing: 6px;
    alignment: start;
    for t[i] in root.model: Rectangle {
        property <bool> actif: i == root.current;
        height: 32px;
        width: lab.preferred-width + 28px;
        border-radius: 16px;
        background: self.actif ? Theme.active : zone.has-hover ? Theme.glass-hover : Theme.control;
        border-width: 1.5px;
        border-color: self.actif ? Theme.active : Theme.border-strong;
        animate background { duration: Theme.fast; }
        lab := Text {
            text: t;
            font-family: Theme.ui-font;
            font-size: 12px;
            font-weight: 500;
            color: parent.actif ? Theme.on-fill : Theme.icon;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        zone := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.selected(i); }
        }
    }
}

/// Petite étiquette en police pixel (version, loader…) posée sur une carte.
export component Etiquette inherits Rectangle {
    in property <string> text;
    in property <color> couleur: Theme.accent;
    height: 22px;
    width: t.preferred-width + 14px;
    border-radius: 11px;
    background: root.couleur.with-alpha(0.14);
    t := Text {
        text: root.text;
        font-family: Theme.ui-font;
        font-size: 11px;
        color: root.couleur;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// Tuile d'une page (profils, notes…) : le même verre et les mêmes coins que les tuiles de la grille.
export component TuilePage inherits Rectangle {
    // Thème Nuit : la page est posée sur le fond, sans cadre (comme la maquette Figma)
    background: transparent;
    clip: true;
}

/// En-tête d'une page en tuile : le titre (et une info, comme un nombre), puis ses actions à droite.
/// Chaque action se centre elle-même (VerticalLayout { alignment: center; … }).
export component EnTetePage inherits HorizontalLayout {
    in property <string> titre;
    in property <string> info;
    in property <string> puce;
    height: 60px;
    padding-left: 8px;
    padding-right: 0px;
    spacing: 14px;
    VerticalLayout {
        alignment: center;
        Text {
            text: root.titre;
            font-family: Theme.sans-font;
            font-size: 32px;
            font-weight: 600;
            letter-spacing: -1px;
            color: Theme.ink-strong;
            overflow: elide;
        }
    }
    if root.info != "": VerticalLayout {
        alignment: center;
        Rectangle {
            height: 24px;
            width: info.preferred-width + 16px;
            border-radius: 12px;
            background: Theme.control;
            info := Text {
                text: root.info;
                font-family: Theme.mono-font;
                font-size: 12px;
                font-weight: 500;
                color: Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    // petite pastille de texte après le titre (« Expérimental »…), comme la maquette
    if root.puce != "": VerticalLayout {
        alignment: center;
        Rectangle {
            height: 26px;
            width: puce.preferred-width + 20px;
            border-radius: 13px;
            background: Theme.control;
            puce := Text {
                text: root.puce;
                font-family: Theme.sans-font;
                font-size: 12px;
                color: Theme.ink-4;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    Rectangle { horizontal-stretch: 1; }
    @children
}

/// La lune de la maquette : un disque de 14 × 14 pixels, avec ses cratères.
export component Lune inherits Rectangle {
    in property <length> pixel: 12px;
    width: 14 * root.pixel;
    height: 14 * root.pixel;
    for i in 196: Rectangle {
        property <int> px: Math.mod(i, 14);
        property <int> py: Math.floor(i / 14);
        property <float> d: Math.sqrt((self.px - 6.5) * (self.px - 6.5) + (self.py - 6.5) * (self.py - 6.5));
        property <bool> cratere: i == 60 || i == 61 || i == 74 || i == 120 || i == 121 || i == 135 || i == 50 || i == 129;
        visible: self.d <= 6.6;
        x: self.px * root.pixel;
        y: self.py * root.pixel;
        width: root.pixel;
        height: root.pixel;
        background: self.cratere ? #C3C8D2 : self.d > 5.4 && self.px + self.py > 14 ? #D4D8E0 : #ECEFF4;
    }
}
