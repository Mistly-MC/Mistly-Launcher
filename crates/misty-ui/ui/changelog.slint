// Notes de version : les releases GitHub du launcher (voir src/ui/changelog.rs), comme le Figma
// « Patch notes » : la liste des versions à gauche, la version choisie et ses notes à droite.

import { Theme, Tr } from "theme.slint";
import { ChangelogState, ChangelogSection } from "state.slint";
import { MButton, IconeNuit } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

/// Intertitre des notes (« ■ Launcher », « ■ Mistly Client (in game) »).
component Intertitre inherits HorizontalLayout {
    in property <string> text;
    spacing: 10px;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 7px;
            height: 7px;
            background: Theme.ink;
        }
    }
    Text {
        text: root.text;
        font-family: Theme.sans-font;
        font-size: 14px;
        color: Theme.ink;
        wrap: word-wrap;
    }
}

/// Une ligne des notes : un tiret, puis le texte.
component LigneNote inherits HorizontalLayout {
    in property <string> text;
    in property <int> genre;
    padding-top: 9px;
    padding-bottom: 9px;
    spacing: 16px;
    Text {
        text: "—";
        font-family: Theme.sans-font;
        font-size: 14px;
        color: root.genre == 2 ? Theme.ink-3 : Theme.ink-4;
        vertical-alignment: top;
    }
    Text {
        horizontal-stretch: 1;
        text: root.text;
        font-family: Theme.sans-font;
        font-size: 14.5px;
        color: Theme.ink;
        wrap: word-wrap;
    }
}

/// Une version dans la liste de gauche : son numéro et sa date ; la version ouverte est blanche.
component LigneVersion inherits Rectangle {
    in property <ChangelogSection> s;
    in property <bool> choisie;
    callback clicked;
    height: 52px;
    border-radius: 18px;
    background: root.choisie ? Theme.active : zone.has-hover ? Theme.surface-2 : Theme.surface;
    border-width: 1.5px;
    border-color: root.choisie ? Theme.active : Theme.border;
    animate background, border-color { duration: Theme.fast; }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 10px;
        Text {
            horizontal-stretch: 1;
            text: root.s.title;
            font-family: Theme.mono-font;
            font-size: 15px;
            font-weight: 500;
            color: root.choisie ? Theme.on-active : Theme.ink;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.s.date;
            font-family: Theme.mono-font;
            font-size: 12px;
            color: root.choisie ? Theme.on-active.with-alpha(0.6) : Theme.ink-3;
            vertical-alignment: center;
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Notes de version (Figma « Patch notes ») : « What's new » et les versions à gauche ; à droite la
/// version choisie en grand, si elle est à jour, ses notes, puis le lien vers le site.
export component ChangelogPage inherits Rectangle {
    property <int> n: clamp(ChangelogState.selected, 0, max(0, ChangelogState.sections.length - 1));
    property <ChangelogSection> s: ChangelogState.sections[root.n];
    property <bool> installee: root.s.title == ChangelogState.current;

    HorizontalLayout {
        padding-bottom: 0px;
        spacing: 20px;

        // ═══ À gauche : les versions ═══
        VerticalLayout {
            width: 240px;
            spacing: 18px;
            Text {
                text: Tr.t("Notes_Nouveautes");
                font-family: Theme.sans-font;
                font-size: 30px;
                font-weight: 600;
                letter-spacing: -1px;
                color: Theme.ink-strong;
                height: 44px;
                vertical-alignment: center;
            }
            ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: liste.preferred-height;
                liste := VerticalLayout {
                    width: parent.visible-width;
                    spacing: 8px;
                    alignment: start;
                    for v[i] in ChangelogState.sections: LigneVersion {
                        s: v;
                        choisie: i == root.n;
                        clicked => { ChangelogState.selected = i; }
                    }
                }
            }
        }

        // ═══ À droite : la version choisie ═══
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 28px;
            background: Theme.surface;
            border-width: 1.5px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 34px;
                padding-bottom: 24px;
                spacing: 0px;
                Text {
                    text: (root.installee ? Tr.t("Notes_VersionActuelle") : Tr.t("Commun_Version")).to-uppercase();
                    font-family: Theme.mono-font;
                    font-size: 11px;
                    letter-spacing: 1px;
                    color: Theme.ink-3;
                }
                Rectangle { height: 14px; }
                HorizontalLayout {
                    spacing: 16px;
                    Text {
                        horizontal-stretch: 1;
                        text: root.s.title;
                        font-family: Theme.pixel-font;
                        font-weight: 700;
                        font-size: 40px;
                        letter-spacing: 3px;
                        color: Theme.ink-strong;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if root.installee && root.n == 0: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 32px;
                            width: a-jour.preferred-width + 24px;
                            border-radius: 16px;
                            background: Theme.online-bg;
                            a-jour := HorizontalLayout {
                                x: 12px;
                                spacing: 7px;
                                VerticalLayout {
                                    alignment: center;
                                    IconeNuit { nom: "check"; taille: 12px; couleur: Theme.online-text; }
                                }
                                Text {
                                    text: Tr.t("Notes_AJour");
                                    font-family: Theme.sans-font;
                                    font-size: 12.5px;
                                    color: Theme.online-text;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    if root.s.prerelease: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 32px;
                            width: beta.preferred-width + 24px;
                            border-radius: 16px;
                            background: Theme.control;
                            beta := Text {
                                text: Tr.t("Notes_Beta");
                                font-family: Theme.sans-font;
                                font-size: 12.5px;
                                color: Theme.ink-2;
                            }
                        }
                    }
                }
                Rectangle { height: 22px; }
                // les notes
                ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    content-height: notes.preferred-height;
                    notes := VerticalLayout {
                        width: parent.visible-width;
                        padding-right: 40px;
                        padding-bottom: 12px;
                        spacing: 0px;
                        alignment: start;
                        for ligne[i] in root.s.lines: VerticalLayout {
                            if root.s.kinds[i] == -1: VerticalLayout {
                                padding-top: i > 0 ? 18px : 0px;
                                padding-bottom: 6px;
                                Intertitre { text: ligne; }
                            }
                            if root.s.kinds[i] != -1: LigneNote {
                                text: ligne;
                                genre: root.s.kinds[i];
                            }
                        }
                    }
                }
                Rectangle {
                    height: 1.5px;
                    background: Theme.border;
                }
                HorizontalLayout {
                    padding-top: 20px;
                    spacing: 16px;
                    Text {
                        horizontal-stretch: 1;
                        text: Tr.t("Notes_SurLeSite");
                        font-family: Theme.sans-font;
                        font-size: 12.5px;
                        color: Theme.ink-3;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    MButton {
                        height: 44px;
                        text: Tr.t("Notes_OuvrirSite");
                        clicked => { ChangelogState.open-url("https://mistly.cc/patch-notes"); }
                    }
                }
            }
        }
    }
}
