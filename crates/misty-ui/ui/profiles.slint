// Liste des profils, création d'un profil, installation d'un modpack.

import { Theme, Tr, Assets } from "theme.slint";
import { ProfilesState, ProfileCard } from "state.slint";
import { Icon, PixelLabel, BodyText, SectionTitle, OutlinedText, GlassCard, Thumb, IconButton, MButton, GlassInput, GlassCombo, Spinner, Puces, Etiquette, TuilePage, EnTetePage, BoutonRond, IconeNuit } from "widgets.slint";
import { ContentBrowser } from "browser.slint";
import { ScrollView } from "std-widgets.slint";

/// Fenêtre modale : couvre toute la fenêtre de l'application (posée par main.slint).
/// Carte d'un mod loader (Vanilla, Fabric…) de la fenêtre « New instance ».
component CarteLoader inherits Rectangle {
    in property <string> nom;
    in property <bool> choisi;
    in property <bool> enabled: true;
    callback clicked;
    height: 72px;
    border-radius: 18px;
    background: root.choisi ? Theme.control : zone.has-hover ? Theme.surface-2 : Theme.surface;
    border-width: root.choisi ? 2px : 1.5px;
    border-color: root.choisi ? Theme.ink : Theme.border-field;
    opacity: root.enabled ? 1 : 0.5;
    animate background, border-color { duration: Theme.fast; }
    VerticalLayout {
        padding-left: 17px;
        padding-right: 10px;
        alignment: center;
        spacing: 4px;
        Text {
            text: root.nom;
            font-family: Theme.sans-font;
            font-size: 15px;
            font-weight: 500;
            color: Theme.ink;
            overflow: elide;
        }
        Text {
            text: root.nom == "Vanilla" ? Tr.t("Loader_Vanilla") : root.nom == "Fabric" ? Tr.t("Loader_Fabric") : root.nom == "Forge" ? Tr.t("Loader_Forge") : root.nom == "NeoForge" ? Tr.t("Loader_NeoForge") : root.nom == "Quilt" ? Tr.t("Loader_Quilt") : root.nom == "OptiFine" ? Tr.t("Loader_OptiFine") : "";
            font-family: Theme.sans-font;
            font-size: 12px;
            color: Theme.ink-3;
            overflow: elide;
        }
    }
    zone := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

/// Une version de Minecraft dans la grille de « New instance ».
component CarteVersion inherits Rectangle {
    in property <string> nom;
    in property <bool> choisi;
    in property <string> etiquette;
    callback clicked;
    height: 48px;
    border-radius: 16px;
    background: root.choisi ? Theme.control : zone.has-hover ? Theme.surface-2 : Theme.surface;
    border-width: root.choisi ? 2px : 1.5px;
    border-color: root.choisi ? Theme.ink : Theme.border-field;
    animate background, border-color { duration: Theme.fast; }
    HorizontalLayout {
        padding-left: 17px;
        padding-right: 14px;
        Text {
            horizontal-stretch: 1;
            text: root.nom;
            font-family: Theme.mono-font;
            font-size: 14px;
            color: Theme.ink;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.etiquette != "": Text {
            text: root.etiquette;
            font-family: Theme.sans-font;
            font-size: 12px;
            color: Theme.ink-3;
            vertical-alignment: center;
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Petit titre gris d'une partie de la fenêtre (« Name », « Loader »…).
component Rubrique inherits Text {
    font-family: Theme.sans-font;
    font-size: 13px;
    color: Theme.ink-3;
}

/// Fenêtre « New instance » (Figma) : le nom, le mod loader en cartes, la version en grille.
export component ProfileCreateOverlay inherits Rectangle {
    background: Theme.scrim;
    TouchArea {
        clicked => { ProfilesState.cancel-create(); }
    }
    Rectangle {
        width: min(840px, parent.width - 80px);
        height: min(600px, parent.height - 60px);
        border-radius: 28px;
        background: Theme.surface;
        border-width: 1.5px;
        border-color: Theme.border;
        drop-shadow-blur: 40px;
        drop-shadow-color: #00000080;
        TouchArea { }
        form := VerticalLayout {
            padding-left: 34px;
            padding-right: 34px;
            padding-top: 30px;
            padding-bottom: 30px;
            spacing: 20px;
            // titre et fermer
            HorizontalLayout {
                height: 44px;
                Text {
                    horizontal-stretch: 1;
                    text: Tr.t("Profil_Nouveau");
                    font-family: Theme.sans-font;
                    font-size: 26px;
                    font-weight: 600;
                    letter-spacing: -0.6px;
                    color: Theme.ink-strong;
                    vertical-alignment: center;
                }
                BoutonRond {
                    icone: "fermer";
                    taille: 44px;
                    clicked => { ProfilesState.cancel-create(); }
                }
            }
            // nom
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: 14px;
                VerticalLayout {
                    alignment: end;
                    Rectangle {
                        width: 56px;
                        height: 56px;
                        border-radius: 28px;
                        background: Theme.control;
                        border-width: 1.5px;
                        border-color: Theme.border-strong;
                        IconeNuit {
                            nom: "instances";
                            taille: 20px;
                            couleur: Theme.icon;
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: start;
                    spacing: 6px;
                    Rubrique { text: Tr.t("Profil_Nom"); }
                    nom := GlassInput {
                        text <=> ProfilesState.create-name;
                        init => { self.focus-input(); }
                    }
                }
            }
            // mod loader
            VerticalLayout {
                vertical-stretch: 0;
                alignment: start;
                spacing: 10px;
                Rubrique { text: Tr.t("Profil_Loader"); }
                loaders := Rectangle {
                    property <int> n: max(1, ProfilesState.create-loaders.length);
                    property <length> l: (self.width - (self.n - 1) * 10px) / self.n;
                    height: 72px;
                    // en attendant les loaders de la version : une place vide
                    if ProfilesState.create-loaders.length == 0: Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        border-radius: 18px;
                        background: Theme.surface-2;
                        border-width: 1.5px;
                        border-color: Theme.border;
                    }
                    for m[i] in ProfilesState.create-loaders: CarteLoader {
                        x: i * (loaders.l + 10px);
                        width: loaders.l;
                        nom: m;
                        enabled: ProfilesState.create-loader-enabled;
                        choisi: i == ProfilesState.create-loader-index;
                        clicked => { ProfilesState.create-loader-index = i; }
                    }
                }
            }
            // version de Minecraft
            VerticalLayout {
                vertical-stretch: 1;
                spacing: 10px;
                Rubrique { text: Tr.t("Profil_VersionMinecraft"); }
                grille := ScrollView {
                    vertical-stretch: 1;
                    property <length> case: (self.visible-width - 3 * 8px) / 4;
                    content-width: self.visible-width;
                    content-height: ceil(ProfilesState.create-versions.length / 4) * 56px;
                    for v[i] in ProfilesState.create-versions: CarteVersion {
                        x: mod(i, 4) * (grille.case + 8px);
                        y: floor(i / 4) * 56px;
                        width: grille.case;
                        nom: v;
                        etiquette: i == 0 ? Tr.t("Profil_Derniere") : "";
                        choisi: i == ProfilesState.create-version-index;
                        clicked => {
                            ProfilesState.create-version-index = i;
                            ProfilesState.create-version-selected(i);
                        }
                    }
                }
            }
            // en bas : l'info, annuler, créer
            HorizontalLayout {
                spacing: 10px;
                height: 44px;
                Text {
                    horizontal-stretch: 1;
                    text: ProfilesState.create-loaders.length > 0 && ProfilesState.create-loader-index >= 0 && ProfilesState.create-loaders[ProfilesState.create-loader-index] == "Fabric" ? Tr.t("Profil_MistlyAuto") : ProfilesState.create-info;
                    font-family: Theme.sans-font;
                    font-size: 12.5px;
                    color: Theme.ink-3;
                    vertical-alignment: center;
                    overflow: elide;
                }
                MButton {
                    text: Tr.t("Commun_Annuler");
                    clicked => { ProfilesState.cancel-create(); }
                }
                MButton {
                    kind: 1;
                    text: Tr.t("Profil_Creer");
                    enabled: ProfilesState.create-enabled;
                    clicked => { ProfilesState.create(); }
                }
            }
        }
    }
}

/// Fenêtre modale : couvre toute la fenêtre de l'application (posée par main.slint).
export component ProfileWaitOverlay inherits Rectangle {

        background: Theme.scrim;
        TouchArea { }
        Rectangle {
            width: 420px;
            height: attente.preferred-height;
            border-radius: 24px;
            background: Theme.surface;
            border-width: 2px;
            border-color: Theme.glass-border;
            drop-shadow-blur: 30px;
            drop-shadow-color: Theme.shadow;
            attente := VerticalLayout {
                padding: 28px;
                spacing: 6px;
                Spinner { height: 48px; }
                SectionTitle {
                    text: ProfilesState.wait-title;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                BodyText {
                    text: ProfilesState.wait-text;
                    horizontal-alignment: center;
                }
            }
        }
}

/// Une ligne de la liste des instances (Figma « Instances ») : icône, nom, loader et version,
/// dernière partie, puis supprimer et jouer.
component LigneInstance inherits Rectangle {
    in property <ProfileCard> carte;
    callback open();
    callback play();
    callback delete();
    height: 80px;
    border-radius: 22px;
    background: zone.has-hover ? Theme.surface-2 : Theme.surface;
    border-width: 1.5px;
    border-color: zone.has-hover ? Theme.border-strong : Theme.border;
    animate background, border-color { duration: Theme.fast; }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }
    HorizontalLayout {
        padding-left: 22px;
        padding-right: 20px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 24px;
                clip: true;
                background: Theme.control;
                border-width: 1.5px;
                border-color: Theme.border-strong;
                if root.carte.has-icon: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.carte.icon;
                    image-fit: cover;
                }
                if !root.carte.has-icon: IconeNuit {
                    nom: root.carte.loader == "Fabric" ? "nuage" : "instances";
                    taille: 19px;
                    couleur: Theme.icon;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 3;
            min-width: 120px;
            alignment: center;
            spacing: 3px;
            Text {
                text: root.carte.name;
                font-family: Theme.sans-font;
                font-size: 15px;
                font-weight: 500;
                color: Theme.ink;
                overflow: elide;
            }
            Text {
                text: root.carte.summary;
                font-family: Theme.sans-font;
                font-size: 12px;
                color: Theme.ink-3;
                overflow: elide;
            }
        }
        HorizontalLayout {
            horizontal-stretch: 2;
            min-width: 120px;
            spacing: 8px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 24px;
                    width: puce.preferred-width + 20px;
                    border-radius: 12px;
                    background: Theme.control;
                    border-width: 1.5px;
                    border-color: Theme.border-field;
                    puce := Text {
                        text: root.carte.modpack ? "Modpack" : root.carte.loader;
                        font-family: Theme.sans-font;
                        font-size: 12px;
                        color: Theme.ink-4;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            Text {
                text: root.carte.version;
                font-family: Theme.mono-font;
                font-size: 13px;
                color: Theme.ink;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Text {
            horizontal-stretch: 1;
            min-width: 90px;
            text: root.carte.last;
            font-family: Theme.sans-font;
            font-size: 13px;
            color: Theme.ink-4;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            BoutonRond {
                icone: "poubelle";
                taille: 44px;
                clicked => { root.delete(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 56px;
                height: 44px;
                border-radius: 22px;
                background: jouer.pressed ? Theme.active.darker(0.12) : jouer.has-hover ? Theme.active.brighter(0.06) : Theme.active;
                animate background { duration: Theme.fast; }
                IconeNuit {
                    nom: "jouer";
                    taille: 16px;
                    couleur: Theme.on-active;
                }
                jouer := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.play(); }
                }
            }
        }
    }
}

/// Ligne en pointillés « New profile », au bout de la liste.
component LigneNouvelle inherits Rectangle {
    callback clicked;
    height: 80px;
    border-radius: 22px;
    background: zone.has-hover ? Theme.surface : transparent;
    border-width: 1.5px;
    border-color: Theme.border-strong;
    animate background { duration: Theme.fast; }
    HorizontalLayout {
        padding-left: 22px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: Theme.control;
                border-width: 1.5px;
                border-color: Theme.border-strong;
                IconeNuit {
                    nom: "plus";
                    taille: 18px;
                    couleur: Theme.icon;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text {
                text: Tr.t("Profil_NouveauCarte");
                font-family: Theme.sans-font;
                font-size: 15px;
                font-weight: 500;
                color: Theme.ink;
            }
            Text {
                text: Tr.t("Profil_NouveauCarte_Texte");
                font-family: Theme.sans-font;
                font-size: 12px;
                color: Theme.ink-3;
            }
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Titre de colonne de la liste (NAME, VERSION…).
component Colonne inherits Text {
    font-family: Theme.mono-font;
    font-size: 11px;
    letter-spacing: 0.6px;
    color: Theme.ink-3;
    vertical-alignment: center;
}

export component ProfilesPage inherits Rectangle {
    // ═══════════ Liste des profils : une tuile, en-tête puis grille de cartes ═══════════
    if ProfilesState.view == 0: TuilePage {
        VerticalLayout {
            EnTetePage {
                titre: Tr.t("Onglet_Profils");
                info: ProfilesState.list.length;
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    MButton {
                        text: Tr.t("Profil_ImporterModpack");
                        icon: "\u{E8E5}";
                        clicked => { ProfilesState.import-modpack(); }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    MButton {
                        text: Tr.t("Profil_InstallerModpack");
                        icon: "\u{E896}";
                        clicked => { ProfilesState.modpacks(); }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    MButton {
                        kind: 1;
                        text: Tr.t("Profil_Nouveau");
                        icon: "\u{E710}";
                        clicked => { ProfilesState.new-profile(); }
                    }
                }
            }
            // filtres par loader, quand il y en a plusieurs
            if ProfilesState.filters.length > 2: HorizontalLayout {
                padding-top: 14px;
                Puces {
                    model: ProfilesState.filters;
                    current: ProfilesState.filter-index;
                    selected(i) => {
                        ProfilesState.filter-index = i;
                        ProfilesState.filter-changed();
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            // les colonnes, puis une ligne par instance et la ligne « New profile »
            HorizontalLayout {
                padding-left: 22px + 48px + 16px;
                padding-right: 20px + 44px + 56px + 32px;
                padding-top: 16px;
                padding-bottom: 8px;
                spacing: 16px;
                height: 39px;
                Colonne { horizontal-stretch: 3; min-width: 120px; text: Tr.t("Profil_Col_Nom").to-uppercase(); }
                Colonne { horizontal-stretch: 2; min-width: 120px; text: Tr.t("Commun_Version").to-uppercase(); }
                Colonne { horizontal-stretch: 1; min-width: 90px; text: Tr.t("Profil_Col_Derniere").to-uppercase(); }
            }
            Rectangle {
                vertical-stretch: 1;
                zone := ScrollView {
                    property <int> nombre: ProfilesState.list.length + 1;
                    content-width: self.visible-width;
                    content-height: self.nombre * 98px;
                    for p[i] in ProfilesState.list: LigneInstance {
                        x: 0;
                        y: i * 98px;
                        width: zone.visible-width;
                        carte: p;
                        open => { ProfilesState.open(p.id); }
                        play => { ProfilesState.play(p.id); }
                        delete => { ProfilesState.delete(p.id); }
                    }
                    LigneNouvelle {
                        x: 0;
                        y: ProfilesState.list.length * 98px;
                        width: zone.visible-width;
                        clicked => { ProfilesState.new-profile(); }
                    }
                }
            }
        }
    }
    // ═══════════ Modpacks : la même tuile, avec un retour ═══════════
    if ProfilesState.view == 1: TuilePage {
        ContentBrowser {
            titre: Tr.t("Nav_Decouvrir");
            retour: true;
            back => { ProfilesState.back(); }
        }
    }
}
