// Packs de textures : galerie (bandeau « Commencer », cartes avec aperçu des textures, import d'un
// .zip), création, export, suppression. L'édition se fait dans editor.slint.

import { Theme, Tr, Assets } from "theme.slint";
import { PacksState, PackCard } from "state.slint";
import { Icon, IconeNuit, PixelLabel, BodyText, TuilePage, EnTetePage, SectionTitle, OutlinedText, GlassCard, Thumb, Badge, IconButton, MButton, GlassInput, GlassCombo, Etiquette } from "widgets.slint";
import { ContentBrowser } from "browser.slint";
import { ScrollView } from "std-widgets.slint";

/// Carte d'un pack (maquette Figma « Texture packs ») : un grand aperçu carré de ses textures en
/// pixel art, le nom, la version et le nombre de textures, puis « Modifier » et les petits boutons
/// ronds (exporter, dossier, supprimer). Un clic sur la carte l'ouvre dans l'éditeur.
component PackCardView inherits Rectangle {
    in property <PackCard> pack;
    callback edit();
    callback folder();
    callback export();
    callback delete();
    property <bool> survol: touch.has-hover;

    border-radius: 24px;
    background: Theme.surface;
    border-width: 1.5px;
    border-color: root.survol ? Theme.border-strong : Theme.border;
    transform-scale: root.survol ? 1.01 : 1;
    animate border-color { duration: Theme.normal; }
    animate transform-scale { duration: 260ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.edit(); }
    }
    VerticalLayout {
        padding: 14px;
        padding-bottom: 18px;
        spacing: 14px;
        alignment: start;
        // l'aperçu : les textures modifiées en mosaïque (ou l'icône du pack)
        apercu := Rectangle {
            height: self.width;
            border-radius: 16px;
            clip: true;
            background: Theme.surface-2;
            property <int> cote: root.pack.previews.length >= 9 ? 3 : root.pack.previews.length >= 4 ? 2 : 1;
            if root.pack.previews.length > 0: Rectangle {
                for img[k] in root.pack.previews: Image {
                    visible: k < apercu.cote * apercu.cote;
                    // un pixel de recouvrement : pas de fine ligne entre deux textures
                    x: mod(k, apercu.cote) * apercu.width / apercu.cote;
                    y: floor(k / apercu.cote) * apercu.height / apercu.cote;
                    width: apercu.width / apercu.cote + 1px;
                    height: apercu.height / apercu.cote + 1px;
                    source: img;
                    image-fit: fill;
                    image-rendering: ImageRendering.pixelated;
                }
            }
            if root.pack.previews.length == 0: Thumb {
                width: parent.width;
                height: parent.height;
                radius: 16px;
                logo-margin: parent.width / 4;
                logo-opacity: 0.5;
                pixel-art: true;
                source: root.pack.icon;
                has-image: root.pack.has-icon;
            }
        }
        VerticalLayout {
            padding-left: 4px;
            padding-right: 4px;
            spacing: 3px;
            Text {
                text: root.pack.name;
                font-family: Theme.sans-font;
                font-weight: 600;
                font-size: 15px;
                color: Theme.ink-strong;
                overflow: elide;
            }
            Text {
                text: root.pack.version != "" ? root.pack.version + " · " + root.pack.count : root.pack.count;
                font-family: Theme.sans-font;
                font-size: 12.5px;
                color: Theme.ink-3;
                overflow: elide;
            }
        }
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            spacing: 8px;
            MButton {
                horizontal-stretch: 1;
                text: Tr.t("Pack_Editer");
                clicked => { root.edit(); }
            }
            IconButton {
                icon: "\u{E898}";
                tooltip: Tr.t("Pack_Exporter");
                clicked => { root.export(); }
            }
            IconButton {
                icon: "\u{E8B7}";
                tooltip: Tr.t("Pack_Dossier");
                clicked => { root.folder(); }
            }
            IconButton {
                icon: "\u{E74D}";
                tooltip: Tr.t("Pack_Supprimer");
                clicked => { root.delete(); }
            }
        }
    }
}

/// Dernière carte de la galerie (en pointillés, comme « Import a world » de la maquette) :
/// importer un pack de ressources (.zip), ou en créer un.
component CarteImport inherits Rectangle {
    border-radius: 24px;
    background: zone.has-hover ? Theme.surface : transparent;
    border-width: 1.5px;
    border-color: zone.has-hover ? Theme.ink-3 : Theme.star;
    animate background, border-color { duration: Theme.normal; }
    VerticalLayout {
        alignment: center;
        padding: 20px;
        spacing: 10px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 52px;
                height: 52px;
                border-radius: 26px;
                background: Theme.control;
                border-width: 1.5px;
                border-color: Theme.border-strong;
                IconeNuit { nom: "plus"; taille: 20px; }
            }
        }
        Text {
            text: Tr.t("Pack_Importer");
            font-family: Theme.sans-font;
            font-size: 15px;
            font-weight: 600;
            color: Theme.ink-strong;
            horizontal-alignment: center;
        }
        Text {
            text: Tr.t("Pack_Importer_Texte");
            font-family: Theme.sans-font;
            font-size: 12.5px;
            color: Theme.ink-3;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { PacksState.import(); }
    }
}

/// Fenêtre modale : couvre toute la fenêtre de l'application (posée par main.slint).
export component PackCreateOverlay inherits Rectangle {

        background: Theme.scrim;
        TouchArea {
            clicked => {
                if (PacksState.create-enabled) {
                    PacksState.cancel-create();
                }
            }
        }
        Rectangle {
            width: 460px;
            height: form.preferred-height;
            border-radius: 24px;
            background: Theme.surface;
            border-width: 2px;
            border-color: Theme.glass-border;
            drop-shadow-blur: 30px;
            drop-shadow-color: Theme.shadow;
            TouchArea { }
            form := VerticalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-top: 26px;
                padding-bottom: 26px;
                spacing: 6px;
                SectionTitle {
                    text: Tr.t("Pack_Nouveau");
                    height: 36px;
                    vertical-alignment: top;
                }
                PixelLabel { text: Tr.t("Pack_Nom"); font-size: 10px; x: 4px; }
                GlassInput {
                    text <=> PacksState.create-name;
                    init => { self.focus-input(); }
                    accepted => {
                        if (PacksState.create-enabled) {
                            PacksState.validate();
                        }
                    }
                }
                Rectangle { height: 8px; }
                PixelLabel { text: Tr.t("Pack_Description"); font-size: 10px; x: 4px; }
                GlassInput {
                    text <=> PacksState.create-desc;
                    accepted => {
                        if (PacksState.create-enabled) {
                            PacksState.validate();
                        }
                    }
                }
                Rectangle { height: 8px; }
                PixelLabel { text: Tr.t("Pack_Version"); font-size: 10px; x: 4px; }
                GlassCombo {
                    model: PacksState.versions;
                    current-index <=> PacksState.version-index;
                    enabled: PacksState.create-enabled;
                }
                BodyText {
                    text: PacksState.create-info;
                    x: 2px;
                    min-height: 36px;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    padding-top: 12px;
                    MButton {
                        text: Tr.t("Commun_Annuler");
                        enabled: PacksState.create-enabled;
                        clicked => { PacksState.cancel-create(); }
                    }
                    MButton {
                        kind: 1;
                        text: Tr.t("Pack_Creer");
                        enabled: PacksState.create-enabled;
                        clicked => { PacksState.validate(); }
                    }
                }
            }
        }
}

export component PacksPage inherits Rectangle {
    // une seule tuile, comme Profils : en-tête (titre, nombre, actions), puis la galerie
    if PacksState.view == 0: TuilePage {
        VerticalLayout {
            spacing: 20px;
            EnTetePage {
                titre: Tr.t("Onglet_Packs");
                puce: Tr.t("Pack_Puce_Experimental");
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    MButton {
                        icon: "\u{E721}";
                        text: Tr.t("Pack_Parcourir");
                        clicked => { PacksState.browse(); }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    MButton {
                        text: Tr.t("Pack_Importer");
                        clicked => { PacksState.import(); }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    MButton {
                        kind: 1;
                        icon: "\u{E710}";
                        text: Tr.t("Soon_CreerPack");
                        clicked => { PacksState.new-pack(); }
                    }
                }
            }
            HorizontalLayout {
                padding-left: 8px;
                Text {
                    text: Tr.t("Pack_Intro");
                    font-family: Theme.sans-font;
                    font-size: 14px;
                    color: Theme.ink-2;
                }
            }
            Rectangle {
                vertical-stretch: 1;
                zone := ScrollView {
                    // 4 colonnes comme la maquette (moins si la fenêtre est étroite)
                    property <int> colonnes: max(1, min(4, floor((self.visible-width + 16px) / (230px + 16px))));
                    property <length> case: (self.visible-width - (self.colonnes - 1) * 16px) / self.colonnes;
                    // marges (2 × 14) + aperçu carré (case - 28) + nom et infos (38) + boutons (40) + écarts et bas (2 × 14 + 18)
                    property <length> carte-h: self.case + 112px;
                    // les packs, puis la carte « Importer »
                    property <int> nombre: PacksState.list.length + 1;
                    content-width: self.visible-width;
                    content-height: ceil(self.nombre / self.colonnes) * (self.carte-h + 16px);

                    for p[i] in PacksState.list: PackCardView {
                        x: mod(i, zone.colonnes) * (zone.case + 16px);
                        y: floor(i / zone.colonnes) * (zone.carte-h + 16px);
                        width: zone.case;
                        height: zone.carte-h;
                        pack: p;
                        edit => { PacksState.edit(i); }
                        folder => { PacksState.folder(i); }
                        export => { PacksState.export(i); }
                        delete => { PacksState.delete(i); }
                    }
                    CarteImport {
                        x: mod(PacksState.list.length, zone.colonnes) * (zone.case + 16px);
                        y: floor(PacksState.list.length / zone.colonnes) * (zone.carte-h + 16px);
                        width: zone.case;
                        height: zone.carte-h;
                    }
                }
            }
        }
    }
    // ═══ Parcourir : les packs de Modrinth / CurseForge, importés ici pour les modifier ═══
    if PacksState.view == 1: TuilePage {
        VerticalLayout {
            HorizontalLayout {
                height: 62px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: "";
                        tooltip: Tr.t("Profil_Retour");
                        clicked => { PacksState.back(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: Tr.t("Pack_Parcourir_Titre");
                        font-size: 20px;
                        font-weight: 600;
                        color: Theme.navy;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: Tr.t("Pack_Parcourir_Texte");
                        font-size: 12.5px;
                        color: Theme.text-muted;
                        overflow: elide;
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            HorizontalLayout {
                vertical-stretch: 1;
                padding: 16px;
                ContentBrowser { }
            }
        }
    }
}
