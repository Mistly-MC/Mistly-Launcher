// Thème : couleurs (clair « brume » et sombre « nuit », repris du site mistly.cc),
// polices, traductions, images partagées.

import "../../misty-app/assets/fonts/Silkscreen-Regular.ttf";
import "../../misty-app/assets/fonts/Silkscreen-Bold.ttf";
import "../../misty-app/assets/fonts/Geist-Regular.ttf";
import "../../misty-app/assets/fonts/Geist-Medium.ttf";
import "../../misty-app/assets/fonts/Geist-SemiBold.ttf";
import "../../misty-app/assets/fonts/GeistMono-Regular.ttf";
import "../../misty-app/assets/fonts/GeistMono-Medium.ttf";


export global Theme {
    // ── Réglages d'apparence (pilotés par Rust, enregistrés dans data.txt) ──
    /// 0 brume (clair) · 1 nuit (sombre) · 2 comme Windows
    in-out property <int> mode: 0;
    /// Carrés flottants animés sur le fond
    /// Flou du paysage en fond (0 = pixel art net, 10 = très flou)
    in-out property <int> bg-blur: 0;
    /// Fond flouté derrière les fenêtres (options…)
    in-out property <bool> blur: true;
    /// Thème de saison, choisi par Rust selon la date : 0 aucun · 1 Halloween · 2 Noël
    /// (3 jours avant et après la fête ; désactivable dans les options)
    in-out property <int> event: 0;
    out property <bool> halloween: event == 1;
    out property <bool> noel: event == 2;
    /// Les thèmes de saison sont des thèmes de nuit
    /// Windows en mode sombre (lu dans le registre par Rust) : le thème « Comme Windows » le suit.
    /// (Pas Palette.color-scheme : c'est Misty qui le règle, pour que les barres de défilement
    /// et les autres widgets standard suivent le thème de Misty.)
    in property <bool> system-dark;
    out property <bool> dark: event != 0 || mode == 1 || (mode == 2 && system-dark);

    // ── Thème « Nuit » 0.4.1 (Figma « Mistly Launcher – Nuit ») ──
    // Quatre jeux de couleurs : Night (sombre), Mist (clair), Christmas, Halloween.
    // Les nouveaux écrans n'utilisent que ces jetons.
    out property <color> bg: halloween ? #0C0812 : noel ? #080C12 : dark ? #07090C : #F3F6FB;
    out property <color> surface: halloween ? #150D22 : noel ? #0E1520 : dark ? #0E1014 : #FFFFFF;
    out property <color> surface-2: halloween ? #1A1029 : noel ? #111A27 : dark ? #111317 : #EAF0F8;
    out property <color> control: halloween ? #21142F : noel ? #16202E : dark ? #16181C : #E3EAF4;
    out property <color> border: halloween ? #2A1A3C : noel ? #1B2636 : dark ? #1A1C21 : #DCE4EF;
    out property <color> border-field: halloween ? #301E44 : noel ? #202C3D : dark ? #1F2126 : #D3DCE9;
    out property <color> border-strong: halloween ? #3A2550 : noel ? #283546 : dark ? #24262B : #C5D0E0;
    out property <color> star: halloween ? #4A2F66 : noel ? #D9E2EE : dark ? #2A2D33 : #C4D2E6;
    out property <color> icon: halloween ? #D3C0E5 : noel ? #D2D9E4 : dark ? #C4C7D0 : #3E526A;
    out property <color> ink: halloween ? #F1EAF8 : noel ? #EEF2F8 : dark ? #ECEDEF : #1C2335;
    out property <color> ink-strong: halloween ? #FAF5FF : noel ? #F7F9FC : dark ? #F4F4F5 : #11151F;
    out property <color> ink-2: halloween ? #A893BD : noel ? #93A0B4 : dark ? #8A8E98 : #55667D;
    out property <color> ink-3: halloween ? #9C88B1 : noel ? #8592A6 : dark ? #7C808A : #5F6F85;
    out property <color> ink-4: halloween ? #B9A6CD : noel ? #A9B5C6 : dark ? #A5A9B3 : #4E5E75;
    out property <color> active: halloween ? #F07A2A : noel ? #E5484D : dark ? #F1F2F4 : #1C2335;
    out property <color> on-active: halloween ? #1A0E05 : noel ? #FFFFFF : dark ? #0A0B0E : #FFFFFF;
    out property <color> online: dark ? #4ADE80 : #16A34A;
    out property <color> online-text: dark ? #7FE3A6 : #15803D;
    out property <color> online-bg: dark ? #12241A : #DCFCE7;
    out property <color> danger-text: #F59A9A;
    out property <color> danger-border: #3A2226;
    /// Polices du nouveau thème (fichiers dans misty-app/assets/fonts)
    out property <string> sans-font: "Geist";
    out property <string> mono-font: "Geist Mono";

    // ── Anciens noms ──
    // Les écrans d'avant 0.4.1 utilisent ces noms : ils pointent maintenant vers les jetons du thème
    // Nuit ci-dessus, pour que tout le launcher prenne le nouveau style.
    out property <color> sky-light: dark ? #2A2D33 : #C4DFF8;
    out property <color> sky: bg;
    out property <color> steel: ink-2;
    out property <color> deep: halloween ? #F07A2A : noel ? #E5484D : #4F74A6;
    /// Contour et ombre des grands titres pixel (fondus dans le fond : le titre reste net)
    out property <color> slate: border-strong;
    out property <color> slate-dark: bg;
    out property <color> label: ink-3;
    out property <color> label-strong: ink-2;
    out property <color> navy: ink;
    out property <color> navy2: ink-4;
    out property <color> green: online;
    out property <color> green-dark: online-text;
    out property <color> green-edge: #0E7F37;
    /// Pastilles d'icône des dialogues (icône blanche par-dessus)
    out property <color> blue: halloween ? #F07A2A : noel ? #E5484D : dark ? #4F74A6 : #2F6FD6;
    out property <color> danger: #E5484D;
    out property <color> accent: active;
    out property <color> accent-soft: active.with-alpha(0.10);
    out property <color> fill: active;
    out property <color> fill-hover: halloween ? #FF8F45 : noel ? #EE5E63 : dark ? #FFFFFF : #2A3347;
    out property <color> on-fill: on-active;
    out property <color> lip: bg;
    out property <color> fill-lip: border-strong;
    out property <color> text: ink;
    out property <color> text-muted: ink-2;
    out property <color> text-dim: ink-3;
    out property <color> glass: surface;
    out property <color> glass-strong: control;
    out property <color> glass-hover: halloween ? #2A1A3C : noel ? #1C2838 : dark ? #1D1F24 : #D8E1EE;
    out property <color> glass-border: border;
    out property <color> panel: surface;
    out property <color> panel-strong: control;
    out property <color> line: border;
    out property <color> popup: surface-2;
    out property <color> popup-hover: control;
    out property <brush> scrim: dark ? @linear-gradient(180deg, #000000A6 0%, #000000C7 100%) : @linear-gradient(180deg, #11151F4D 0%, #11151F80 100%);
    out property <color> shadow: dark ? #000000B3 : #11151F33;
    out property <color> track: border-strong;
    out property <color> toggle-on: active;
    out property <color> toggle-off: control;
    out property <color> stage: surface;

    // ── Mouvement ──
    out property <duration> fast: 140ms;
    out property <duration> normal: 220ms;
    out property <duration> slow: 360ms;

    // ── Mise en page (grille de 4 px, comme Fluent) ──
    /// Espacements : entre deux boutons, entre deux blocs, marge d'une surface, entre sections
    out property <length> gap-s: 8px;
    out property <length> gap-m: 12px;
    out property <length> pad: 16px;
    out property <length> gap-l: 24px;
    /// Rayons : petit (étiquette), contrôle (bouton, champ), carte, panneau
    out property <length> radius-s: 8px;
    out property <length> radius-m: 12px;
    out property <length> radius-l: 18px;
    out property <length> radius-xl: 24px;
    /// Échelle de texte : légende, corps, corps large, sous-titre, titre
    out property <length> text-caption: 12px;
    out property <length> text-body: 13.5px;
    out property <length> text-large: 16px;
    out property <length> text-subtitle: 20px;
    out property <length> text-title: 28px;

    // ── Polices ──
    out property <string> pixel-font: "Silkscreen";
    out property <string> ui-font: "Geist";
    out property <string> icon-font: "Segoe MDL2 Assets"; // présente sur Windows 10 ET 11 (Segoe Fluent Icons = Win11 seulement)
}

// Traductions : Tr.t("Cle"). Quand la langue change, Rust incrémente `rev`
// et tous les textes qui utilisent Tr.t sont recalculés.
export global Tr {
    in property <int> rev;
    pure callback lookup(string) -> string;
    public pure function t(key: string) -> string {
        if (rev < 0) {
            return "";
        }
        return lookup(key);
    }
}

// Bulle d'aide unique, dessinée par la fenêtre au-dessus de tout le reste.
// Les boutons indiquent seulement le texte et la position (coordonnées dans la fenêtre).
export global Bulle {
    in-out property <string> texte;
    in-out property <length> x;
    in-out property <length> y;
    /// true : à droite du bouton (barre latérale) ; false : centrée sous le bouton
    in-out property <bool> a-droite;
    in-out property <bool> visible;
    /// Hauteur de la fenêtre : les listes déroulantes s'ouvrent vers le haut si elles n'ont pas la place en dessous.
    in-out property <length> fenetre-hauteur: 720px;
}

// Images partagées, fournies par Rust.
export global Assets {
    /// Le nuage de Misty (vignettes vides, fond, carte de version)
    in property <image> logo;
    /// Paysages en pixel art du bas de l'accueil, un par édition (1180 × 256)
    out property <image> scene-mistly: @image-url("../../misty-app/assets/scenes/mistly.png");
    out property <image> scene-java: @image-url("../../misty-app/assets/scenes/java.png");
    out property <image> scene-bedrock: @image-url("../../misty-app/assets/scenes/bedrock.png");
    out property <image> scene-horizon: @image-url("../../misty-app/assets/scenes/horizon.png");
    /// Fonds plein écran de l'accueil Java et Bedrock (pixel art, 320 × 196, agrandis sans lissage)
    out property <image> fond-java: @image-url("../../misty-app/assets/fonds/java.png");
    out property <image> fond-bedrock: @image-url("../../misty-app/assets/fonds/bedrock.png");
}
