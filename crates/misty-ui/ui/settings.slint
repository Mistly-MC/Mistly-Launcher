// Page des options (à la place de la page ouverte, sous la barre du haut), comme sur le Figma :
// les sections à gauche (Game, Account, Appearance, Language, Downloads, Privacy, About), les
// réglages à droite dans des cartes. Les réglages simples sont empilés dans une même carte,
// séparés par un trait.

import { Theme, Tr, Bulle } from "theme.slint";
import { SettingsState, StorageRow, AppState, SettingResult, StoragePart } from "state.slint";
import { Icon, PixelLabel, BodyText, SectionTitle, IconButton, MButton, GlassInput, ToggleSwitch, GlassSlider, ChromeButton, OutlinedText, IconeNuit, IconeAuto, GlassCombo } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

// ───────────────────────── Petits éléments ─────────────────────────

/// Un pseudo hors ligne, avec sa croix.
component Pseudo inherits Rectangle {
    in property <string> text;
    callback remove();
    height: 36px;
    width: t.preferred-width + 52px;
    border-radius: 18px;
    background: Theme.surface-2;
    border-width: 1.5px;
    border-color: Theme.border-field;
    t := Text {
        x: 14px;
        text: root.text;
        font-family: Theme.sans-font;
        font-weight: 500;
        font-size: 13px;
        color: Theme.ink;
        vertical-alignment: center;
    }
    ChromeButton {
        x: parent.width - 32px;
        y: 4px;
        width: 28px;
        height: 28px;
        icon: "\u{E8BB}";
        close: true;
        clicked => { root.remove(); }
    }
}

/// Titre de réglage + description, en gris dessous.
component Entete inherits VerticalLayout {
    in property <string> titre;
    in property <string> texte;
    spacing: 3px;
    Text {
        text: root.titre;
        font-family: Theme.sans-font;
        font-size: 14.5px;
        font-weight: 500;
        color: Theme.ink;
        wrap: word-wrap;
    }
    if root.texte != "": Text {
        text: root.texte;
        font-family: Theme.sans-font;
        font-size: 12.5px;
        color: Theme.ink-3;
        wrap: word-wrap;
    }
}

/// Carte : fond de surface, coins de 24 px, marge intérieure de 24 px.
component Carte inherits Rectangle {
    in property <length> spacing: 16px;
    in property <length> marge: 24px;
    border-radius: 24px;
    background: Theme.surface;
    border-width: 1.5px;
    border-color: Theme.border;
    min-height: corps.preferred-height;
    corps := VerticalLayout {
        padding: root.marge;
        spacing: root.spacing;
        @children
    }
}

/// Carte qui empile des lignes (`Ligne`, `LigneInterrupteur`…), séparées par un trait.
component Groupe inherits Rectangle {
    border-radius: 24px;
    background: Theme.surface;
    border-width: 1.5px;
    border-color: Theme.border;
    min-height: corps.preferred-height;
    corps := VerticalLayout {
        padding: 24px;
        @children
    }
}

/// Trait au-dessus d'une ligne de `Groupe` (sauf la première : `trait: false`).
component Trait inherits Rectangle {
    x: 0;
    y: 0;
    height: 1.5px;
    background: Theme.border;
}

/// Ligne de `Groupe` : titre et description à gauche, les contrôles (enfants) à droite.
component Ligne inherits Rectangle {
    in property <string> titre;
    in property <string> texte;
    in property <bool> trait: true;
    min-height: rangee.preferred-height;
    if root.trait: Trait { }
    rangee := HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 16px;
        Entete {
            horizontal-stretch: 1;
            titre: root.titre;
            texte: root.texte;
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 10px;
                @children
            }
        }
    }
}

/// Ligne avec l'interrupteur à droite.
component LigneInterrupteur inherits Ligne {
    in-out property <bool> checked;
    callback toggled(bool);
    ToggleSwitch {
        width: 48px;
        checked <=> root.checked;
        toggled(v) => { root.toggled(v); }
    }
}

/// Réglage en blocs de pixels (mémoire, flou, téléchargements) : un bloc par pas, les blocs
/// pleins en blanc. Un clic ou un glissé choisit la valeur.
component Blocs inherits Rectangle {
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step: 1;
    in property <length> bloc-max: 40px;
    in property <length> espace: 6px;
    in-out property <float> value;
    callback changed(float);
    property <int> nombre: max(1, round(root.maximum / root.step));
    property <int> plein: round(root.value / root.step);
    property <length> bloc: min(root.bloc-max, (root.width - (root.nombre - 1) * root.espace) / root.nombre);
    preferred-width: root.nombre * root.bloc-max + (root.nombre - 1) * root.espace;
    min-width: root.nombre * 4px + (root.nombre - 1) * root.espace;
    height: 22px;
    for i in root.nombre: Rectangle {
        x: i * (root.bloc + root.espace);
        y: 0;
        width: root.bloc;
        height: root.height;
        border-radius: 2px;
        background: i < root.plein ? Theme.active : Theme.control;
        animate background { duration: Theme.fast; }
    }
    function choisir(mx: length, appui: bool) {
        let i = max(0, min(root.nombre - 1, floor(mx / (root.bloc + root.espace))));
        // un clic sur le seul bloc plein le vide (flou : « aucun »)
        let v = appui && i == 0 && root.plein == 1 && root.minimum < root.step ? root.minimum : max(root.minimum, (i + 1) * root.step);
        if (v != root.value) {
            root.value = v;
            root.changed(v);
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.choisir(self.mouse-x, true);
            }
        }
        moved => {
            if (self.pressed) {
                root.choisir(self.mouse-x, false);
            }
        }
    }
}

/// Petit nombre à droite des blocs.
component ValeurBlocs inherits Text {
    font-family: Theme.mono-font;
    font-size: 12px;
    color: Theme.ink;
    vertical-alignment: center;
    width: 26px;
    horizontal-alignment: right;
}

/// Champ de nombre arrondi (largeur et hauteur de la fenêtre du jeu).
component ChampNombre inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback edited(string);
    width: 80px;
    height: 40px;
    border-radius: 20px;
    background: Theme.surface-2;
    border-width: 1.5px;
    border-color: champ.has-focus ? Theme.active : Theme.border-field;
    animate border-color { duration: Theme.fast; }
    if root.text == "": Text {
        text: root.placeholder;
        font-family: Theme.mono-font;
        font-size: 13.5px;
        color: Theme.ink-3;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    champ := TextInput {
        x: 12px;
        width: parent.width - 24px;
        text <=> root.text;
        font-family: Theme.mono-font;
        font-size: 13.5px;
        color: Theme.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
        input-type: number;
        edited => { root.edited(self.text); }
    }
}

/// Pastille de valeur (taille du dossier…).
component Valeur inherits Rectangle {
    in property <string> text;
    width: max(54px, v.preferred-width + 28px);
    height: 36px;
    border-radius: 18px;
    background: Theme.surface-2;
    border-width: 1.5px;
    border-color: Theme.border-field;
    v := Text {
        text: root.text;
        font-family: Theme.mono-font;
        font-size: 12.5px;
        color: Theme.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// Bouton rond (corbeille, lien) : 40 px, contour.
component Rond inherits Rectangle {
    in property <string> icone;
    callback clicked;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: zone.has-hover ? Theme.border-strong : Theme.control;
    border-width: 1.5px;
    border-color: Theme.border-strong;
    animate background { duration: Theme.fast; }
    IconeNuit {
        nom: root.icone;
        taille: 16px;
        couleur: Theme.icon;
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Bouton radio rond (thème, langue).
component Radio inherits Rectangle {
    in property <bool> checked;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background: root.checked ? Theme.active : transparent;
    border-width: 1.5px;
    border-color: root.checked ? Theme.active : Theme.border-strong;
    animate background, border-color { duration: Theme.normal; }
    Rectangle {
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.on-active;
        opacity: root.checked ? 1 : 0;
        animate opacity { duration: Theme.normal; }
    }
}

/// Tuile de thème : un aperçu (fond et deux pastilles), puis le bouton radio et le nom.
component CarteTheme inherits Rectangle {
    in property <string> text;
    /// 0 brume · 1 nuit · 2 système
    in property <int> genre;
    in property <bool> checked;
    callback clicked;
    height: 120px;
    border-radius: 18px;
    background: Theme.surface-2;
    border-width: 1.5px;
    border-color: root.checked ? Theme.ink : touch.has-hover ? Theme.border-strong : Theme.border;
    animate border-color { duration: Theme.normal; }
    // aperçu
    Rectangle {
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        height: 70px;
        border-radius: 10px;
        background: root.genre == 1 ? #070809 : root.genre == 0 ? #F1F3F7 : #5E6B80;
        Rectangle {
            x: 14px;
            y: parent.height - 26px;
            width: 40px;
            height: 14px;
            border-radius: 7px;
            background: root.genre == 0 ? #1C2335 : #F1F2F4;
        }
        Rectangle {
            x: 60px;
            y: parent.height - 26px;
            width: 22px;
            height: 14px;
            border-radius: 7px;
            background: root.genre == 0 ? #A9AFBA : root.genre == 1 ? #4A4D55 : #A7AFBD;
        }
    }
    HorizontalLayout {
        x: 14px;
        y: 88px;
        height: 22px;
        width: parent.width - 28px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Radio { checked: root.checked; }
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-family: Theme.sans-font;
            font-size: 13px;
            color: Theme.ink;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Ligne d'un compte Microsoft : avatar (initiale), pseudo, état, puis « Active » et
/// « Sign out », ou « Use this account » et la corbeille.
component LigneCompte inherits Rectangle {
    in property <string> pseudo;
    in property <bool> active;
    in property <bool> trait: true;
    callback use();
    callback forget();
    callback sign-out();
    min-height: rangee.preferred-height;
    if root.trait: Trait { }
    rangee := HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 52px;
                height: 52px;
                border-radius: 26px;
                background: root.active ? Theme.active : Theme.control;
                border-width: 1.5px;
                border-color: Theme.border-strong;
                IconeNuit {
                    nom: "garde-robe";
                    taille: 20px;
                    couleur: root.active ? Theme.on-active : Theme.icon;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text {
                text: root.pseudo;
                font-family: Theme.sans-font;
                font-size: 14.5px;
                font-weight: 500;
                color: Theme.ink;
                overflow: elide;
            }
            Text {
                text: root.active ? Tr.t("Compte_Etat_Connecte") : Tr.t("Compte_Etat_Enregistre");
                font-family: Theme.sans-font;
                font-size: 12.5px;
                color: Theme.ink-3;
                overflow: elide;
            }
        }
        if root.active: VerticalLayout {
            alignment: center;
            Rectangle {
                height: 26px;
                width: actif.preferred-width + 22px;
                border-radius: 13px;
                background: Theme.online-bg;
                actif := Text {
                    text: Tr.t("Compte_Actif");
                    font-family: Theme.sans-font;
                    font-size: 12px;
                    color: Theme.online-text;
                    vertical-alignment: center;
                }
            }
        }
        if root.active: VerticalLayout {
            alignment: center;
            MButton {
                text: Tr.t("Compte_SeDeconnecter");
                clicked => { root.sign-out(); }
            }
        }
        if !root.active: VerticalLayout {
            alignment: center;
            MButton {
                text: Tr.t("Compte_UtiliserCeCompte");
                clicked => { root.use(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Rond {
                icone: "poubelle";
                clicked => { root.forget(); }
            }
        }
    }
}

/// Ligne de langue : pastille du code, nom, nom anglais, bouton radio.
component LigneLangue inherits Rectangle {
    in property <string> nom;
    in property <string> anglais;
    in property <string> code;
    in property <bool> checked;
    in property <bool> trait: true;
    callback clicked;
    height: 50px;
    if root.trait: Trait { }
    Rectangle {
        y: 1.5px;
        height: parent.height - 1.5px;
        background: touch.has-hover && !root.checked ? Theme.surface-2 : transparent;
        animate background { duration: Theme.fast; }
    }
    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                background: root.checked ? Theme.active : Theme.control;
                animate background { duration: Theme.normal; }
                Text {
                    text: root.code;
                    font-family: Theme.mono-font;
                    font-size: 11.5px;
                    color: root.checked ? Theme.on-active : Theme.ink-3;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.nom;
                font-family: Theme.sans-font;
                font-size: 14px;
                font-weight: 500;
                color: Theme.ink;
                overflow: elide;
            }
            Text {
                text: root.anglais;
                font-family: Theme.sans-font;
                font-size: 12px;
                color: Theme.ink-3;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Radio { checked: root.checked; }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Onglet de la barre du haut, avec l'interrupteur qui l'affiche ou le masque.
component LigneOnglet inherits Rectangle {
    in property <string> icone;
    in property <string> titre;
    in property <string> texte;
    in property <bool> checked;
    in property <bool> verrouille;
    in property <bool> trait: true;
    callback toggled(bool);
    min-height: rangee.preferred-height;
    if root.trait: Trait { }
    rangee := HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: Theme.control;
                border-width: 1.5px;
                border-color: Theme.border-strong;
                IconeNuit {
                    nom: root.icone;
                    taille: 16px;
                    couleur: root.checked ? Theme.icon : Theme.ink-4;
                }
            }
        }
        Entete {
            horizontal-stretch: 1;
            titre: root.titre;
            texte: root.texte;
        }
        VerticalLayout {
            alignment: center;
            ToggleSwitch {
                width: 48px;
                auto: false;
                enabled: !root.verrouille;
                checked: root.checked;
                toggled(v) => { root.toggled(v); }
            }
        }
    }
}

/// Carte d'information : icône, texte gris, et un bouton éventuel à droite.
component CarteInfo inherits Rectangle {
    in property <string> text;
    in property <string> icone: "info";
    in property <string> bouton;
    in property <bool> pointille;
    callback clicked;
    border-radius: 24px;
    background: Theme.surface;
    border-width: 1.5px;
    border-color: Theme.border;
    min-height: rangee.preferred-height;
    rangee := HorizontalLayout {
        padding-left: 20px;
        padding-right: 18px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            IconeNuit {
                nom: root.icone;
                taille: 18px;
                couleur: Theme.ink-3;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-family: Theme.sans-font;
            font-size: 12.5px;
            color: Theme.ink-3;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        if root.bouton != "": VerticalLayout {
            alignment: center;
            MButton {
                text: root.bouton;
                clicked => { root.clicked(); }
            }
        }
    }
}

/// Ligne de la page About : pastille ronde avec une icône, titre et texte, puis un bouton ou
/// la flèche du lien.
component LigneLien inherits Rectangle {
    in property <string> icone;
    in property <string> titre;
    in property <string> texte;
    in property <bool> trait: true;
    /// vrai : toute la ligne est un lien (flèche à droite)
    in property <bool> lien: true;
    callback clicked;
    min-height: rangee.preferred-height;
    if root.trait: Trait { }
    if root.lien: Rectangle {
        y: 1.5px;
        height: parent.height - 1.5px;
        border-radius: 12px;
        background: zone.has-hover ? Theme.surface-2 : transparent;
        animate background { duration: Theme.fast; }
    }
    zone := TouchArea {
        enabled: root.lien;
        mouse-cursor: root.lien ? pointer : default;
        clicked => { root.clicked(); }
    }
    rangee := HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: Theme.control;
                border-width: 1.5px;
                border-color: Theme.border-strong;
                IconeNuit {
                    nom: root.icone;
                    taille: 18px;
                    couleur: Theme.icon;
                }
            }
        }
        Entete {
            horizontal-stretch: 1;
            titre: root.titre;
            texte: root.texte;
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 10px;
                @children
            }
        }
        if root.lien: VerticalLayout {
            alignment: center;
            IconeNuit {
                nom: "lien-externe";
                taille: 18px;
                couleur: Theme.ink-3;
            }
        }
    }
}

component Volet inherits VerticalLayout {
    opacity: 0;
    property <length> decalage: 10px;
    padding-top: self.decalage;
    padding-bottom: 10px - self.decalage;
    spacing: 14px;
    animate opacity { duration: 240ms; easing: ease-out; }
    animate decalage { duration: 320ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    init => {
        self.opacity = 1;
        self.decalage = 0;
    }
}

component Resultat inherits Rectangle {
    in property <SettingResult> r;
    callback clicked;
    height: 52px;
    border-radius: 14px;
    background: zone.has-hover ? Theme.surface-2 : transparent;
    animate background { duration: Theme.fast; }
    VerticalLayout {
        padding-left: 16px;
        padding-right: 12px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.r.title;
            font-family: Theme.sans-font;
            font-size: 14px;
            font-weight: 500;
            color: Theme.ink;
            overflow: elide;
        }
        Text {
            text: root.r.category;
            font-family: Theme.sans-font;
            font-size: 12px;
            color: Theme.ink-3;
            overflow: elide;
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ───────────────────────── Gestion du stockage ─────────────────────────

/// Nuances de la barre du stockage : de la plus claire à la plus sombre, une par catégorie.
global Nuances {
    out property <[color]> liste: [#F1F2F4, #C9CCD3, #A2A6AF, #858A94, #6A6F79, #545861, #43464E, #34373D, #2A2C31];
    public pure function de(i: int) -> color {
        return self.liste[Math.mod(i, self.liste.length)];
    }
}

/// Une ligne de la page du stockage : la pastille de sa couleur (catégories), le nom, l'info, la
/// taille et la corbeille. Les lignes d'une catégorie ouverte sont en retrait.
component LigneStockage inherits Rectangle {
    in property <StorageRow> r;
    in property <color> nuance;
    in property <bool> trait: true;
    min-height: rangee.preferred-height;
    if root.trait: Trait { }
    Rectangle {
        y: 1.5px;
        height: parent.height - 1.5px;
        border-radius: 14px;
        background: zone.has-hover && root.r.expandable ? Theme.surface-2 : transparent;
        animate background { duration: Theme.fast; }
    }
    zone := TouchArea {
        enabled: root.r.expandable;
        mouse-cursor: root.r.expandable ? pointer : default;
        clicked => { SettingsState.storage-toggle(root.r.cle); }
    }
    rangee := HorizontalLayout {
        padding-left: root.r.niveau == 0 ? 20px : 52px;
        padding-right: 16px;
        padding-top: root.r.niveau == 0 ? 14px : 10px;
        padding-bottom: root.r.niveau == 0 ? 14px : 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            width: 16px;
            if root.r.niveau == 0: Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 3px;
                background: root.nuance;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.r.nom;
                font-family: Theme.sans-font;
                font-size: root.r.niveau == 0 ? 14px : 13px;
                font-weight: root.r.niveau == 0 ? 500 : 400;
                color: Theme.ink;
                overflow: elide;
            }
            if root.r.info != "": Text {
                text: root.r.info;
                font-family: Theme.sans-font;
                font-size: 12px;
                color: root.r.reste ? Theme.danger : Theme.ink-3;
                overflow: elide;
            }
        }
        Text {
            text: root.r.size-text;
            font-family: Theme.mono-font;
            font-size: 13px;
            color: Theme.ink;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            width: 36px;
            if root.r.expandable: Rectangle {
                width: 16px;
                height: 16px;
                transform-rotation: root.r.expanded ? 180deg : 0deg;
                animate transform-rotation { duration: Theme.normal; }
                IconeNuit {
                    nom: "chevron";
                    taille: 14px;
                    couleur: Theme.ink-3;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            width: 40px;
            if root.r.locked: IconeNuit {
                nom: "cadenas";
                taille: 15px;
                couleur: Theme.ink-4;
            }
            if !root.r.locked: Rond {
                icone: "poubelle";
                clicked => { SettingsState.storage-delete(root.r.cle); }
            }
        }
    }
}

/// La page du stockage, à la place des réglages (bouton « Manage storage » des
/// téléchargements) : le total, une barre fragmentée (une part par catégorie), puis les
/// catégories, à ouvrir pour voir et supprimer leur contenu.
component PageStockage inherits VerticalLayout {
    padding-top: 12px;
    spacing: 14px;
    // en-tête : retour, titre, total
    HorizontalLayout {
        spacing: 14px;
        height: 44px;
        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: retour.has-hover ? Theme.border-strong : Theme.control;
            border-width: 1.5px;
            border-color: Theme.border-strong;
            animate background { duration: Theme.fast; }
            IconeNuit {
                nom: "retour";
                taille: 16px;
                couleur: Theme.icon;
            }
            retour := TouchArea {
                mouse-cursor: pointer;
                clicked => { SettingsState.storage-close(); }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: Tr.t("Stock_Titre");
            font-family: Theme.sans-font;
            font-size: 24px;
            font-weight: 600;
            letter-spacing: -0.5px;
            color: Theme.ink-strong;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: SettingsState.storage-busy ? "…" : SettingsState.storage-total;
            font-family: Theme.mono-font;
            font-size: 22px;
            font-weight: 500;
            color: Theme.ink-strong;
            vertical-alignment: center;
        }
    }
    // la barre fragmentée
    Carte {
        vertical-stretch: 0;
        spacing: 14px;
        Text {
            text: Tr.t("Stock_Intro");
            font-family: Theme.sans-font;
            font-size: 12.5px;
            color: Theme.ink-3;
            wrap: word-wrap;
        }
        HorizontalLayout {
            height: 34px;
            spacing: 0px;
            for r[i] in SettingsState.storage-rows: Rectangle {
                // seules les catégories (niveau 0) ont une part ; les autres ne prennent pas de place
                horizontal-stretch: r.niveau == 0 ? max(0.004, r.fraction) : 0;
                min-width: 0px;
                preferred-width: 0px;
                max-width: r.niveau == 0 ? 100000px : 0px;
                Rectangle {
                    x: 0;
                    width: max(0px, parent.width - 4px);
                    border-radius: 6px;
                    background: Nuances.de(i);
                    animate width { duration: 420ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                }
            }
        }
    }
    // les catégories
    if SettingsState.storage-busy: Carte {
        vertical-stretch: 1;
        Text {
            text: Tr.t("Options_Calcul");
            font-family: Theme.sans-font;
            font-size: 13px;
            color: Theme.ink-3;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if !SettingsState.storage-busy: Rectangle {
        vertical-stretch: 1;
        border-radius: 24px;
        background: Theme.surface;
        border-width: 1.5px;
        border-color: Theme.border;
        clip: true;
        ScrollView {
            x: 10px;
            y: 10px;
            width: parent.width - 20px;
            height: parent.height - 20px;
            content-width: self.visible-width;
            content-height: liste.preferred-height;
            liste := VerticalLayout {
                width: parent.visible-width;
                for r[i] in SettingsState.storage-rows: LigneStockage {
                    r: r;
                    nuance: Nuances.de(i);
                    trait: i > 0 && r.niveau == 0;
                }
            }
        }
    }
}

// ───────────────────────── La page des options ─────────────────────────

/// Section de la colonne de gauche : une pastille de 48 px, pleine quand elle est ouverte.
component SectionReglage inherits Rectangle {
    in property <string> text;
    in property <bool> actif;
    callback clicked;
    height: 48px;
    border-radius: 24px;
    background: root.actif ? Theme.active : zone.has-hover ? Theme.control : transparent;
    animate background { duration: Theme.normal; easing: ease-out; }
    Text {
        x: 18px;
        width: parent.width - 36px;
        text: root.text;
        font-family: Theme.sans-font;
        font-size: 14px;
        font-weight: 500;
        color: root.actif ? Theme.on-active : Theme.ink-4;
        vertical-alignment: center;
        overflow: elide;
        animate color { duration: Theme.normal; }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SettingsModal inherits Rectangle {
    property <bool> ouvert: SettingsState.open;
    property <int> section: SettingsState.section;
    // Sept sections (Jeu, Compte, Apparence, Langue, Téléchargements, Confidentialité, À propos)
    // qui regroupent les anciennes catégories. Les numéros de section ne changent pas (recherche,
    // Rust) : 4 et 5 → Jeu, 2 et 3 → Compte, 0 et 8 → Apparence, 1 → Langue, 6 → Téléchargements,
    // 9 → Confidentialité, 7 → À propos.
    property <int> tab: root.section == 4 || root.section == 5 ? 0 : root.section == 2 || root.section == 3 ? 1 : root.section == 0 || root.section == 8 ? 2 : root.section == 1 ? 3 : root.section == 6 ? 4 : root.section == 9 ? 5 : 6;
    property <[{ s: int, cle: string }]> onglets: [
        { s: 4, cle: "Param_Jeu" },
        { s: 2, cle: "Param_Compte" },
        { s: 0, cle: "Param_Apparence" },
        { s: 1, cle: "Param_Langue" },
        { s: 6, cle: "Param_Telechargements_Onglet" },
        { s: 9, cle: "Param_Confidentialite" },
        { s: 7, cle: "Param_APropos" },
    ];
    // tailles de fenêtre proposées à côté de la largeur et de la hauteur
    property <[{ l: string, h: string }]> tailles: [
        { l: "", h: "" },
        { l: "854", h: "480" },
        { l: "1280", h: "720" },
        { l: "1600", h: "900" },
        { l: "1920", h: "1080" },
        { l: "2560", h: "1440" },
    ];
    property <int> taille-choisie: SettingsState.game-height == "" ? 0 : SettingsState.game-height == "480" ? 1 : SettingsState.game-height == "720" ? 2 : SettingsState.game-height == "900" ? 3 : SettingsState.game-height == "1080" ? 4 : SettingsState.game-height == "1440" ? 5 : -1;

    opacity: root.ouvert ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity { duration: root.ouvert ? 220ms : 160ms; easing: ease-out; }

    // La page des options remplace la page ouverte (qui s'efface) ; elle glisse un peu en arrivant.
    carte := Rectangle {
        y: root.ouvert ? 0px : 14px;
        animate y { duration: root.ouvert ? 380ms : 160ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        TouchArea { }

        HorizontalLayout {
            spacing: 20px;
            // ═══ Colonne de gauche : titre et sections ═══
            VerticalLayout {
                width: 240px;
                padding-top: 12px;
                spacing: 6px;
                alignment: start;
                Text {
                    x: 8px;
                    text: Tr.t("Param_Titre");
                    font-family: Theme.sans-font;
                    font-size: 32px;
                    font-weight: 600;
                    letter-spacing: -1px;
                    color: Theme.ink-strong;
                    height: 54px;
                    vertical-alignment: top;
                }
                for o[i] in root.onglets: SectionReglage {
                    text: Tr.t(o.cle);
                    actif: SettingsState.search == "" && i == root.tab;
                    clicked => {
                        SettingsState.search = "";
                        SettingsState.search-changed();
                        SettingsState.section = o.s;
                        if (o.s == 6) {
                            SettingsState.storage-parts-show();
                        }
                    }
                }
            }

            // ═══ Les réglages (ou la page du stockage, à la place) ═══
            Rectangle {
            horizontal-stretch: 1;
            if SettingsState.storage-open: PageStockage {
                width: parent.width;
                height: parent.height;
            }
            ScrollView {
                visible: !SettingsState.storage-open;
                content-width: self.visible-width;
                content-height: contenu.preferred-height;

                contenu := VerticalLayout {
                    width: parent.visible-width;
                    padding-top: 12px;
                    padding-right: 8px;
                    padding-bottom: 24px;
                    spacing: 14px;
                    alignment: start;

                    // ── Recherche : les réglages trouvés ──
                    if SettingsState.search != "": Carte {
                        spacing: 4px;
                        marge: 12px;
                        for r in SettingsState.results: Resultat {
                            r: r;
                            clicked => {
                                SettingsState.section = r.section;
                                SettingsState.search = "";
                                SettingsState.search-changed();
                            }
                        }
                        if SettingsState.results.length == 0: Text {
                            text: Tr.t("Param_Recherche_Aucun");
                            font-size: 13px;
                            color: Theme.ink-3;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    // ══════════ Game ══════════
                    if SettingsState.search == "" && root.tab == 0: Volet {
                        // mémoire : la valeur en grand, un bloc par Go
                        Carte {
                            spacing: 14px;
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: Tr.t("Param_Memoire_Titre");
                                    font-family: Theme.sans-font;
                                    font-size: 14.5px;
                                    font-weight: 500;
                                    color: Theme.ink;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: SettingsState.ram-text;
                                    font-family: Theme.mono-font;
                                    font-size: 20px;
                                    font-weight: 500;
                                    color: Theme.ink-strong;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: Tr.t("Param_Memoire_Sur") + " " + round(SettingsState.ram-max / 1024) + " " + Tr.t("Unite_Go");
                                    font-family: Theme.sans-font;
                                    font-size: 12px;
                                    color: Theme.ink-3;
                                    vertical-alignment: center;
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                Blocs {
                                    horizontal-stretch: 1;
                                    minimum: 1024;
                                    maximum: SettingsState.ram-max;
                                    step: 1024;
                                    value <=> SettingsState.ram-value;
                                    changed(v) => { SettingsState.ram-changed(v); }
                                }
                            }
                            Text {
                                text: Tr.t("Param_Memoire_Conseil");
                                font-family: Theme.sans-font;
                                font-size: 12px;
                                color: Theme.ink-3;
                                wrap: word-wrap;
                            }
                        }
                        // taille de la fenêtre du jeu
                        Carte {
                            marge: 22px;
                            HorizontalLayout {
                                spacing: 10px;
                                Entete {
                                    horizontal-stretch: 1;
                                    titre: Tr.t("Param_Fenetre");
                                    texte: Tr.t("Param_Fenetre_Texte");
                                }
                                VerticalLayout {
                                    alignment: center;
                                    ChampNombre {
                                        text <=> SettingsState.game-width;
                                        placeholder: "854";
                                        edited => { SettingsState.game-size-changed(); }
                                    }
                                }
                                Text {
                                    text: "×";
                                    font-size: 13px;
                                    color: Theme.ink-3;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    ChampNombre {
                                        text <=> SettingsState.game-height;
                                        placeholder: "480";
                                        edited => { SettingsState.game-size-changed(); }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    GlassCombo {
                                        width: 92px;
                                        model: [Tr.t("Param_Fenetre_Auto"), "480p", "720p", "900p", "1080p", "1440p"];
                                        current-index: root.taille-choisie;
                                        selected(i) => {
                                            SettingsState.game-width = root.tailles[i].l;
                                            SettingsState.game-height = root.tailles[i].h;
                                            SettingsState.game-size-changed();
                                        }
                                    }
                                }
                            }
                        }
                        Groupe {
                            LigneInterrupteur {
                                trait: false;
                                titre: Tr.t("Param_PleinEcran");
                                texte: Tr.t("Param_PleinEcran_Texte");
                                checked <=> SettingsState.fullscreen;
                                toggled(v) => { SettingsState.fullscreen-toggled(v); }
                            }
                            if SettingsState.misty-client-available: LigneInterrupteur {
                                titre: Tr.t("Param_MistyClient");
                                texte: Tr.t("Param_MistyClient_Texte") + " Fabric " + SettingsState.misty-client-mc + ".";
                                checked <=> SettingsState.misty-client;
                                toggled(v) => { SettingsState.misty-client-toggled(v); }
                            }
                            LigneInterrupteur {
                                titre: Tr.t("Param_Console");
                                texte: Tr.t("Param_Console_Texte");
                                checked <=> SettingsState.console-auto;
                                toggled(v) => { SettingsState.console-auto-toggled(v); }
                            }
                            LigneInterrupteur {
                                titre: Tr.t("Param_Partage");
                                texte: Tr.t("Param_Partage_Texte");
                                checked <=> SettingsState.share-game-data;
                                toggled(v) => { SettingsState.share-game-data-toggled(v); }
                            }
                            LigneInterrupteur {
                                titre: Tr.t("Param_Raccourci");
                                texte: Tr.t("Options_Raccourci_Texte");
                                checked <=> SettingsState.shortcut-enabled;
                                toggled(v) => { SettingsState.shortcut-toggled(v); }
                            }
                            if SettingsState.shortcut-enabled: Rectangle {
                                min-height: chemin.preferred-height;
                                chemin := HorizontalLayout {
                                    padding-left: 24px;
                                    padding-right: 24px;
                                    padding-bottom: 14px;
                                    spacing: 10px;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 40px;
                                        border-radius: 20px;
                                        background: Theme.surface-2;
                                        border-width: 1.5px;
                                        border-color: Theme.border-field;
                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            spacing: 10px;
                                            VerticalLayout {
                                                alignment: center;
                                                IconeNuit {
                                                    nom: "dossier";
                                                    taille: 15px;
                                                    couleur: Theme.ink-3;
                                                }
                                            }
                                            Text {
                                                horizontal-stretch: 1;
                                                text: SettingsState.shortcut-path;
                                                font-family: Theme.mono-font;
                                                font-size: 12px;
                                                color: Theme.ink-2;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                    MButton {
                                        horizontal-stretch: 0;
                                        text: Tr.t("Options_ChoisirDossier");
                                        clicked => { SettingsState.choose-shortcut(); }
                                    }
                                    MButton {
                                        horizontal-stretch: 0;
                                        text: Tr.t("Options_Recreer");
                                        clicked => { SettingsState.recreate-shortcut(); }
                                    }
                                }
                            }
                        }
                    }

                    // ══════════ Account ══════════
                    if SettingsState.search == "" && root.tab == 1: Volet {
                        if SettingsState.ms-accounts.length > 0: Groupe {
                            for c[i] in SettingsState.ms-accounts: LigneCompte {
                                trait: i > 0;
                                pseudo: c.pseudo;
                                active: c.active && SettingsState.ms-connected;
                                use => { SettingsState.ms-switch(c.uuid); }
                                forget => { SettingsState.ms-forget(c.uuid); }
                                sign-out => { SettingsState.disconnect(); }
                            }
                        }
                        Groupe {
                            LigneInterrupteur {
                                trait: false;
                                titre: Tr.t("Param_DemanderCompte");
                                texte: Tr.t("Param_DemanderCompte_Texte");
                                checked <=> SettingsState.ask-account;
                                toggled(v) => { SettingsState.ask-account-toggled(v); }
                            }
                        }
                        // ajouter un compte : carte en pointillés (un contour discret)
                        Rectangle {
                            border-radius: 24px;
                            border-width: 1.5px;
                            border-color: Theme.border-strong;
                            min-height: ajout.preferred-height;
                            ajout := HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                padding-top: 14px;
                                padding-bottom: 14px;
                                spacing: 14px;
                                VerticalLayout {
                                    alignment: center;
                                    Rond {
                                        icone: "plus";
                                        clicked => { SettingsState.connect(); }
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Entete {
                                        titre: Tr.t("Compte_AjouterMs");
                                        texte: SettingsState.ms-busy ? SettingsState.ms-state : Tr.t("Compte_AjouterMs_Texte");
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    MButton {
                                        kind: 1;
                                        text: Tr.t("Compte_SeConnecterMs");
                                        enabled: !SettingsState.ms-busy;
                                        clicked => { SettingsState.connect(); }
                                    }
                                }
                            }
                        }
                        // comptes hors ligne
                        Carte {
                            spacing: 14px;
                            Entete {
                                titre: Tr.t("Param_HorsLigne");
                                texte: Tr.t("Options_hors_ligne_text");
                            }
                            if SettingsState.pseudo-rows.length > 0: VerticalLayout {
                                spacing: 8px;
                                for ligne in SettingsState.pseudo-rows: HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    for p in ligne.items: Pseudo {
                                        text: p;
                                        remove => { SettingsState.remove-pseudo(p); }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                GlassInput {
                                    horizontal-stretch: 1;
                                    placeholder: Tr.t("Param_Pseudo_Placeholder");
                                    text <=> SettingsState.new-pseudo;
                                    accepted => { SettingsState.add-pseudo(); }
                                }
                                MButton {
                                    horizontal-stretch: 0;
                                    icon: "\u{E710}";
                                    text: Tr.t("Options_bouton_ajout");
                                    clicked => { SettingsState.add-pseudo(); }
                                }
                            }
                        }
                        if SettingsState.ms-accounts.length > 0: HorizontalLayout {
                            alignment: end;
                            MButton {
                                text: Tr.t("Compte_DeconnexionTotale");
                                clicked => { SettingsState.disconnect-all(); }
                            }
                        }
                        CarteInfo { text: Tr.t("Compte_Jetons_Info"); }
                    }

                    // ══════════ Appearance ══════════
                    if SettingsState.search == "" && root.tab == 2: Volet {
                        Carte {
                            spacing: 14px;
                            Text {
                                text: Tr.t("Param_Theme");
                                font-family: Theme.sans-font;
                                font-size: 14.5px;
                                font-weight: 500;
                                color: Theme.ink;
                            }
                            if Theme.event != 0: Text {
                                text: Theme.halloween ? Tr.t("Param_Saison_Halloween") : Tr.t("Param_Saison_Noel");
                                font-family: Theme.sans-font;
                                font-size: 12.5px;
                                color: Theme.ink-3;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                CarteTheme {
                                    horizontal-stretch: 1;
                                    genre: 1;
                                    text: Tr.t("Param_Theme_Nuit");
                                    checked: Theme.mode == 1;
                                    clicked => { SettingsState.theme-selected(1); }
                                }
                                CarteTheme {
                                    horizontal-stretch: 1;
                                    genre: 0;
                                    text: Tr.t("Param_Theme_Brume");
                                    checked: Theme.mode == 0;
                                    clicked => { SettingsState.theme-selected(0); }
                                }
                                CarteTheme {
                                    horizontal-stretch: 1;
                                    genre: 2;
                                    text: Tr.t("Param_Theme_Systeme");
                                    checked: Theme.mode == 2;
                                    clicked => { SettingsState.theme-selected(2); }
                                }
                            }
                        }
                        Groupe {
                            LigneInterrupteur {
                                trait: false;
                                titre: Tr.t("Param_Saison");
                                texte: Tr.t("Param_Saison_Texte");
                                checked <=> SettingsState.seasonal;
                                toggled(v) => { SettingsState.seasonal-toggled(v); }
                            }
                            Ligne {
                                titre: Tr.t("Param_FondFlou");
                                texte: Tr.t("Param_FondFlou_Texte");
                                VerticalLayout {
                                    alignment: center;
                                    Blocs {
                                        width: 10 * 12px + 9 * 4px;
                                        height: 14px;
                                        bloc-max: 12px;
                                        espace: 4px;
                                        minimum: 0;
                                        maximum: 10;
                                        step: 1;
                                        value <=> SettingsState.bg-blur;
                                        changed(v) => { SettingsState.bg-blur-changed(v); }
                                    }
                                }
                                ValeurBlocs {
                                    text: SettingsState.bg-blur == 0 ? Tr.t("Param_FondFlou_Off") : round(SettingsState.bg-blur);
                                }
                            }
                        }
                        // les onglets de la barre du haut
                        Groupe {
                            Ligne {
                                trait: false;
                                titre: Tr.t("Param_Barre");
                                texte: Tr.t("Param_Barre_Texte");
                            }
                            LigneOnglet { icone: "accueil"; titre: Tr.t("Onglet_Jouer"); texte: Tr.t("Param_Barre_Toujours"); verrouille: true; checked: true; }
                            LigneOnglet { icone: "garde-robe"; titre: Tr.t("Onglet_Skin"); checked: AppState.nav-skin; toggled(v) => { SettingsState.sidebar-toggled("skin", v); } }
                            LigneOnglet { icone: "instances"; titre: Tr.t("Onglet_Profils"); checked: AppState.nav-profils; toggled(v) => { SettingsState.sidebar-toggled("profils", v); } }
                            LigneOnglet { icone: "couches"; titre: Tr.t("Onglet_Packs"); checked: AppState.nav-packs; toggled(v) => { SettingsState.sidebar-toggled("packs", v); } }
                            LigneOnglet { icone: "amis"; titre: Tr.t("Onglet_Amis"); checked: AppState.nav-amis; toggled(v) => { SettingsState.sidebar-toggled("amis", v); } }
                            LigneOnglet { icone: "info"; titre: Tr.t("Onglet_Notes"); checked: AppState.nav-notes; toggled(v) => { SettingsState.sidebar-toggled("notes", v); } }
                            LigneOnglet { icone: "dossier"; titre: Tr.t("Nav_Dossier"); checked: AppState.nav-dossier; toggled(v) => { SettingsState.sidebar-toggled("dossier", v); } }
                            LigneOnglet { icone: "reglages"; titre: Tr.t("Nav_Options"); texte: Tr.t("Param_Barre_Toujours"); verrouille: true; checked: true; }
                        }
                    }

                    // ══════════ Language ══════════
                    if SettingsState.search == "" && root.tab == 3: Volet {
                        Rectangle {
                            border-radius: 24px;
                            background: Theme.surface;
                            border-width: 1.5px;
                            border-color: Theme.border;
                            min-height: langues.preferred-height;
                            langues := VerticalLayout {
                                padding: 24px;
                                padding-top: 14px;
                                padding-bottom: 14px;
                                for l[i] in SettingsState.langs: LigneLangue {
                                    trait: i > 0;
                                    nom: l.name;
                                    anglais: l.english;
                                    code: l.code;
                                    checked: i == SettingsState.lang-index;
                                    clicked => {
                                        SettingsState.lang-index = i;
                                        SettingsState.lang-selected(i);
                                    }
                                }
                            }
                        }
                        CarteInfo {
                            icone: "globe";
                            text: Tr.t("Param_Langue_Info");
                            bouton: Tr.t("Param_Langue_Aider");
                            clicked => { AppState.open-discord(); }
                        }
                    }

                    // ══════════ Downloads ══════════
                    if SettingsState.search == "" && root.tab == 4: Volet {
                        // dossier du jeu
                        Carte {
                            marge: 18px;
                            HorizontalLayout {
                                padding-left: 2px;
                                spacing: 10px;
                                Entete {
                                    horizontal-stretch: 1;
                                    titre: Tr.t("Param_Dossier");
                                    texte: Tr.t("Param_Dossier_Texte");
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 36px;
                                        width: min(300px, chemin-dossier.preferred-width + 54px);
                                        border-radius: 18px;
                                        background: Theme.surface-2;
                                        border-width: 1.5px;
                                        border-color: Theme.border-field;
                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            spacing: 8px;
                                            VerticalLayout {
                                                alignment: center;
                                                IconeNuit {
                                                    nom: "dossier";
                                                    taille: 14px;
                                                    couleur: Theme.ink-3;
                                                }
                                            }
                                            chemin-dossier := Text {
                                                horizontal-stretch: 1;
                                                text: SettingsState.data-dir;
                                                font-family: Theme.mono-font;
                                                font-size: 12px;
                                                color: Theme.ink-2;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    MButton {
                                        text: Tr.t("Commun_OuvrirDossier");
                                        clicked => { SettingsState.open-folder(); }
                                    }
                                }
                            }
                        }
                        // stockage : barre empilée à 100 % et sa légende
                        Carte {
                            marge: 18px;
                            spacing: 16px;
                            HorizontalLayout {
                                padding-left: 2px;
                                spacing: 12px;
                                Entete {
                                    horizontal-stretch: 1;
                                    titre: Tr.t("Param_Repartition");
                                    texte: Tr.t("Param_Repartition_Texte");
                                }
                                Text {
                                    text: SettingsState.storage-parts-busy ? "…" : SettingsState.storage-parts-total;
                                    font-family: Theme.mono-font;
                                    font-size: 18px;
                                    font-weight: 500;
                                    color: Theme.ink-strong;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    MButton {
                                        text: Tr.t("Param_Cache_Bouton") + (SettingsState.cache-size != "" ? " · " + SettingsState.cache-size : "");
                                        clicked => { SettingsState.clear-cache(); }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    MButton {
                                        kind: 1;
                                        text: Tr.t("Stock_Gerer");
                                        clicked => { SettingsState.storage-show(); }
                                    }
                                }
                            }
                            // une part par catégorie, de la plus grosse (blanc) à la plus petite
                            barre := Rectangle {
                                height: 22px;
                                border-radius: 6px;
                                background: Theme.control;
                                clip: true;
                                for p[i] in SettingsState.storage-parts: Rectangle {
                                    x: barre.width * p.start;
                                    width: max(0px, barre.width * p.fraction - (i < SettingsState.storage-parts.length - 1 ? 3px : 0px));
                                    background: p.shade;
                                    animate x, width { duration: 420ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                                }
                            }
                            // légende sur trois colonnes
                            legende := Rectangle {
                                property <length> colonne: (self.width - 36px) / 3;
                                height: Math.ceil(SettingsState.storage-parts.length / 3) * 25px - 7px;
                                for p[i] in SettingsState.storage-parts: HorizontalLayout {
                                    x: Math.mod(i, 3) * (legende.colonne + 18px);
                                    y: Math.floor(i / 3) * 25px;
                                    width: legende.colonne;
                                    height: 18px;
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 2px;
                                            background: p.shade;
                                        }
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: p.name;
                                        font-family: Theme.sans-font;
                                        font-size: 12.5px;
                                        color: Theme.ink;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: p.size-text + " · " + p.percent;
                                        font-family: Theme.mono-font;
                                        font-size: 11px;
                                        color: Theme.ink-3;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        Groupe {
                            LigneInterrupteur {
                                trait: false;
                                titre: Tr.t("Param_PauseTelechargements");
                                texte: Tr.t("Param_PauseTelechargements_Texte");
                                checked <=> SettingsState.pause-downloads;
                                toggled(v) => { SettingsState.pause-downloads-toggled(v); }
                            }
                            Ligne {
                                titre: Tr.t("Param_Telechargements");
                                texte: Tr.t("Param_Telechargements_Texte");
                                VerticalLayout {
                                    alignment: center;
                                    Blocs {
                                        width: 16 * 10px + 15 * 4px;
                                        height: 14px;
                                        bloc-max: 10px;
                                        espace: 4px;
                                        minimum: 2;
                                        maximum: 32;
                                        step: 2;
                                        value <=> SettingsState.downloads;
                                        changed(v) => { SettingsState.downloads-changed(v); }
                                    }
                                }
                                ValeurBlocs { text: round(SettingsState.downloads); }
                            }
                            Ligne {
                                titre: Tr.t("Param_Stockage");
                                texte: Tr.t("Param_Stockage_Texte");
                                VerticalLayout {
                                    alignment: center;
                                    Valeur { text: SettingsState.size-text; }
                                }

                            }
                            Ligne {
                                titre: Tr.t("Options_ToutSupprimer");
                                texte: Tr.t("Options_ToutSupprimer_Texte");
                                VerticalLayout {
                                    alignment: center;
                                    MButton {
                                        kind: 2;
                                        text: Tr.t("Commun_Supprimer");
                                        clicked => { SettingsState.delete-all(); }
                                    }
                                }
                            }
                        }
                    }

                    // ══════════ Privacy ══════════
                    if SettingsState.search == "" && root.tab == 5: Volet {
                        Groupe {
                            LigneInterrupteur {
                                trait: false;
                                titre: Tr.t("Param_Telemetrie");
                                texte: Tr.t("Param_Telemetrie_Texte");
                                checked <=> SettingsState.telemetry;
                                toggled(v) => { SettingsState.telemetry-toggled(v); }
                            }
                            LigneInterrupteur {
                                titre: Tr.t("Param_Discord");
                                texte: Tr.t("Options_Discord_Texte");
                                checked <=> SettingsState.rich;
                                toggled(v) => { SettingsState.rich-toggled(v); }
                            }
                        }
                        CarteInfo {
                            text: Tr.t("Param_Politique_Texte");
                            bouton: Tr.t("Param_Politique");
                            clicked => { SettingsState.open-privacy(); }
                        }
                    }

                    // ══════════ About ══════════
                    if SettingsState.search == "" && root.tab == 6: Volet {
                        // version du launcher et mise à jour
                        Carte {
                            HorizontalLayout {
                                padding-left: 4px;
                                spacing: 20px;
                                Rectangle {
                                    width: 72px;
                                    height: 72px;
                                    border-radius: 20px;
                                    background: Theme.control;
                                    border-width: 1.5px;
                                    border-color: Theme.border-strong;
                                    IconeNuit {
                                        nom: "nuage";
                                        taille: 34px;
                                        couleur: Theme.ink;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 6px;
                                    Text {
                                        text: "MISTLY";
                                        font-family: Theme.pixel-font;
                                        font-weight: 700;
                                        font-size: 30px;
                                        letter-spacing: 2px;
                                        color: Theme.ink-strong;
                                    }
                                    Text {
                                        text: SettingsState.about-text;
                                        font-family: Theme.mono-font;
                                        font-size: 12px;
                                        color: Theme.ink-3;
                                        overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    MButton {
                                        icon: "\u{E895}";
                                        text: Tr.t("Maj_Rechercher");
                                        icon-spin: SettingsState.checking-update;
                                        clicked => { SettingsState.check-update(); }
                                    }
                                }
                            }
                        }
                        Groupe {
                            LigneLien {
                                trait: false;
                                lien: false;
                                icone: "nuage";
                                titre: "Mistly Client";
                                texte: SettingsState.misty-client-status;
                                MButton {
                                    icon: "\u{E895}";
                                    text: Tr.t("ClientMaj_Bouton");
                                    icon-spin: SettingsState.misty-client-updating;
                                    enabled: !SettingsState.misty-client-updating;
                                    clicked => { SettingsState.misty-client-update(); }
                                }
                            }
                            LigneLien {
                                icone: "globe";
                                titre: Tr.t("Param_Site");
                                texte: "mistly.cc";
                                clicked => { SettingsState.open-link("site"); }
                            }
                            LigneLien {
                                icone: "amis";
                                titre: "Discord";
                                texte: Tr.t("Param_Discord_Lien_Texte");
                                clicked => { AppState.open-discord(); }
                            }
                            LigneLien {
                                icone: "info";
                                titre: Tr.t("Param_Licence");
                                texte: "Misty License 1.0";
                                clicked => { SettingsState.open-link("license"); }
                            }
                            LigneLien {
                                icone: "console";
                                titre: "GitHub";
                                texte: "Mistly-MC/Mistly-Launcher";
                                clicked => { SettingsState.github(); }
                            }
                        }
                        // dépannage
                        Groupe {
                            LigneInterrupteur {
                                trait: false;
                                titre: Tr.t("Param_PreRelease");
                                texte: Tr.t("Param_PreRelease_Texte");
                                checked <=> SettingsState.prerelease;
                                toggled(v) => { SettingsState.prerelease-toggled(v); }
                            }
                            Ligne {
                                titre: Tr.t("Param_Journaux");
                                texte: Tr.t("Param_Journaux_Texte") + (SettingsState.logs-size != "" ? "  (" + SettingsState.logs-size + ")" : "");
                                MButton {
                                    text: Tr.t("Param_JournalMisty");
                                    clicked => { SettingsState.open-launcher-log(); }
                                }
                                Rond {
                                    icone: "dossier";
                                    clicked => { SettingsState.open-logs(); }
                                }
                            }
                            Ligne {
                                titre: Tr.t("Param_Debug");
                                texte: Tr.t("Param_Debug_Texte");
                                MButton {
                                    text: Tr.t("Param_Debug_Bouton");
                                    clicked => { SettingsState.export-debug(); }
                                }
                            }
                        }
                        Text {
                            text: Tr.t("Param_Independant") + "  ·  " + SettingsState.system-text;
                            font-family: Theme.sans-font;
                            font-size: 12px;
                            color: Theme.ink-3;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            }
        }
    }
}
