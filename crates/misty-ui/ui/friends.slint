//
// Amis, comme sur le Figma : à gauche le titre, l'ajout par pseudo et la liste (en ligne d'abord) ;
// à droite le profil de l'ami choisi. La liste est gardée sur ce PC ; « en ligne » vient du réseau
// Misty (voir misty-core, social/amis.rs).

import { Theme, Tr } from "theme.slint";
import { FriendsState, FriendCard, FriendRequest } from "state.slint";
import { MButton, IconeNuit, IconeAuto, BoutonRond } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

/// La tête d'un ami, ronde, et sa pastille d'état.
component Tete inherits Rectangle {
    in property <FriendCard> ami;
    in property <length> taille: 38px;
    in property <bool> pastille: true;
    width: root.taille;
    height: root.taille;
    Rectangle {
        border-radius: root.taille / 2;
        clip: true;
        background: Theme.control;
        border-width: 1.5px;
        border-color: Theme.border-strong;
        if root.ami.has-head: Image {
            width: parent.width;
            height: parent.height;
            source: root.ami.head;
            image-fit: fill;
            image-rendering: pixelated;
        }
        if !root.ami.has-head: Text {
            text: "?";
            font-family: Theme.sans-font;
            font-size: root.taille * 0.4;
            font-weight: 600;
            color: Theme.ink-3;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if root.pastille && FriendsState.status-known: Rectangle {
        x: parent.width - self.width + 1px;
        y: parent.height - self.height + 1px;
        width: root.taille * 0.3;
        height: self.width;
        border-radius: self.width / 2;
        background: root.ami.online ? Theme.online : Theme.ink-4;
        border-width: 2.5px;
        border-color: Theme.surface;
    }
}

/// Une ligne de la liste : la tête, le nom, l'état.
component LigneAmi inherits Rectangle {
    in property <FriendCard> ami;
    in property <bool> choisi;
    callback clicked;
    height: 56px;
    border-radius: 16px;
    background: root.choisi ? Theme.control : zone.has-hover ? Theme.surface-2 : transparent;
    border-width: 1.5px;
    border-color: root.choisi ? Theme.border-strong : transparent;
    animate background, border-color { duration: Theme.fast; }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Tete { ami: root.ami; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.ami.name;
                font-family: Theme.sans-font;
                font-size: 14px;
                font-weight: 500;
                color: Theme.ink;
                overflow: elide;
            }
            Text {
                text: !FriendsState.status-known ? Tr.t("Amis_Inconnu") : root.ami.online ? Tr.t("Amis_JoueMisty") : Tr.t("Amis_HorsLigne");
                font-family: Theme.sans-font;
                font-size: 12px;
                color: FriendsState.status-known && root.ami.online ? Theme.online-text : Theme.ink-3;
                overflow: elide;
            }
        }
    }
}

/// Une demande d'ami en attente : reçue (accepter, refuser) ou envoyée (annuler).
component LigneDemande inherits HorizontalLayout {
    in property <FriendRequest> d;
    height: 52px;
    padding-left: 12px;
    padding-right: 8px;
    spacing: 12px;
    VerticalLayout {
        alignment: center;
        Tete {
            ami: { uuid: root.d.uuid, name: root.d.name, head: root.d.head, has-head: root.d.has-head, online: false };
            pastille: false;
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.d.name;
            font-family: Theme.sans-font;
            font-size: 14px;
            font-weight: 500;
            color: Theme.ink;
            overflow: elide;
        }
        Text {
            text: root.d.incoming ? Tr.t("Amis_Demande_Recue") : Tr.t("Amis_Demande_Envoyee");
            font-family: Theme.sans-font;
            font-size: 12px;
            color: Theme.ink-3;
            overflow: elide;
        }
    }
    if root.d.incoming: VerticalLayout {
        alignment: center;
        Rectangle {
            width: 38px;
            height: 38px;
            border-radius: 19px;
            background: accepter.has-hover ? Theme.active.brighter(0.06) : Theme.active;
            IconeNuit { nom: "check"; taille: 15px; couleur: Theme.on-active; }
            accepter := TouchArea {
                mouse-cursor: pointer;
                clicked => { FriendsState.accept(root.d.uuid); }
            }
        }
    }
    VerticalLayout {
        alignment: center;
        BoutonRond {
            icone: "fermer";
            taille: 38px;
            tooltip: root.d.incoming ? Tr.t("Amis_Refuser") : Tr.t("Amis_Annuler_Demande");
            clicked => { FriendsState.decline(root.d.uuid); }
        }
    }
}

/// Petite carte d'information du profil (« STATUS », « MISTLY CLIENT »…).
component Info inherits Rectangle {
    in property <string> titre;
    in property <string> valeur;
    in property <bool> vert;
    height: 76px;
    border-radius: 18px;
    background: Theme.surface-2;
    border-width: 1.5px;
    border-color: Theme.border;
    VerticalLayout {
        padding-left: 18px;
        padding-right: 14px;
        alignment: center;
        spacing: 6px;
        Text {
            text: root.titre;
            font-family: Theme.mono-font;
            font-size: 11px;
            letter-spacing: 0.6px;
            color: Theme.ink-3;
            overflow: elide;
        }
        Text {
            text: root.valeur;
            font-family: Theme.sans-font;
            font-size: 14.5px;
            font-weight: 500;
            color: root.vert ? Theme.online-text : Theme.ink;
            overflow: elide;
        }
    }
}

/// Grand texte centré d'une colonne vide.
component Vide inherits VerticalLayout {
    in property <string> titre;
    in property <string> texte;
    alignment: center;
    spacing: 8px;
    padding: 28px;
    Text {
        text: root.titre;
        font-family: Theme.sans-font;
        font-size: 17px;
        font-weight: 500;
        color: Theme.ink;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    Text {
        text: root.texte;
        font-family: Theme.sans-font;
        font-size: 13px;
        color: Theme.ink-3;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

export component FriendsPage inherits Rectangle {
    property <int> choisi: 0;
    property <int> index: min(root.choisi, FriendsState.list.length - 1);
    property <FriendCard> ami: FriendsState.list.length > 0 ? FriendsState.list[root.index] : { name: "" };

    HorizontalLayout {
        spacing: 20px;
        // ═══ À gauche : titre, ajout, liste ═══
        VerticalLayout {
            width: min(420px, max(320px, root.width * 0.38));
            spacing: 14px;
            HorizontalLayout {
                height: 42px;
                padding-left: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: Tr.t("Onglet_Amis");
                    font-family: Theme.sans-font;
                    font-size: 32px;
                    font-weight: 600;
                    letter-spacing: -1px;
                    color: Theme.ink-strong;
                    vertical-alignment: center;
                }
                if FriendsState.status-known: HorizontalLayout {
                    spacing: 7px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 3.5px;
                            background: Theme.online;
                        }
                    }
                    Text {
                        text: FriendsState.online-count + " " + Tr.t("Amis_EnLigne").to-lowercase();
                        font-family: Theme.mono-font;
                        font-size: 12.5px;
                        color: Theme.online-text;
                        vertical-alignment: center;
                    }
                }
            }
            // ajout par pseudo Minecraft
            HorizontalLayout {
                spacing: 8px;
                height: 48px;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 24px;
                    background: Theme.surface-2;
                    border-width: 1.5px;
                    border-color: champ.has-focus ? Theme.border-strong : Theme.border-field;
                    animate border-color { duration: Theme.fast; }
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 16px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            IconeNuit {
                                nom: "amis";
                                taille: 16px;
                                couleur: Theme.ink-3;
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            if FriendsState.name == "": Text {
                                x: 0;
                                height: parent.height;
                                text: Tr.t("Amis_Pseudo");
                                font-family: Theme.sans-font;
                                font-size: 13.5px;
                                color: Theme.ink-3;
                                vertical-alignment: center;
                            }
                            champ := TextInput {
                                text <=> FriendsState.name;
                                font-family: Theme.sans-font;
                                font-size: 13.5px;
                                color: Theme.ink;
                                vertical-alignment: center;
                                single-line: true;
                                accepted => { FriendsState.add(); }
                                // on retape : le message du dernier ajout s'en va
                                edited => { FriendsState.message = ""; }
                            }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    MButton {
                        kind: 1;
                        text: Tr.t("Amis_Ajouter");
                        enabled: FriendsState.name != "" && !FriendsState.adding;
                        clicked => { FriendsState.add(); }
                    }
                }
            }
            // retour du dernier ajout
            if FriendsState.message != "": Text {
                x: 8px;
                text: FriendsState.message;
                font-family: Theme.sans-font;
                font-size: 12.5px;
                color: FriendsState.message-error ? Theme.danger : Theme.online-text;
                wrap: word-wrap;
            }
            // demandes d'ami en attente
            if FriendsState.requests.length > 0: Rectangle {
                height: demandes.preferred-height;
                border-radius: 24px;
                background: Theme.surface;
                border-width: 1.5px;
                border-color: Theme.border;
                demandes := VerticalLayout {
                    padding: 10px;
                    padding-top: 14px;
                    spacing: 2px;
                    HorizontalLayout {
                        alignment: start;
                        padding-left: 12px;
                        padding-bottom: 4px;
                        spacing: 8px;
                        Text {
                            text: Tr.t("Amis_EnAttente").to-uppercase();
                            font-family: Theme.mono-font;
                            font-size: 11px;
                            letter-spacing: 0.6px;
                            color: Theme.ink-3;
                        }
                        Text {
                            text: FriendsState.requests.length;
                            font-family: Theme.mono-font;
                            font-size: 11px;
                            color: Theme.ink;
                        }
                    }
                    for d in FriendsState.requests: LigneDemande { d: d; }
                }
            }
            // la liste
            Rectangle {
                vertical-stretch: 1;
                border-radius: 24px;
                background: Theme.surface;
                border-width: 1.5px;
                border-color: Theme.border;
                clip: true;
                if FriendsState.list.length == 0: Vide {
                    titre: Tr.t("Amis_Aucun");
                    texte: Tr.t("Amis_Vide_Texte");
                }
                if FriendsState.list.length > 0: ScrollView {
                    x: 10px;
                    y: 10px;
                    width: parent.width - 20px;
                    height: parent.height - 20px;
                    content-width: self.visible-width;
                    content-height: FriendsState.list.length * 62px;
                    for a[i] in FriendsState.list: LigneAmi {
                        x: 0;
                        y: i * 62px;
                        width: parent.width;
                        ami: a;
                        choisi: i == root.index;
                        clicked => { root.choisi = i; }
                    }
                }
            }
            // sans jeton Misty, on ne sait pas qui joue
            if !FriendsState.status-known && FriendsState.list.length > 0: Rectangle {
                border-radius: 20px;
                background: Theme.surface;
                border-width: 1.5px;
                border-color: Theme.border-strong;
                height: bandeau.preferred-height;
                bandeau := HorizontalLayout {
                    padding: 16px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        IconeNuit {
                            nom: "info";
                            taille: 16px;
                            couleur: Theme.ink-3;
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: Tr.t("Amis_SansStatut");
                        font-family: Theme.sans-font;
                        font-size: 12.5px;
                        color: Theme.ink-3;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ═══ À droite : le profil de l'ami choisi ═══
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 28px;
            background: Theme.surface;
            border-width: 1.5px;
            border-color: Theme.border;
            if FriendsState.list.length == 0: Vide {
                titre: Tr.t("Amis_Annonce_Titre");
                texte: Tr.t("Amis_Aucun_Texte");
            }
            if FriendsState.list.length > 0: VerticalLayout {
                padding: 30px;
                spacing: 24px;
                HorizontalLayout {
                    spacing: 20px;
                    Tete {
                        ami: root.ami;
                        taille: 96px;
                        pastille: false;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: root.ami.name;
                            font-family: Theme.sans-font;
                            font-size: 30px;
                            font-weight: 600;
                            letter-spacing: -0.8px;
                            color: Theme.ink-strong;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: FriendsState.status-known && root.ami.online ? Theme.online : Theme.ink-4;
                                }
                            }
                            Text {
                                text: !FriendsState.status-known ? Tr.t("Amis_Inconnu") : root.ami.online ? Tr.t("Amis_JoueMisty") : Tr.t("Amis_HorsLigne");
                                font-family: Theme.sans-font;
                                font-size: 13.5px;
                                color: FriendsState.status-known && root.ami.online ? Theme.online-text : Theme.ink-3;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 48px;
                            height: 48px;
                            border-radius: 24px;
                            background: actu.has-hover ? Theme.border-strong : Theme.control;
                            border-width: 1.5px;
                            border-color: Theme.border-strong;
                            opacity: FriendsState.refreshing ? 0.5 : 1;
                            animate background { duration: Theme.fast; }
                            IconeNuit {
                                nom: "rafraichir";
                                taille: 17px;
                                couleur: Theme.icon;
                            }
                            actu := TouchArea {
                                enabled: !FriendsState.refreshing;
                                mouse-cursor: pointer;
                                clicked => { FriendsState.refresh(); }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Info {
                        horizontal-stretch: 1;
                        titre: Tr.t("Amis_Info_Statut").to-uppercase();
                        valeur: !FriendsState.status-known ? Tr.t("Amis_Inconnu") : root.ami.online ? Tr.t("Amis_EnLigne") : Tr.t("Amis_HorsLigne");
                        vert: FriendsState.status-known && root.ami.online;
                    }
                    Info {
                        horizontal-stretch: 1;
                        titre: "MISTLY CLIENT";
                        valeur: !FriendsState.status-known ? "—" : root.ami.online ? Tr.t("Commun_Oui") : Tr.t("Amis_Info_Non");
                    }
                    Info {
                        horizontal-stretch: 1;
                        titre: Tr.t("Amis_Info_Compte").to-uppercase();
                        valeur: "Minecraft Java";
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    // retirer : contour rouge, comme sur le Figma
                    Rectangle {
                        height: 44px;
                        width: retirer.preferred-width + 44px;
                        border-radius: 22px;
                        background: zone-retirer.has-hover ? Theme.danger.with-alpha(0.12) : transparent;
                        border-width: 1.5px;
                        border-color: Theme.danger.with-alpha(0.55);
                        animate background { duration: Theme.fast; }
                        retirer := Text {
                            text: Tr.t("Amis_Retirer");
                            font-family: Theme.sans-font;
                            font-size: 13.5px;
                            font-weight: 500;
                            color: Theme.danger;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        zone-retirer := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { FriendsState.remove(root.ami.uuid); }
                        }
                    }
                }
            }
        }
    }
}
