// Détail d'un profil : contenu installé (mods, packs, datapacks, shaders) et explorateur Modrinth / CurseForge.

import { Theme, Tr, Assets } from "theme.slint";
import { InstanceState } from "state.slint";
import { Icon, PixelLabel, BodyText, SectionTitle, Badge, Thumb, IconButton, MButton, PlayButton, TabPill, GlassInput, ToggleSwitch, BoutonRond, IconeNuit } from "widgets.slint";
import { ContentBrowser } from "browser.slint";
import { ListView } from "std-widgets.slint";

/// Case « Misty Client » : le mod Misty dans ce profil (cochée de base, voir Options → Dépannage).
component CaseMisty inherits Rectangle {
    height: 36px;
    min-width: contenu.preferred-width;
    horizontal-stretch: 0;
    border-radius: 18px;
    border-width: 1.5px;
    border-color: touch.has-hover ? Theme.accent : Theme.glass-border;
    background: touch.has-hover ? Theme.glass-hover : Theme.glass;
    animate background, border-color { duration: Theme.normal; easing: ease-out; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            InstanceState.misty-on = !InstanceState.misty-on;
            InstanceState.misty-toggled(InstanceState.misty-on);
        }
    }
    contenu := HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 8px;
                border-width: 1.5px;
                border-color: InstanceState.misty-on ? Theme.accent : Theme.navy2;
                background: InstanceState.misty-on ? Theme.accent : transparent;
                animate background, border-color { duration: Theme.normal; }
                if InstanceState.misty-on: Icon {
                    text: "\u{E73E}";
                    font-size: 11px;
                    color: white;
                }
            }
        }
        Icon {
            text: "\u{E753}";
            font-size: 13px;
            color: Theme.accent;
            vertical-alignment: center;
        }
        Text {
            text: Tr.t("Instance_MistyClient");
            font-size: 13px;
            font-weight: 600;
            color: Theme.navy;
            vertical-alignment: center;
        }
    }
}

/// Pastille « Client » / « Serveur » / « Client + serveur » d'un mod (renseignée par Modrinth).
component SideChip inherits Rectangle {
    /// 1 client, 2 serveur, 3 les deux
    in property <int> side;
    height: 20px;
    width: label.preferred-width + 16px;
    border-radius: 10px;
    background: Theme.surface-2;
    border-width: 1.5px;
    border-color: Theme.border-strong;
    label := Text {
        text: root.side == 1 ? Tr.t("Env_Client") : root.side == 2 ? Tr.t("Env_Serveur") : Tr.t("Env_LesDeux");
        font-family: Theme.sans-font;
        font-size: 11px;
        color: Theme.ink-4;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component InstancePage inherits Rectangle {
    VerticalLayout {
        // la page est dans la grille de la fenêtre : pas de marge autour
        padding: 0px;
        spacing: 0px;

        // ═══ En-tête (Figma) : retour, icône ronde, nom et résumé, actions rondes, Jouer ═══
        HorizontalLayout {
            padding-bottom: 20px;
            spacing: 16px;
            VerticalLayout {
                alignment: center;
                BoutonRond {
                    icone: "retour";
                    taille: 48px;
                    tooltip: Tr.t("Profil_Retour");
                    clicked => { InstanceState.back(); }
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 60px;
                    height: 60px;
                    border-radius: 30px;
                    clip: true;
                    background: Theme.control;
                    border-width: 1.5px;
                    border-color: Theme.border-strong;
                    if InstanceState.has-icon: Image {
                        width: parent.width;
                        height: parent.height;
                        source: InstanceState.icon;
                        image-fit: cover;
                    }
                    if !InstanceState.has-icon: IconeNuit {
                        nom: "instances";
                        taille: 22px;
                        couleur: Theme.icon;
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 6px;
                if !InstanceState.renaming: Text {
                    text: InstanceState.name;
                    font-family: Theme.sans-font;
                    font-size: 30px;
                    font-weight: 600;
                    letter-spacing: -0.8px;
                    color: Theme.ink-strong;
                    overflow: elide;
                }
                // Renommage : remplace le nom le temps de la saisie
                if InstanceState.renaming: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    GlassInput {
                        width: 300px;
                        text <=> InstanceState.rename-text;
                        init => {
                            self.focus-input();
                            self.select-all();
                        }
                        accepted => { InstanceState.rename-ok(); }
                    }
                    MButton {
                        kind: 1;
                        text: "OK";
                        clicked => { InstanceState.rename-ok(); }
                    }
                }
                // le résumé : loader, Minecraft, modpack… séparés par des points
                HorizontalLayout {
                    spacing: 0px;
                    alignment: start;
                    for b[i] in InstanceState.badges: Text {
                        text: (i > 0 ? "  ·  " : "") + b.text;
                        font-family: Theme.sans-font;
                        font-size: 13.5px;
                        color: Theme.ink-3;
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                if InstanceState.is-modpack: VerticalLayout {
                    alignment: center;
                    BoutonRond {
                        icone: "rafraichir";
                        taille: 46px;
                        tooltip: Tr.t("Pack_MettreAJour");
                        clicked => { InstanceState.update-pack(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    BoutonRond {
                        icone: "dossier";
                        taille: 46px;
                        tooltip: Tr.t("Instance_Dossier");
                        clicked => { InstanceState.folder(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    BoutonRond {
                        icone: "exporter";
                        taille: 46px;
                        tooltip: Tr.t("Instance_Exporter");
                        clicked => { InstanceState.export(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    BoutonRond {
                        icone: "etoile";
                        taille: 46px;
                        tooltip: Tr.t("Instance_Icone");
                        clicked => { InstanceState.change-icon(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    BoutonRond {
                        icone: "crayon";
                        taille: 46px;
                        tooltip: Tr.t("Instance_Renommer");
                        clicked => { InstanceState.rename(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    BoutonRond {
                        icone: "poubelle";
                        taille: 46px;
                        tooltip: Tr.t("Profil_Supprimer");
                        clicked => { InstanceState.delete(); }
                    }
                }
                Rectangle { width: 4px; }
                VerticalLayout {
                    alignment: center;
                    PlayButton {
                        width: 150px;
                        height: 56px;
                        font-size: 20px;
                        text: Tr.t("Home_Bouton_Jouer");
                        clicked => { InstanceState.play(); }
                    }
                }
            }
        }

        // ═══ Onglets ═══
        HorizontalLayout {
            padding-bottom: 14px;
            spacing: 8px;
            TabPill {
                icon: "\u{E8F1}";
                text: InstanceState.content-tab-text;
                checked: InstanceState.tab == 0;
                clicked => {
                    InstanceState.tab = 0;
                    InstanceState.tab-changed(0);
                }
            }
            TabPill {
                icon: "\u{E721}";
                text: Tr.t("Instance_Decouvrir");
                checked: InstanceState.tab == 1;
                clicked => {
                    InstanceState.tab = 1;
                    InstanceState.tab-changed(1);
                }
            }
            if InstanceState.misty-available: CaseMisty { }
            Text {
                horizontal-stretch: 1;
                text: InstanceState.status;
                font-family: Theme.ui-font;
                font-size: 13px;
                font-weight: 600;
                color: Theme.navy2;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // ═══ Contenu installé ═══
        if InstanceState.tab == 0: VerticalLayout {
            vertical-stretch: 1;
            spacing: 12px;
            HorizontalLayout {
                spacing: 8px;
                for f[i] in InstanceState.filters: TabPill {
                    text: f;
                    checked: i == InstanceState.filter-index;
                    clicked => {
                        InstanceState.filter-index = i;
                        InstanceState.filter-changed(i);
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if InstanceState.updates-count > 0: MButton {
                    kind: 0;
                    icon: "\u{E896}";
                    icon-spin: InstanceState.updating-all;
                    enabled: !InstanceState.updating-all;
                    text: Tr.t("Instance_ToutMettreAJour") + " (" + InstanceState.updates-count + ")";
                    clicked => { InstanceState.update-all(); }
                }
                GlassInput {
                    width: 240px;
                    search: true;
                    placeholder: Tr.t("Instance_Filtrer");
                    text <=> InstanceState.filter-text;
                    edited(t) => { InstanceState.filter-text-changed(t); }
                }
            }

            if InstanceState.items.length > 0: ListView {
                vertical-stretch: 1;
                for c[i] in InstanceState.items: Rectangle {
                    height: 66px;
                    Rectangle {
                        y: 0;
                        height: parent.height - 8px;
                        width: parent.width - 10px;
                        border-radius: 22px;
                        background: Theme.surface;
                        border-width: 1.5px;
                        border-color: Theme.border;
                        opacity: c.active ? 1 : 0.6;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 12px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 12px;
                            Thumb {
                                width: 42px;
                                height: 42px;
                                radius: 11px;
                                logo-margin: 10px;
                                source: c.icon;
                                has-image: c.has-icon;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        horizontal-stretch: 0;
                                        text: c.title;
                                        font-family: Theme.sans-font;
                                        font-weight: 500;
                                        font-size: 14px;
                                        color: Theme.ink;
                                        overflow: elide;
                                    }
                                    if c.side > 0: VerticalLayout {
                                        alignment: center;
                                        SideChip { side: c.side; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        horizontal-stretch: 0;
                                        text: c.details;
                                        font-family: Theme.ui-font;
                                        font-size: 12px;
                                        color: Theme.text-muted;
                                        overflow: elide;
                                    }
                                    if c.update != "": Text {
                                        horizontal-stretch: 0;
                                        text: "→ " + c.update;
                                        font-family: Theme.mono-font;
                                        font-size: 11.5px;
                                        color: Theme.ink-4;
                                        overflow: elide;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                            // mise à jour disponible : une pastille (Figma « Update available »)
                            if c.update != "": VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 30px;
                                    width: maj.preferred-width + 28px;
                                    border-radius: 15px;
                                    background: zone-maj.has-hover ? Theme.border-strong : Theme.control;
                                    border-width: 1.5px;
                                    border-color: Theme.border-strong;
                                    opacity: c.updating ? 0.5 : 1;
                                    animate background { duration: Theme.fast; }
                                    maj := Text {
                                        text: c.updating ? Tr.t("Explorateur_EnCours") : Tr.t("Instance_MajDispo");
                                        font-family: Theme.sans-font;
                                        font-size: 12.5px;
                                        color: Theme.ink;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    zone-maj := TouchArea {
                                        enabled: !c.updating;
                                        mouse-cursor: pointer;
                                        clicked => { InstanceState.update-item(i); }
                                    }
                                }
                            }
                            ToggleSwitch {
                                width: 44px;
                                auto: false;
                                checked: c.active;
                                toggled => { InstanceState.toggle(i); }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    width: 36px;
                                    height: 36px;
                                    icon: "\u{E74D}";
                                    icon-size: 13px;
                                    fond: transparent;
                                    bord: transparent;
                                    encre: Theme.ink-3;
                                    tooltip: Tr.t("Commun_Supprimer");
                                    clicked => { InstanceState.remove(i); }
                                }
                            }
                        }
                    }
                }
            }

            // État vide
            if InstanceState.items.length == 0: VerticalLayout {
                vertical-stretch: 1;
                alignment: start;
                padding-top: 40px;
                spacing: 4px;
                HorizontalLayout {
                    alignment: center;
                    Image {
                        width: 64px;
                        height: 64px;
                        source: Assets.logo;
                        image-rendering: smooth;
                        opacity: 0.8;
                    }
                }
                SectionTitle {
                    text: Tr.t("Instance_Vide");
                    horizontal-alignment: center;
                    height: 40px;
                    vertical-alignment: bottom;
                }
                BodyText {
                    text: Tr.t("Instance_Vide_Texte");
                    horizontal-alignment: center;
                }
            }
        }

        // ═══ Découvrir ═══
        if InstanceState.tab == 1: ContentBrowser { vertical-stretch: 1; }
    }
}
