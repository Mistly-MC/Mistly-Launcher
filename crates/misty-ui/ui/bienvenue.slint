// Choix de la façon de jouer, pour un joueur qui n'a pas encore choisi (installations d'avant le
// parcours de bienvenue) : le même écran « Sign in » que la dernière étape du premier lancement
// (accueil.slint), seul sur le fond.

import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { Connexion } from "accueil.slint";

export component ChoixCompte inherits Rectangle {
    background: Theme.bg;
    opacity: 0;
    animate opacity { duration: 260ms; easing: ease-out; }
    init => { self.opacity = 1; }
    TouchArea { }
    Connexion {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(560px, parent.width);
        height: self.preferred-height;
        premium => { AppState.choose-premium(); }
        hors-ligne(p) => { AppState.choose-offline(p); }
    }
}
