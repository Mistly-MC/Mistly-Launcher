// Fenêtre principale (thème Nuit) : la barre du haut, les pages, la fenêtre des options, la boîte de
// dialogue et les boutons de la fenêtre.

import { Theme, Tr, Assets, Bulle } from "theme.slint";
import { AppState, DialogState, HomeState, ProfilesState, InstanceState, BrowserState, SettingsState, ChangelogState, PacksState, EditorState, FriendsState } from "state.slint";
import { Icon, PixelLabel, BodyText, SectionTitle, IconButton, ChromeButton, MButton, SlimProgress, Spinner, OutlinedText, IconeNuit, IconeAuto } from "widgets.slint";
import { BarreHaut } from "dock.slint";
import { ChoixCompte } from "bienvenue.slint";
import { Bienvenue, BienvenueState, ConnexionCode, ConnexionState } from "accueil.slint";
import { HomePage } from "home.slint";
import { ProfilesPage, ProfileCreateOverlay, ProfileWaitOverlay, ModpackInstallOverlay } from "profiles.slint";
import { InstancePage } from "instance.slint";
import { SettingsModal } from "settings.slint";
import { ChangelogPage } from "changelog.slint";
import { FriendsPage } from "friends.slint";
import { SkinState } from "skin.slint";
import { PacksPage, PackCreateOverlay } from "packs.slint";
import { EditorPage } from "editor.slint";
import { ScrollView, Palette } from "std-widgets.slint";
import { VersionPicker } from "versions.slint";
import { ConsoleOverlay, ConsoleState, LogLine, LogPane } from "console.slint";

export { ConsoleState, LogLine, LogPane }
export { BienvenueState, ConnexionState }
export { Theme, Tr, Assets, Bulle, AppState, DialogState, HomeState, ProfilesState, InstanceState, BrowserState, SettingsState, ChangelogState, PacksState, EditorState, SkinState, FriendsState }

/// Bouton rond de la fenêtre (réduire, agrandir, fermer) : 30 px, rouge au survol pour fermer.
component BoutonFenetre inherits Rectangle {
    in property <string> icone;
    in property <bool> fermer;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    border-width: 1.5px;
    border-color: zone.has-hover && root.fermer ? Theme.danger : zone.has-hover ? Theme.ink-3 : Theme.border-strong;
    background: zone.has-hover ? (root.fermer ? Theme.danger : Theme.glass-hover) : Theme.control;
    transform-scale: zone.pressed ? 0.88 : 1;
    animate background, border-color { duration: Theme.fast; }
    animate transform-scale { duration: 140ms; easing: ease-out; }
    IconeNuit {
        nom: root.icone;
        taille: 14px;
        couleur: zone.has-hover && root.fermer ? white : Theme.icon;
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Page qui apparaît en fondu en glissant vers le haut.
component Apparition inherits Rectangle {
    opacity: 0;
    property <length> decalage: 18px;
    animate opacity { duration: 260ms; easing: ease-out; }
    animate decalage { duration: 420ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    init => {
        self.opacity = 1;
        self.decalage = 0;
    }
    Rectangle {
        y: root.decalage;
        @children
    }
}

/// Page principale gardée en mémoire : fondu + léger glissement quand elle devient active,
/// invisible (et donc ni dessinée ni animée) le reste du temps.
component Onglet inherits Rectangle {
    in property <bool> actif;
    opacity: root.actif ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity { duration: root.actif ? 280ms : 120ms; easing: ease-out; }
    Rectangle {
        y: root.actif ? 0px : 18px;
        animate y { duration: 420ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        @children
    }
}

/// Écran de chargement (Figma « Loading ») : le nuage et MISTLY, 16 blocs qui se remplissent,
/// « Checking for updates… », la version du launcher, et une astuce en bas.
/// Il reste au moins 0,7 s (pas de flash) et au plus 2,5 s (on ne bloque jamais le launcher).
component Chargement inherits Rectangle {
    property <bool> fini: AppState.ready && self.minimum;
    property <bool> minimum;
    property <bool> maximum;
    property <bool> lance;
    opacity: root.fini || root.maximum ? 0 : 1;
    visible: self.opacity > 0.01;
    // le fondu attend que la barre soit pleine
    animate opacity { delay: 220ms; duration: 380ms; easing: ease-in-out; }
    Timer { interval: 700ms; running: !root.minimum; triggered => { root.minimum = true; } }
    Timer { interval: 2500ms; running: !root.maximum; triggered => { root.maximum = true; } }
    init => { root.lance = true; }
    background: Theme.bg;
    clip: true;
    TouchArea { }

    // étoiles (mêmes places que le Figma, sur 1180 × 720)
    for e in [{x: 180, y: 150, t: 5}, {x: 960, y: 200, t: 6}, {x: 1040, y: 560, t: 5}, {x: 120, y: 560, t: 6}]: Rectangle {
        x: root.width * e.x / 1180;
        y: root.height * e.y / 720;
        width: e.t * 1px;
        height: e.t * 1px;
        background: Theme.ink-4;
    }

    property <length> y0: (root.height - 160px) / 2;
    // nuage et MISTLY
    HorizontalLayout {
        x: (root.width - self.preferred-width) / 2;
        y: root.y0;
        height: 50px;
        spacing: 14px;
        Rectangle {
            width: 50px;
            height: 50px;
            border-radius: 16px;
            background: Theme.control;
            border-width: 1.5px;
            border-color: Theme.border-strong;
            Image {
                width: 28px;
                height: 28px;
                source: Assets.logo;
                colorize: Theme.ink;
                image-fit: contain;
            }
        }
        Text {
            text: "MISTLY";
            font-family: Theme.pixel-font;
            font-weight: 700;
            font-size: 30px;
            letter-spacing: 2.4px;
            color: Theme.ink-strong;
            vertical-alignment: center;
        }
    }

    // la barre de blocs se remplit pendant le chargement, puis d'un coup quand le launcher est prêt
    property <float> avance: AppState.ready ? 1 : root.lance ? 0.85 : 0;
    animate avance { duration: AppState.ready ? 240ms : 2200ms; easing: ease-out; }
    HorizontalLayout {
        x: (root.width - self.preferred-width) / 2;
        y: root.y0 + 78px;
        height: 22px;
        spacing: 5px;
        for n in 16: Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 2px;
            background: (n + 1) / 16 <= root.avance ? Theme.active : (n / 16 < root.avance ? Theme.ink-3 : Theme.control);
            animate background { duration: 120ms; }
        }
    }
    Text {
        y: root.y0 + 112px;
        width: root.width;
        text: AppState.ready ? Tr.t("Charg_Pret") : Tr.t("Charg_Maj");
        font-family: Theme.sans-font;
        font-size: 14px;
        color: Theme.ink;
        horizontal-alignment: center;
    }
    Text {
        y: root.y0 + 144px;
        width: root.width;
        text: AppState.loading-detail;
        font-family: Theme.mono-font;
        font-size: 12px;
        color: Theme.ink-3;
        horizontal-alignment: center;
    }

    // l'astuce, en bas
    property <int> astuce: AppState.loading-tip;
    Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - 40px - self.height;
        height: 53px;
        width: ligne-astuce.preferred-width;
        border-radius: 26.5px;
        background: Theme.surface;
        border-width: 1.5px;
        border-color: Theme.border;
        ligne-astuce := HorizontalLayout {
            padding-left: 21px;
            padding-right: 21px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 36px;
                    height: 22px;
                    border-radius: 6px;
                    background: Theme.control;
                    Text {
                        text: Tr.t("Charg_Astuce");
                        font-family: Theme.mono-font;
                        font-size: 10px;
                        color: Theme.ink-2;
                    }
                }
            }
            Text {
                text: root.astuce == 0 ? Tr.t("Charg_Astuce_1") : root.astuce == 1 ? Tr.t("Charg_Astuce_2") : root.astuce == 2 ? Tr.t("Charg_Astuce_3") : Tr.t("Charg_Astuce_4");
                font-family: Theme.sans-font;
                font-size: 13px;
                color: Theme.ink-2;
                vertical-alignment: center;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Mistly Launcher";
    // Slint ne lit pas le format .ico : on utilise la version PNG
    icon: @image-url("../../misty-app/assets/icone.png");
    // Taille d'origine par défaut ; la fenêtre peut ensuite être agrandie ou redimensionnée
    preferred-width: 1180px;
    preferred-height: 720px;
    // taille du Figma : en dessous, la barre du haut et les pages se chevauchent
    min-width: 1180px;
    min-height: 720px;
    no-frame: true;
    // horloge du décor : un pas toutes les 50 ms (20 images par seconde : le décor dérive
    // lentement, et l'interface est dessinée par le processeur), arrêtée pendant les pauses ;
    // elle repart d'où elle était
    Timer {
        interval: 50ms;
        running: AppState.anime;
        triggered => { AppState.temps += 50ms; }
    }
    resize-border-width: AppState.maximized ? 0px : 6px;
    // transparent : les coins arrondis du fond laissent voir le bureau
    background: transparent;
    default-font-family: Theme.ui-font;

    // Widgets standard (barres de défilement, champs…) aux couleurs du thème de Misty, pas de Windows
    property <bool> sombre: Theme.dark;
    init => {
        Palette.color-scheme = self.sombre ? ColorScheme.dark : ColorScheme.light;
        self.etroit = self.width < 1260px;
    }
    changed sombre => { Palette.color-scheme = self.sombre ? ColorScheme.dark : ColorScheme.light; }

    // Changement de page : le bouton survolé a pu disparaître, on cache sa bulle
    property <int> page: AppState.page;
    changed page => {
        Bulle.visible = false;
    }
    changed height => {
        Bulle.fenetre-hauteur = self.height;
    }

    /// hauteur de la barre du haut, marge des pages
    property <length> barre: 76px;
    property <length> marge: 40px;
    /// largeur des boutons de la fenêtre (en haut à droite)
    property <length> largeur-boutons: 142px;
    /// fenêtre étroite : la barre du haut cache le nom MISTLY et l'étiquette RUST
    property <bool> etroit;
    // (posé quand la largeur change, pas lié : la largeur des tuiles dépend de la barre)
    changed width => { self.etroit = self.width < 1260px; }
    // la première largeur peut arriver sans « changed » : on la relit une fois, après l'ouverture
    property <bool> largeur-lue;
    Timer {
        interval: 400ms;
        running: !root.largeur-lue;
        triggered => {
            root.etroit = root.width < 1260px;
            root.largeur-lue = true;
        }
    }

    clavier := FocusScope {
        key-pressed(e) => {
            if (DialogState.visible && e.text == Key.Escape) {
                DialogState.cancel();
                return accept;
            }
            if (SettingsState.open && e.text == Key.Escape) {
                SettingsState.close();
                return accept;
            }
            return reject;
        }

        // Tout le contenu est découpé aux coins arrondis de la fenêtre
        Rectangle {
        clip: true;
        border-radius: AppState.maximized ? 0px : 18px;
        background: Theme.bg;
        animate background { duration: 450ms; easing: ease-in-out; }

        VerticalLayout {
            // ── En haut : logo, éditions, pages, compte (et la place des boutons de la fenêtre) ──
            BarreHaut {
                height: root.barre;
                compact: root.etroit;
                place-fenetre: root.largeur-boutons;
            }

            // ── La page ──
            Rectangle {
                vertical-stretch: 1;
                // la page prend la place qui reste, jamais plus
                min-height: 0px;
                min-width: 0px;
                // La page s'efface quand le choix de version s'ouvre : il prend sa place.
                Rectangle {
                    opacity: HomeState.picker-open || SettingsState.open ? 0 : 1;
                    visible: self.opacity > 0.01;
                    transform-scale: HomeState.picker-open || SettingsState.open ? 0.985 : 1;
                    animate opacity { duration: HomeState.picker-open || SettingsState.open ? 160ms : 280ms; easing: ease-out; }
                    animate transform-scale { duration: 320ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                    // L'accueil va jusqu'aux bords (son paysage) ; les autres pages ont une marge.
                    // Les pages principales restent créées : changer d'onglet ne fait qu'un fondu.
                    Onglet { actif: AppState.page == 0; HomePage { } }
                    Rectangle {
                        x: root.marge;
                        width: parent.width - 2 * root.marge;
                        height: parent.height - root.marge;
                        Onglet { actif: AppState.page == 1; ProfilesPage { } }
                        Onglet { actif: AppState.page == 3; ChangelogPage { } }
                        Onglet { actif: AppState.page == 4; PacksPage { } }
                        Onglet { actif: AppState.page == 8; FriendsPage { } }
                        // Le détail d'un profil et l'éditeur sont recréés à chaque ouverture.
                        if AppState.page == 5: Apparition { InstancePage { } }
                        if AppState.page == 6: Apparition { EditorPage { } }
                    }
                }
                Rectangle {
                    x: root.marge;
                    width: parent.width - 2 * root.marge;
                    height: parent.height - root.marge;
                    // ═══ Choix de la version ou du profil ═══
                    VersionPicker { }
                    // ═══ Options (toujours présentes, pour animer leur fermeture) ═══
                    SettingsModal { }
                }
            }
        }



        // ═══ Écran de chargement (au lancement) ═══
        // ═══ Premier lancement : Premium ou Hors ligne (sous l'écran de chargement, qui s'efface) ═══
        if AppState.account-choice: ChoixCompte { }

        Chargement { }

        // ═══ Bulle d'aide (au-dessus des pages) ═══
        if Bulle.visible && !DialogState.visible: Rectangle {
            width: bulle-texte.preferred-width + 20px;
            height: 28px;
            // reste dans la fenêtre
            x: clamp(Bulle.a-droite ? Bulle.x : Bulle.x - self.width / 2, 6px, root.width - self.width - 6px);
            y: Bulle.a-droite ? Bulle.y - self.height / 2 : Bulle.y;
            border-radius: 14px;
            background: Theme.dark ? Theme.control : #1C2335;
            border-width: 1.5px;
            border-color: Theme.dark ? Theme.border-strong : transparent;
            drop-shadow-blur: 10px;
            drop-shadow-color: Theme.shadow;
            opacity: 0;
            animate opacity { delay: 300ms; duration: 150ms; }
            init => { self.opacity = 0.97; }
            bulle-texte := Text {
                text: Bulle.texte;
                color: white;
                font-family: Theme.ui-font;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // ═══ Fenêtres modales des pages (sur toute la fenêtre, barre latérale comprise) ═══
        if ProfilesState.creating: ProfileCreateOverlay { }
        if ProfilesState.waiting: ProfileWaitOverlay { }
        if ProfilesState.pack-open: ModpackInstallOverlay { }
        if PacksState.creating: PackCreateOverlay { }

        // ═══ Console du jeu ═══
        // sous la rangée du haut, qui reste utilisable (onglets, tuile Logs, boutons de la fenêtre)
        if ConsoleState.open: ConsoleOverlay {
            x: root.marge;
            y: root.barre;
            width: parent.width - 2 * root.marge;
            // jusqu'en bas (son fond cache la page) ; sa marge du bas est à l'intérieur
            height: parent.height - self.y;
        }

        // ═══ Mise à jour : avancement (bloque la fenêtre jusqu'au redémarrage) ═══
        if AppState.updating: Rectangle {
            background: Theme.scrim;
            TouchArea { }
            Rectangle {
                width: 420px;
                height: maj.preferred-height;
                border-radius: 28px;
                background: Theme.surface;
                border-width: 1.5px;
                border-color: Theme.border-field;
                drop-shadow-blur: 40px;
                drop-shadow-color: Theme.shadow;
                maj := VerticalLayout {
                    padding: 28px;
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 17px;
                            background: Theme.blue;
                            Icon {
                                text: "\u{E896}";
                                color: white;
                            }
                        }
                        SectionTitle {
                            horizontal-stretch: 1;
                            text: AppState.update-title;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                        if AppState.update-progress >= 0: Text {
                            text: Math.floor(AppState.update-progress * 100) + " %";
                            font-family: Theme.ui-font;
                            font-size: 20px;
                            font-weight: 800;
                            color: Theme.green-dark;
                            vertical-alignment: center;
                        }
                    }
                    if AppState.update-progress >= 0: SlimProgress {
                        progress: AppState.update-progress;
                    }
                    if AppState.update-progress < 0: Spinner { }
                    Text {
                        text: AppState.update-status;
                        font-family: Theme.ui-font;
                        font-size: 13px;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // ═══ Premier lancement : langue, conditions, télémétrie (avant le choix du compte), par-dessus
        // tout le reste de la fenêtre (ses commandes comprises : l'accueil a les siennes) ═══
        if BienvenueState.visible: Bienvenue { }

        // ═══ Connexion Microsoft : le code à saisir sur microsoft.com/link ═══
        if ConnexionState.visible: ConnexionCode { }

        // ═══ Boîte de dialogue ═══
        if DialogState.visible: Rectangle {
            background: Theme.scrim;
            opacity: 0;
            animate opacity { duration: 200ms; }
            init => {
                self.opacity = 1;
                clavier.focus();
            }
            TouchArea { }

            carte := Rectangle {
                width: min(500px, parent.width - 80px);
                height: contenu.preferred-height;
                border-radius: 28px;
                background: Theme.surface;
                border-width: 1.5px;
                border-color: Theme.border-strong;
                drop-shadow-blur: 48px;
                drop-shadow-color: #00000099;
                transform-scale: 0.94;
                animate transform-scale { duration: 320ms; easing: cubic-bezier(0.34, 1.32, 0.64, 1); }
                init => { self.transform-scale = 1; }

                contenu := VerticalLayout {
                    padding: 30px;
                    spacing: 14px;

                    // icône ronde, puis le titre
                    HorizontalLayout {
                        spacing: 14px;
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: 22px;
                            background: DialogState.danger ? Theme.danger.with-alpha(0.16) : Theme.control;
                            border-width: 1.5px;
                            border-color: DialogState.danger ? Theme.danger.with-alpha(0.5) : Theme.border-strong;
                            IconeAuto {
                                code: DialogState.icon;
                                taille: 18px;
                                couleur: DialogState.danger ? Theme.danger : Theme.icon;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: DialogState.title;
                            font-family: Theme.sans-font;
                            font-size: 21px;
                            font-weight: 600;
                            letter-spacing: -0.4px;
                            color: Theme.ink-strong;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    Text {
                        text: DialogState.message;
                        font-family: Theme.sans-font;
                        font-size: 14px;
                        color: Theme.ink-3;
                        wrap: word-wrap;
                    }
                    // options (mode « choix dans une liste ») : une ligne par choix
                    if DialogState.choices.length > 0: Rectangle {
                        height: min(300px, DialogState.choices.length * 60px + 8px);
                        border-radius: 20px;
                        background: Theme.surface-2;
                        border-width: 1.5px;
                        border-color: Theme.border;
                        clip: true;
                        ScrollView {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                            content-height: DialogState.choices.length * 60px;
                            content-width: self.visible-width;
                            for c[i] in DialogState.choices: Rectangle {
                                x: 0;
                                y: i * 60px;
                                width: parent.width;
                                height: 56px;
                                border-radius: 16px;
                                background: choix.has-hover ? Theme.control : transparent;
                                animate background { duration: Theme.fast; }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 14px;
                                    spacing: 12px;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 36px;
                                            height: 36px;
                                            border-radius: 18px;
                                            background: Theme.control;
                                            border-width: 1.5px;
                                            border-color: Theme.border-strong;
                                            Text {
                                                text: i + 1;
                                                font-family: Theme.mono-font;
                                                font-size: 12px;
                                                color: Theme.ink-3;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: c;
                                        font-family: Theme.sans-font;
                                        font-size: 14px;
                                        font-weight: 500;
                                        color: Theme.ink;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        IconeNuit { nom: "suivant"; taille: 14px; couleur: Theme.ink-3; }
                                    }
                                }
                                choix := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { DialogState.choose(i); }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 10px;
                        padding-top: 8px;
                        if DialogState.cancel-text != "": MButton {
                            text: DialogState.cancel-text;
                            clicked => { DialogState.cancel(); }
                        }
                        if DialogState.ok-text != "": MButton {
                            kind: DialogState.danger && DialogState.cancel-text != "" ? 2 : 1;
                            text: DialogState.ok-text;
                            clicked => { DialogState.ok(); }
                        }
                    }
                }
            }
        }

        // ═══ Boutons de la fenêtre : au-dessus de tout (fenêtres de choix, options, console,
        // dialogues), pour toujours pouvoir réduire ou fermer Misty ═══
        HorizontalLayout {
            // à droite de la barre du haut, à la place qu'elle leur laisse
            x: parent.width - root.marge - self.width;
            y: (root.barre - self.height) / 2;
            width: self.preferred-width;
            height: self.preferred-height;
            spacing: 4px;
            // séparation entre le compte (barre du haut) et les boutons de la fenêtre
            VerticalLayout {
                alignment: center;
                padding-right: 8px;
                Rectangle {
                    width: 1.5px;
                    height: 24px;
                    background: Theme.border-strong;
                }
            }
            BoutonFenetre {
                icone: "reduire";
                clicked => { AppState.minimize(); }
            }
            BoutonFenetre {
                icone: AppState.maximized ? "restaurer" : "agrandir";
                clicked => { AppState.toggle-maximize(); }
            }
            BoutonFenetre {
                icone: "fermer";
                fermer: true;
                clicked => { AppState.close(); }
            }
        }
        }
    }
}
