// Barre du haut du thème Nuit (0.4.1), comme la maquette Figma : le logo, le choix de l'édition
// (Mistly Client · Java · Bedrock · Horizon), les boutons ronds des pages, l'avatar du compte, puis
// la place des boutons de la fenêtre (dessinés par main.slint, au-dessus de tout).
// Toute la barre sert aussi à déplacer la fenêtre (double-clic : agrandir).

import { Theme, Tr, Assets, Bulle } from "theme.slint";
import { HomeState, AppState, SettingsState } from "state.slint";
import { SkinState } from "skin.slint";
import { Icon, Thumb, IconeNuit, BoutonRond } from "widgets.slint";

/// Tuile : la brique des anciennes pages (même rayon, même fond, même bord partout).
export component Tuile inherits Rectangle {
    border-radius: 20px;
    background: Theme.surface;
    border-width: 1.5px;
    border-color: Theme.border;
}

/// Tuile carrée avec une icône (et sa bulle d'aide au survol).
export component TuileIcone inherits Rectangle {
    in property <string> icon;
    in property <string> tooltip;
    in property <bool> active;
    in property <bool> enabled: true;
    /// la bulle s'ouvre à droite (colonne de gauche) ou au-dessus/dessous (barres)
    in property <bool> bulle-a-droite: false;
    /// la bulle s'ouvre sous la tuile (rangée du haut)
    in property <bool> bulle-dessous: false;
    callback clicked;
    border-radius: min(self.width, self.height) / 2;
    background: root.active ? Theme.active : zone.has-hover && root.enabled ? Theme.glass-hover : Theme.control;
    border-width: 1.5px;
    border-color: root.active ? Theme.active : zone.has-hover && root.enabled ? Theme.ink-3 : Theme.border-strong;
    opacity: root.enabled ? 1 : 0.5;
    animate background, border-color { duration: Theme.fast; }
    Icon {
        text: root.icon;
        font-size: 16px;
        color: root.active ? Theme.on-active : Theme.icon;
        transform-scale: zone.pressed ? 0.88 : 1;
        animate transform-scale { duration: 120ms; easing: ease-out; }
    }
    zone := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            Bulle.visible = false;
            root.clicked();
        }
    }
    property <bool> survol: zone.has-hover;
    changed survol => {
        if (self.survol && root.tooltip != "") {
            Bulle.texte = root.tooltip;
            Bulle.x = root.bulle-a-droite ? root.absolute-position.x + root.width + 10px : root.absolute-position.x + root.width / 2;
            Bulle.y = root.bulle-a-droite ? root.absolute-position.y + root.height / 2 : root.bulle-dessous ? root.absolute-position.y + root.height + 8px : root.absolute-position.y - 34px;
            Bulle.a-droite = root.bulle-a-droite;
            Bulle.visible = true;
        } else if (Bulle.texte == root.tooltip) {
            Bulle.visible = false;
        }
    }
}

/// Une édition du sélecteur : pastille blanche quand elle est choisie.
component Edition inherits Rectangle {
    in property <string> text;
    in property <bool> actif;
    in property <bool> nuage;
    in property <bool> rust;
    in property <bool> compact;
    callback clicked;
    height: 38px;
    width: contenu.preferred-width;
    border-radius: 19px;
    // la pastille de l'édition choisie est dessinée par le sélecteur (elle glisse de l'une à l'autre)
    background: !root.actif && zone.has-hover ? Theme.glass-hover : transparent;
    animate background { duration: Theme.normal; easing: ease-out; }
    contenu := HorizontalLayout {
        padding-left: root.nuage ? 10px : 14px;
        padding-right: 14px;
        spacing: 8px;
        if root.nuage: VerticalLayout {
            alignment: center;
            IconeNuit {
                nom: "nuage";
                taille: 16px;
                couleur: root.actif ? Theme.on-active : Theme.ink-4;
            }
        }
        Text {
            text: root.text;
            font-family: Theme.ui-font;
            font-size: 13.5px;
            font-weight: 500;
            color: root.actif ? Theme.on-active : zone.has-hover ? Theme.ink : Theme.ink-4;
            vertical-alignment: center;
            animate color { duration: Theme.normal; }
        }
        if root.rust && !root.compact: VerticalLayout {
            alignment: center;
            Rectangle {
                height: 18px;
                width: tag.preferred-width + 12px;
                border-radius: 6px;
                background: root.actif ? Theme.on-active : Theme.border-field;
                animate background { duration: Theme.normal; }
                tag := Text {
                    text: "RUST";
                    font-family: Theme.mono-font;
                    font-size: 10.5px;
                    font-weight: 500;
                    color: root.actif ? Theme.active : Theme.ink-4;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Bulle.visible = false;
            root.clicked();
        }
    }
}

/// Le choix de l'édition : Mistly Client (par défaut) · Java · Bedrock · Horizon.
component SelecteurEdition inherits Rectangle {
    in property <bool> compact;
    height: 48px;
    width: rang.preferred-width;
    border-radius: 24px;
    background: Theme.surface-2;
    border-width: 1.5px;
    border-color: Theme.border-field;
    // la pastille blanche glisse sous l'édition choisie
    property <length> pastille-x: HomeState.edition == 0 ? e0.x : HomeState.edition == 1 ? e1.x : HomeState.edition == 2 ? e2.x : e3.x;
    property <length> pastille-l: HomeState.edition == 0 ? e0.width : HomeState.edition == 1 ? e1.width : HomeState.edition == 2 ? e2.width : e3.width;
    Rectangle {
        x: root.pastille-x;
        y: (parent.height - self.height) / 2;
        width: root.pastille-l;
        height: 38px;
        border-radius: 19px;
        background: Theme.active;
        animate x, width { duration: 320ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    }
    rang := HorizontalLayout {
        padding: 4px;
        spacing: 4px;
        e0 := Edition {
            text: "Mistly Client";
            nuage: true;
            actif: HomeState.edition == 0;
            clicked => { HomeState.edition-selected(0); }
        }
        VerticalLayout {
            alignment: center;
            padding-left: 2px;
            padding-right: 2px;
            Rectangle {
                width: 1.5px;
                height: 20px;
                background: Theme.border-strong;
            }
        }
        e1 := Edition {
            text: "Java";
            actif: HomeState.edition == 1;
            clicked => { HomeState.edition-selected(1); }
        }
        e2 := Edition {
            text: "Bedrock";
            actif: HomeState.edition == 2;
            clicked => { HomeState.edition-selected(2); }
        }
        e3 := Edition {
            text: "Horizon";
            rust: true;
            compact: root.compact;
            actif: HomeState.edition == 3;
            clicked => { HomeState.edition-selected(3); }
        }
    }
}

/// L'avatar du compte : un clic ouvre la liste des comptes (et l'ajout d'un compte Microsoft).
component BoutonCompte inherits Rectangle {
    in property <length> taille: 48px;
    width: root.taille;
    height: root.taille;
    border-radius: root.taille / 2;
    border-width: 1.5px;
    border-color: zone.has-hover ? Theme.ink-3 : Theme.border-strong;
    background: Theme.control;
    clip: true;
    transform-scale: zone.pressed ? 0.92 : zone.has-hover ? 1.05 : 1;
    animate border-color { duration: Theme.fast; }
    animate transform-scale { duration: 200ms; easing: cubic-bezier(0.34, 1.4, 0.64, 1); }
    Thumb {
        width: parent.width;
        height: parent.height;
        radius: root.taille / 2;
        logo-margin: 12px;
        logo-opacity: 0.9;
        source: HomeState.avatar;
        has-image: HomeState.has-avatar;
        pixel-art: true;
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Bulle.visible = false;
            liste.show();
        }
    }
    property <bool> survol: zone.has-hover;
    property <string> nom: HomeState.premium ? HomeState.premium-name : Tr.t("Nav_Compte");
    changed survol => {
        if (self.survol) {
            Bulle.texte = root.nom;
            Bulle.x = root.absolute-position.x + root.width / 2;
            Bulle.y = root.absolute-position.y + root.height + 8px;
            Bulle.a-droite = false;
            Bulle.visible = true;
        } else if (Bulle.texte == root.nom) {
            Bulle.visible = false;
        }
    }
    liste := PopupWindow {
        x: root.width - self.width;
        y: root.height + 10px;
        width: 260px;
        height: comptes.preferred-height;
        Rectangle {
            background: Theme.popup;
            border-radius: 20px;
            border-width: 1.5px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow;
            comptes := VerticalLayout {
                padding: 8px;
                spacing: 2px;
                for c[i] in HomeState.all-accounts: Rectangle {
                    height: 42px;
                    border-radius: 14px;
                    background: ligne.has-hover ? Theme.popup-hover : i == HomeState.all-index ? Theme.accent-soft : transparent;
                    animate background { duration: Theme.fast; }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: i == HomeState.all-index ? Theme.online : Theme.border-strong;
                            }
                        }
                        Text {
                            text: c;
                            font-family: Theme.ui-font;
                            font-size: 13.5px;
                            font-weight: i == HomeState.all-index ? 600 : 400;
                            color: Theme.ink;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    ligne := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            HomeState.all-index = i;
                            HomeState.all-selected(i);
                        }
                    }
                }
                if HomeState.all-accounts.length > 0: Rectangle {
                    height: 9px;
                    Rectangle {
                        height: 1.5px;
                        background: Theme.border;
                    }
                }
                Rectangle {
                    height: 42px;
                    border-radius: 14px;
                    background: ajout.has-hover ? Theme.popup-hover : transparent;
                    opacity: HomeState.ms-busy ? 0.5 : 1;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            IconeNuit {
                                nom: "plus";
                                taille: 16px;
                            }
                        }
                        Text {
                            text: Tr.t("Nav_AjouterCompte");
                            font-family: Theme.ui-font;
                            font-size: 13.5px;
                            color: Theme.icon;
                            vertical-alignment: center;
                        }
                    }
                    ajout := TouchArea {
                        enabled: !HomeState.ms-busy;
                        mouse-cursor: pointer;
                        clicked => { HomeState.ms-clicked(); }
                    }
                }
            }
        }
    }
}

export component BarreHaut inherits Rectangle {
    /// fenêtre étroite : le nom MISTLY et l'étiquette RUST se cachent
    in property <bool> compact;
    /// place laissée à droite pour les boutons de la fenêtre (dessinés par main.slint)
    in property <length> place-fenetre: 110px;
    height: 76px;
    // déplacer la fenêtre : toute la barre, sauf ses boutons (qui reçoivent le clic avant)
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                AppState.drag();
            }
        }
        double-clicked => { AppState.toggle-maximize(); }
    }
    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px + root.place-fenetre;
        spacing: 16px;
        // logo : la tuile au nuage et MISTLY en pixel
        HorizontalLayout {
            spacing: 14px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 12px;
                    background: Theme.control;
                    border-width: 1.5px;
                    border-color: Theme.border-strong;
                    IconeNuit {
                        nom: "nuage";
                        taille: 22px;
                        couleur: Theme.ink;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppState.nav-clicked(0); }
                    }
                }
            }
            if !root.compact: Text {
                text: "MISTLY";
                font-family: Theme.pixel-font;
                font-weight: 700;
                font-size: 22px;
                letter-spacing: 2px;
                color: Theme.ink-strong;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            alignment: center;
            // le choix de l'édition ne sert que sur l'accueil : ailleurs il s'efface (sa place
            // reste, pour que les onglets ne bougent pas)
            SelecteurEdition {
                compact: root.compact;
                opacity: AppState.page == 0 && SkinState.tab == 0 && !SettingsState.open ? 1 : 0;
                visible: self.opacity > 0.01;
                animate opacity { duration: 200ms; easing: ease-out; }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            VerticalLayout {
                alignment: center;
                BoutonRond {
                    taille: 44px;
                    icone: "accueil";
                    tooltip: Tr.t("Onglet_Jouer");
                    actif: AppState.nav == 0 && !SettingsState.open;
                    clicked => { AppState.nav-clicked(0); }
                }
            }
            VerticalLayout {
                alignment: center;
                BoutonRond {
                    taille: 44px;
                    icone: "decouvrir";
                    tooltip: Tr.t("Nav_Decouvrir");
                    actif: AppState.nav == 9 && !SettingsState.open;
                    clicked => { AppState.nav-clicked(9); }
                }
            }
            if AppState.nav-skin: VerticalLayout {
                alignment: center;
                BoutonRond {
                    taille: 44px;
                    icone: "garde-robe";
                    tooltip: Tr.t("Onglet_Skin");
                    actif: AppState.nav == 7 && !SettingsState.open;
                    clicked => { AppState.nav-clicked(7); }
                }
            }
            if AppState.nav-profils: VerticalLayout {
                alignment: center;
                BoutonRond {
                    taille: 44px;
                    icone: "instances";
                    tooltip: Tr.t("Onglet_Profils");
                    actif: (AppState.nav == 1 || AppState.page == 5) && !SettingsState.open;
                    clicked => { AppState.nav-clicked(1); }
                }
            }
            if AppState.nav-amis: VerticalLayout {
                alignment: center;
                BoutonRond {
                    taille: 44px;
                    icone: "amis";
                    tooltip: Tr.t("Onglet_Amis");
                    actif: AppState.nav == 8 && !SettingsState.open;
                    clicked => { AppState.nav-clicked(8); }
                }
            }
            if AppState.nav-notes: VerticalLayout {
                alignment: center;
                BoutonRond {
                    taille: 44px;
                    icone: "notes";
                    tooltip: Tr.t("Home_Notes");
                    actif: AppState.nav == 3 && !SettingsState.open;
                    clicked => { AppState.nav-clicked(3); }
                }
            }
            VerticalLayout {
                alignment: center;
                BoutonRond {
                    taille: 44px;
                    icone: "reglages";
                    tooltip: Tr.t("Nav_Options");
                    actif: SettingsState.open;
                    clicked => { AppState.nav-clicked(2); }
                }
            }
            VerticalLayout {
                alignment: center;
                padding-left: 4px;
                BoutonCompte {
                    taille: 44px;
                }
            }
        }
    }
}
