// Fenêtre de choix de la version : une affiche par mise à jour (1.21 Tricky Trials…) illustrée en
// pixel art, et à droite le détail de celle choisie (bannière, versions, mod loader, un bouton qui
// confirme). En haut, filtres par type, puis Misty Client et Horizon, et recherche.

import { Theme, Tr, Assets } from "theme.slint";
import { HomeState, VersionItem, ProfileItem, VersionGroup, HorizonBuild } from "state.slint";
import { Icon, PixelLabel, BodyText, GlassInput, MButton, OutlinedText, IconButton, BoutonRond, IconeNuit } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

/// Pastille de filtre (type, loader, onglet).
component Puce inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <color> point: transparent;
    callback clicked;
    height: 36px;
    width: contenu.preferred-width;
    border-radius: 11px;
    background: root.checked ? Theme.fill : zone.has-hover && root.enabled ? Theme.glass-hover : Theme.glass;
    border-width: 1.5px;
    border-color: root.checked ? Theme.fill : Theme.glass-border;
    opacity: root.enabled ? 1 : 0.4;
    transform-scale: zone.pressed && root.enabled ? 0.95 : 1;
    animate background, border-color { duration: Theme.normal; }
    animate transform-scale { duration: 140ms; easing: ease-out; }
    contenu := HorizontalLayout {
        padding-left: 13px;
        padding-right: 13px;
        spacing: 7px;
        if root.point != transparent: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 2px;
                background: root.point;
            }
        }
        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 600;
            color: root.checked ? Theme.on-fill : Theme.navy;
            vertical-alignment: center;
        }
    }
    zone := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

global Couleurs {
    /// types : release, snapshot, bêta, alpha
    out property <[color]> types: [#4ADE80, #FFBE5A, #C4C7D0, #FF8A7A];
    /// loaders filtrés : tous, Fabric, Forge, NeoForge, OptiFine, LiteLoader, Quilt
    out property <[color]> loaders: [transparent, #DBC9A3, #E0915A, #F2A65A, #E25A5A, #6FA3F0, #B58CF0];
}

/// Une mise à jour dans la liste (une par ligne) : l'illustration en vignette, le numéro, le
/// nom, puis le nombre de versions et les années à droite.
component LigneGroupe inherits Rectangle {
    in property <VersionGroup> g;
    in property <bool> checked;
    callback clicked;
    height: 70px;
    border-radius: 20px;
    background: root.checked ? Theme.surface-2 : zone.has-hover ? Theme.surface : transparent;
    border-width: 1.5px;
    border-color: root.checked ? Theme.ink : zone.has-hover ? Theme.border-strong : Theme.border;
    animate background, border-color { duration: Theme.fast; }
    HorizontalLayout {
        padding: 9px;
        padding-right: 20px;
        spacing: 16px;
        Rectangle {
            width: 92px;
            border-radius: 13px;
            clip: true;
            background: Theme.control;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.g.art;
                image-fit: cover;
                image-rendering: pixelated;
            }
        }
        Text {
            text: root.g.title;
            font-family: Theme.mono-font;
            font-size: 17px;
            font-weight: 500;
            color: Theme.ink-strong;
            vertical-alignment: center;
            min-width: 70px;
        }
        Text {
            horizontal-stretch: 1;
            text: root.g.name;
            font-family: Theme.sans-font;
            font-size: 14px;
            color: Theme.ink;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.g.count + " · " + root.g.years;
            font-family: Theme.sans-font;
            font-size: 12.5px;
            color: Theme.ink-3;
            vertical-alignment: center;
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Version dans la mise à jour choisie.
component PuceVersion inherits Rectangle {
    in property <VersionItem> v;
    in property <bool> checked;
    callback clicked;
    height: 42px;
    border-radius: 18px;
    background: root.checked ? Theme.fill : zone.has-hover ? Theme.glass-hover : Theme.glass-strong;
    border-width: 1.5px;
    border-color: root.checked ? Theme.fill : zone.has-hover ? Theme.accent.with-alpha(0.5) : Theme.glass-border;
    drop-shadow-blur: root.checked ? 16px : 0px;
    drop-shadow-color: Theme.accent.with-alpha(0.4);
    transform-scale: zone.pressed ? 0.95 : zone.has-hover ? 1.04 : 1;
    animate background, border-color, drop-shadow-blur { duration: Theme.normal; }
    animate transform-scale { duration: 160ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 7px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 2px;
                background: Couleurs.types[root.v.kind];
            }
        }
        Text {
            text: root.v.id;
            font-family: Theme.ui-font;
            font-size: 12.5px;
            color: root.checked ? Theme.on-fill : Theme.navy;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Carte d'un mod loader de la version choisie.
component CarteLoader inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled;
    callback clicked;
    height: 52px;
    // les cartes se partagent la largeur de la ligne (4 ou 5 loaders, même fenêtre étroite)
    horizontal-stretch: 1;
    min-width: nom.preferred-width + 20px;
    preferred-width: nom.preferred-width + 46px;
    max-width: 150px;
    border-radius: 20px;
    background: root.checked ? Theme.accent-soft : zone.has-hover && root.enabled ? Theme.glass-hover : Theme.glass-strong;
    border-width: root.checked ? 2px : 1px;
    border-color: root.checked ? Theme.accent : Theme.glass-border;
    opacity: root.enabled ? 1 : 0.5;
    transform-scale: zone.pressed && root.enabled ? 0.95 : 1;
    animate background, border-color { duration: Theme.normal; }
    animate transform-scale { duration: 140ms; easing: ease-out; }
    nom := Text {
        text: root.text;
        font-size: 14px;
        font-weight: 600;
        color: root.checked ? Theme.accent : Theme.navy;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    zone := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}


/// Une version de Misty Client, en puce.
component PuceMisty inherits Rectangle {
    in property <string> version;
    in property <bool> checked;
    callback clicked;
    height: 56px;
    border-radius: 20px;
    background: root.checked ? Theme.active : zone.has-hover ? Theme.surface-2 : Theme.surface;
    border-width: 1.5px;
    border-color: root.checked ? Theme.active : zone.has-hover ? Theme.border-strong : Theme.border;
    animate background, border-color { duration: Theme.normal; }
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Image {
                width: 18px;
                height: 18px;
                source: Assets.logo;
                colorize: root.checked ? Theme.on-active : Theme.ink-3;
                image-fit: contain;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: "Mistly " + root.version;
            font-family: Theme.sans-font;
            font-size: 14.5px;
            font-weight: 500;
            color: root.checked ? Theme.on-active : Theme.ink;
            vertical-alignment: center;
        }
        if root.checked: VerticalLayout {
            alignment: center;
            IconeNuit { nom: "check"; taille: 14px; couleur: Theme.on-active; }
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Panneau Mistly Client, comme les versions : ses versions à gauche ; à droite, la bannière et
/// « Choisir » (un clic sur une puce la sélectionne seulement).
component PanneauMisty inherits HorizontalLayout {
    spacing: 16px;
    // versions, en grille : autant de puces par ligne que la place le permet
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 10px;
        PixelLabel {
            text: Tr.t("Ver_Onglet_Versions");
            font-size: 11px;
        }
        grille-misty := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: liste-misty.preferred-height + 8px;
            liste-misty := VerticalLayout {
                x: 4px;
                y: 4px;
                width: grille-misty.visible-width - 8px;
                spacing: 8px;
                for l in HomeState.misty-lines: VerticalLayout {
                    // en-tête d'une famille : un clic l'ouvre ou la replie
                    if l.header: Rectangle {
                        height: 44px;
                        HorizontalLayout {
                            padding-left: 6px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    transform-rotation: l.open ? 0deg : -90deg;
                                    animate transform-rotation { duration: 200ms; easing: ease-out; }
                                    IconeNuit {
                                        nom: "chevron";
                                        taille: 14px;
                                        couleur: Theme.ink-3;
                                    }
                                }
                            }
                            Text {
                                text: l.text;
                                font-family: Theme.mono-font;
                                font-size: 14px;
                                font-weight: 500;
                                color: Theme.ink;
                                vertical-alignment: center;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: l.count;
                                font-family: Theme.mono-font;
                                font-size: 12px;
                                color: Theme.ink-4;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { HomeState.misty-family-toggled(l.family); }
                        }
                    }
                    if !l.header: PuceMisty {
                        version: l.text;
                        checked: l.text == HomeState.misty-mc;
                        clicked => { HomeState.misty-select(l.text); }
                    }
                }
            }
        }
    }

    // à droite : la bannière, puis Choisir
    Rectangle {
        width: 340px;
        border-radius: 18px;
        background: Theme.panel-strong;
        border-width: 1.5px;
        border-color: Theme.glass-border;
        VerticalLayout {
            padding: 14px;
            spacing: 10px;
            Rectangle {
                height: 200px;
                border-radius: 14px;
                clip: true;
                background: @linear-gradient(135deg, #111317 0%, #24262B 55%, #3A3D44 100%);
                Image {
                    x: 0;
                    width: parent.width;
                    height: max(parent.height, parent.width * 90 / 160);
                    y: min(0px, parent.height - self.height * 82 / 90);
                    source: HomeState.misty-art;
                    image-fit: fill;
                    image-rendering: pixelated;
                    opacity: 0.5;
                }
                Rectangle {
                    background: @linear-gradient(0deg, #07090CE6 0%, #07090C80 55%, #07090C00 100%);
                }
                Image {
                    width: 64px;
                    height: 64px;
                    x: parent.width - self.width - 14px;
                    y: 14px;
                    source: Assets.logo;
                }
                VerticalLayout {
                    padding: 14px;
                    spacing: 4px;
                    alignment: end;
                    PixelLabel {
                        text: Tr.t("Misty_Etiquette");
                        font-size: 10px;
                        color: #E6E8EC;
                    }
                    HorizontalLayout {
                        alignment: start;
                        OutlinedText {
                            text: "MISTLY";
                            font-size: 30px;
                            thickness: 3px;
                            depth: 3px;
                            stroke-color: #1A1C21;
                            shadow: #07090C;
                        }
                    }
                    Text {
                        text: Tr.t("Misty_Titre");
                        font-size: 14px;
                        font-weight: 600;
                        color: white;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "Minecraft " + HomeState.misty-mc + " · Fabric";
                        font-size: 12px;
                        color: #D6D8DD;
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
            MButton {
                kind: 1;
                icon: "\u{E73E}";
                enabled: HomeState.misty-mc != "";
                text: Tr.t("Ver_Choisir") + " Mistly " + HomeState.misty-mc;
                clicked => {
                    HomeState.misty-select(HomeState.misty-mc);
                    HomeState.picker-open = false;
                }
            }
        }
    }
}

/// Un build d'Horizon, en puce comme les versions : un clic le sélectionne (« Choisir » en bas
/// ferme le choix). Il est téléchargé au lancement (JOUER), pas avant.
component PuceBuild inherits Rectangle {
    in property <HorizonBuild> b;
    in property <bool> checked;
    property <bool> charge: HomeState.horizon-busy && HomeState.horizon-busy-tag == root.b.tag;
    height: 56px;
    border-radius: 20px;
    clip: true;
    background: root.checked ? Theme.active : zone.has-hover ? Theme.surface-2 : Theme.surface;
    border-width: 1.5px;
    border-color: root.checked ? Theme.active : zone.has-hover ? Theme.border-strong : Theme.border;
    transform-scale: zone.pressed ? 0.99 : 1;
    animate background, border-color { duration: Theme.normal; }
    animate transform-scale { duration: 160ms; easing: ease-out; }
    // téléchargement : la puce se remplit
    if root.charge: Rectangle {
        x: 0;
        width: parent.width * clamp(HomeState.horizon-progress, 0, 1);
        background: #F0795A40;
    }
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 2px;
                background: root.b.nightly ? #FFBE5A : #4ADE80;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.b.nightly && root.b.date != "" ? "Nightly · " + root.b.date : root.b.tag;
            font-family: Theme.sans-font;
            font-size: 14.5px;
            font-weight: 500;
            color: root.checked ? Theme.on-active : Theme.ink;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.b.installed ? Tr.t("Hz_Installe") : Tr.t("Hz_PasInstalle");
            font-family: Theme.sans-font;
            font-size: 12.5px;
            color: root.checked ? Theme.on-active.with-alpha(0.7) : root.b.installed ? Theme.online-text : Theme.ink-3;
            vertical-alignment: center;
        }
    }
    zone := TouchArea {
        enabled: !HomeState.horizon-busy;
        mouse-cursor: pointer;
        clicked => { HomeState.horizon-select(root.b.tag); }
    }
}

/// Horizon, comme les versions : ses builds à gauche ; à droite, la bannière, puis supprimer (si
/// le build est installé) et « Choisir ». Un clic sur une puce sélectionne seulement.
component PanneauHorizon inherits HorizontalLayout {
    spacing: 16px;
    // builds
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            PixelLabel {
                text: Tr.t("Hz_Builds");
                font-size: 11px;
            }
            if HomeState.horizon-loading: Icon {
                text: "\u{E895}";
                font-size: 11px;
                color: #F0795A;
                transform-rotation: (animation-tick() / 1000ms) * 360deg;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        grille-builds := ScrollView {
            vertical-stretch: 1;
            property <int> colonnes: 1;
            property <length> largeur: (self.visible-width - 8px - (self.colonnes - 1) * 8px) / self.colonnes;
            content-width: self.visible-width;
            content-height: ceil(HomeState.horizon-visibles / self.colonnes) * 64px + 10px;
            // les builds filtrés (Tous, Nightly, Stables) sont rangés à la suite
            for b[i] in HomeState.horizon-builds: PuceBuild {
                property <int> rang: HomeState.horizon-ranks[i];
                visible: self.rang >= 0;
                x: 4px + Math.mod(max(0, self.rang), grille-builds.colonnes) * (grille-builds.largeur + 8px);
                y: 4px + floor(max(0, self.rang) / grille-builds.colonnes) * 64px;
                width: grille-builds.largeur;
                b: b;
                checked: HomeState.horizon-selected && b.tag == HomeState.horizon-build;
            }
        }
        if HomeState.horizon-message != "": Text {
            text: HomeState.horizon-message;
            font-size: 12.5px;
            color: Theme.navy2;
            wrap: word-wrap;
        }
    }

    // à droite : la bannière, puis supprimer et Choisir
    Rectangle {
        width: 340px;
        border-radius: 18px;
        background: Theme.panel-strong;
        border-width: 1.5px;
        border-color: Theme.glass-border;
        VerticalLayout {
            padding: 14px;
            spacing: 10px;
            Rectangle {
                height: 200px;
                border-radius: 14px;
                clip: true;
                Image {
                    // comme les mises à jour : le bas visible s'arrête juste sous le sol
                    x: 0;
                    width: parent.width;
                    height: max(parent.height, parent.width * 90 / 160);
                    y: min(0px, parent.height - self.height * 82 / 90);
                    source: HomeState.horizon-art;
                    image-fit: fill;
                    image-rendering: pixelated;
                }
                Rectangle {
                    background: @linear-gradient(0deg, #120A1CE6 0%, #120A1C80 55%, #120A1C00 100%);
                }
                VerticalLayout {
                    padding: 14px;
                    spacing: 4px;
                    alignment: end;
                    PixelLabel {
                        text: Tr.t("Hz_Etiquette");
                        font-size: 10px;
                        color: #FFC2A8;
                    }
                    HorizontalLayout {
                        alignment: start;
                        OutlinedText {
                            text: "HORIZON";
                            font-size: 30px;
                            thickness: 3px;
                            depth: 3px;
                            stroke-color: #7A2E14;
                            shadow: #3A1408;
                        }
                    }
                    Text {
                        text: Tr.t("Hz_Titre");
                        font-size: 14px;
                        font-weight: 600;
                        color: white;
                        wrap: word-wrap;
                    }
                    Text {
                        text: HomeState.horizon-builds.length + " builds · Rust · MIT · " + Tr.t("Hz_Puce_Officiel");
                        font-size: 12px;
                        color: #F6D5C8;
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                if HomeState.horizon-build != "" && HomeState.horizon-build-installed: IconButton {
                    width: 38px;
                    height: 38px;
                    icon: "\u{E74D}";
                    icon-size: 13px;
                    tooltip: Tr.t("Hz_Supprimer");
                    enabled: !HomeState.horizon-busy;
                    clicked => { HomeState.horizon-remove(HomeState.horizon-build); }
                }
                MButton {
                    horizontal-stretch: 1;
                    kind: 1;
                    icon: "\u{E73E}";
                    enabled: HomeState.horizon-build != "";
                    text: HomeState.horizon-build != "" ? Tr.t("Ver_Choisir") + " Horizon " + HomeState.horizon-build : Tr.t("Hz_ChoisisBuild");
                    clicked => {
                        HomeState.horizon-select(HomeState.horizon-build);
                        HomeState.picker-open = false;
                    }
                }
            }
        }
    }
}

export component VersionPicker inherits Rectangle {
    property <bool> ouvert: HomeState.picker-open;
    property <bool> a-groupe: HomeState.picker-group >= 0 && HomeState.picker-group < HomeState.picker-groups.length;
    property <VersionGroup> groupe: self.a-groupe ? HomeState.picker-groups[HomeState.picker-group] : { title: "", name: "" };
    opacity: root.ouvert ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity { duration: root.ouvert ? 200ms : 150ms; easing: ease-out; }

    // dans la zone centrale de la fenêtre (à la place de la page) : pas de voile, pas de fenêtre
    // flottante ; le contenu repose sur le paysage, les affiches tombent une à une
    carte := Rectangle {
        clip: true;
        TouchArea { }

        VerticalLayout {
            padding: 0px;
            spacing: 14px;

            // ── En-tête ──
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: Tr.t("Ver_Titre");
                    font-size: 24px;
                    font-weight: 600;
                    color: Theme.navy;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                if !HomeState.picker-misty && !HomeState.picker-horizon: VerticalLayout {
                    alignment: center;
                    GlassInput {
                        width: 230px;
                        height: 38px;
                        search: true;
                        placeholder: Tr.t("Ver_Recherche");
                        text <=> HomeState.picker-search;
                        edited => { HomeState.picker-changed(); }
                    }
                }
                BoutonRond {
                    icone: "fermer";
                    taille: 44px;
                    tooltip: Tr.t("Commun_Fermer");
                    clicked => { HomeState.picker-open = false; }
                }
            }

            // ── Filtres : types de versions, puis Misty Client et Horizon ──
            if !HomeState.picker-misty: HorizontalLayout {
                spacing: 6px;
                for i in (HomeState.picker-horizon ? 0 : 4): Puce {
                    property <[string]> noms: [Tr.t("Ver_Releases"), "Snapshots", Tr.t("Ver_Betas"), "Alphas"];
                    text: self.noms[i];
                    point: Couleurs.types[i];
                    checked: !HomeState.picker-horizon && !HomeState.picker-misty && (i == 0 ? HomeState.picker-release : i == 1 ? HomeState.picker-snapshot : i == 2 ? HomeState.picker-beta : HomeState.picker-alpha);
                    clicked => {
                        // depuis Misty ou Horizon : on revient aux versions, sans changer les filtres
                        if (HomeState.picker-horizon || HomeState.picker-misty) {
                            HomeState.picker-horizon = false;
                            HomeState.picker-misty = false;
                            return;
                        }
                        // au moins un type reste coché : sinon la liste serait vide
                        if (self.checked && (HomeState.picker-release ? 1 : 0) + (HomeState.picker-snapshot ? 1 : 0) + (HomeState.picker-beta ? 1 : 0) + (HomeState.picker-alpha ? 1 : 0) <= 1) {
                            return;
                        }
                        if (i == 0) { HomeState.picker-release = !HomeState.picker-release; }
                        if (i == 1) { HomeState.picker-snapshot = !HomeState.picker-snapshot; }
                        if (i == 2) { HomeState.picker-beta = !HomeState.picker-beta; }
                        if (i == 3) { HomeState.picker-alpha = !HomeState.picker-alpha; }
                        HomeState.picker-changed();
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                // Horizon : nightlies ou versions stables
                if HomeState.picker-horizon: HorizontalLayout {
                    spacing: 6px;
                    for f[i] in [Tr.t("Ver_TousLoaders"), "Nightly", Tr.t("Hz_Stables")]: Puce {
                        text: f;
                        point: i == 1 ? #FFBE5A : i == 2 ? #4ADE80 : transparent;
                        checked: HomeState.horizon-filter == i;
                        clicked => {
                            HomeState.horizon-filter = i;
                            HomeState.horizon-filter-changed();
                        }
                    }
                }
            }

            // Misty Client et Horizon : leur panneau sur toute la largeur
            if HomeState.picker-misty: PanneauMisty {
                vertical-stretch: 1;
            }
            if HomeState.picker-horizon: PanneauHorizon {
                vertical-stretch: 1;
            }

            // ── Versions : les affiches des mises à jour, le détail à droite ──
            if !HomeState.picker-horizon && !HomeState.picker-misty: HorizontalLayout {
                vertical-stretch: 1;
                spacing: 16px;

                affiches := ScrollView {
                    horizontal-stretch: 1;
                    content-width: self.visible-width;
                    content-height: HomeState.picker-groups.length * 80px + 8px;
                    for g[i] in HomeState.picker-groups: LigneGroupe {
                        x: 4px;
                        // elles glissent du haut quand le choix s'ouvre, l'une après l'autre
                        y: 4px + i * 80px + (root.ouvert ? 0px : -40px);
                        opacity: root.ouvert ? 1 : 0;
                        animate y { duration: 420ms; delay: root.ouvert ? min(i, 12) * 30ms : 0ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                        animate opacity { duration: 260ms; delay: root.ouvert ? min(i, 12) * 30ms : 0ms; easing: ease-out; }
                        width: affiches.visible-width - 8px;
                        g: g;
                        checked: i == HomeState.picker-group;
                        clicked => { HomeState.picker-group-selected(i); }
                    }
                    if HomeState.picker-groups.length == 0: Text {
                        x: 0;
                        y: 40px;
                        width: affiches.visible-width;
                        text: Tr.t("Ver_Aucune");
                        font-size: 13px;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                // détail de la mise à jour choisie : versions, mod loader, et un bouton qui confirme
                Rectangle {
                    width: 340px;
                    border-radius: 18px;
                    background: Theme.panel-strong;
                    border-width: 1.5px;
                    border-color: Theme.glass-border;
                    if !root.a-groupe: Text {
                        width: parent.width - 40px;
                        text: Tr.t("Ver_LoadersAttente");
                        font-size: 13px;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    if root.a-groupe: VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        // bannière
                        Rectangle {
                            height: 120px;
                            border-radius: 14px;
                            clip: true;
                            Image {
                                x: 0;
                                width: parent.width;
                                height: max(parent.height, parent.width * 90 / 160);
                                y: min(0px, parent.height - self.height * 82 / 90);
                                source: root.groupe.art;
                                image-fit: fill;
                                image-rendering: pixelated;
                            }
                            Rectangle {
                                background: @linear-gradient(0deg, #07090CD9 0%, #07090C00 70%);
                            }
                            VerticalLayout {
                                padding: 12px;
                                alignment: end;
                                spacing: 2px;
                                HorizontalLayout {
                                    alignment: start;
                                    OutlinedText {
                                        text: root.groupe.title;
                                        font-size: 28px;
                                        thickness: 3px;
                                        depth: 3px;
                                        stroke-color: #1A1C21;
                                        shadow: #07090C;
                                    }
                                }
                                Text {
                                    text: root.groupe.name;
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: white;
                                    overflow: elide;
                                }
                            }
                        }
                        PixelLabel {
                            text: Tr.t("Ver_Onglet_Versions");
                            font-size: 11px;
                        }
                        grille := ScrollView {
                            vertical-stretch: 1;
                            property <int> colonnes: 3;
                            property <length> largeur: (self.visible-width - 8px - (self.colonnes - 1) * 6px) / self.colonnes;
                            content-width: self.visible-width;
                            content-height: ceil(HomeState.picker-sub.length / self.colonnes) * 46px + 8px;
                            for v[i] in HomeState.picker-sub: PuceVersion {
                                x: 4px + Math.mod(i, grille.colonnes) * (grille.largeur + 6px);
                                y: 4px + floor(i / grille.colonnes) * 46px;
                                width: grille.largeur;
                                height: 38px;
                                v: v;
                                checked: HomeState.quick && !HomeState.horizon-selected && !HomeState.misty-selected && v.id == HomeState.card-version;
                                clicked => { HomeState.version-picked(v.id); }
                            }
                        }
                        PixelLabel {
                            text: Tr.t("Commun_ModLoader");
                            font-size: 11px;
                        }
                        // loaders : 3 par ligne
                        Rectangle {
                            property <int> lignes: max(1, ceil(HomeState.modes.length / 3));
                            property <length> largeur: (self.width - 2 * 6px) / 3;
                            height: self.lignes * 46px - 6px;
                            for m[i] in HomeState.modes: CarteLoader {
                                x: Math.mod(i, 3) * (parent.largeur + 6px);
                                y: floor(i / 3) * 46px;
                                width: parent.largeur;
                                height: 40px;
                                text: m;
                                checked: i == HomeState.mode-index;
                                enabled: HomeState.modes-enabled;
                                clicked => {
                                    HomeState.mode-index = i;
                                    HomeState.mode-selected(i);
                                }
                            }
                            if HomeState.modes.length == 0: Text {
                                text: Tr.t("Ver_ChoisisVersion");
                                font-size: 12.5px;
                                color: Theme.text-muted;
                            }
                        }
                        MButton {
                            kind: 1;
                            icon: "\u{E73E}";
                            enabled: HomeState.modes.length > 0;
                            text: HomeState.mode-index >= 0 && HomeState.mode-index < HomeState.modes.length
                                ? Tr.t("Ver_Choisir") + " " + HomeState.card-version + " · " + HomeState.modes[HomeState.mode-index]
                                : Tr.t("Ver_Valider");
                            clicked => { HomeState.picker-open = false; }
                        }
                    }
                }
            }

        }
    }
}
