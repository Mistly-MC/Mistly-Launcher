//
// Console des parties : la sortie de Minecraft ou d'Horizon en direct, dans une grande tuile sous
// la rangée du haut de la fenêtre.
// Une partie = un panneau ; plusieurs parties lancées en même temps partagent l'écran
// (2 côte à côte, 4 en 2 × 2, jusqu'à 6 en 3 × 2), et un panneau peut être agrandi seul.
// Couleurs claires ou sombres selon le thème. Rust remplit ConsoleState.

import { Theme, Tr } from "theme.slint";
import { Icon, IconeNuit, BoutonRond, MButton } from "widgets.slint";
import { AppState } from "state.slint";
import { ListView } from "std-widgets.slint";

export struct LogLine {
    text: string,
    /// découpée pour les colonnes (heure, niveau, message) ; l'heure est vide pour une ligne
    /// qui continue la précédente (pile d'appels…)
    time: string,
    lvl: string,
    msg: string,
    /// 0 info · 1 avertissement · 2 erreur · 3 message de Misty
    level: int,
}

/// Une partie affichée dans la console.
export struct LogPane {
    id: int,
    title: string,
    /// « En cours · 03:12 », « Fermé · joué 12:04 », « Planté (code 1) · après 00:42 »
    state-text: string,
    running: bool,
    crashed: bool,
    warnings: int,
    errors: int,
    /// Après « Envoyer les logs » : le code du rapport
    report-text: string,
    sending: bool,
    lines: [LogLine],
}

export global ConsoleState {
    in-out property <bool> open;
    in property <[LogPane]> panes;
    /// « 2 parties en cours », etc.
    in property <string> subtitle;
    in property <int> warnings;
    in property <int> errors;
    /// Panneau agrandi (index dans panes), -1 : tous côte à côte
    in-out property <int> focused: -1;
    /// 0 tout · 1 avertissements et erreurs · 2 erreurs (pour tous les panneaux)
    in-out property <int> filter: 0;
    in-out property <string> search;
    callback filter-changed();
    callback open-folder();
    callback copy(int);
    /// Copier les lignes affichées de first à last (comprises) d'un panneau
    callback copy-lines(int, int, int);
    callback send-report(int);
    callback kill(int);
    callback close-pane(int);
}

/// Couleurs de la console : claires avec le thème clair, sombres avec le thème sombre.
global CC {
    out property <bool> d: Theme.dark;
    out property <color> voile: Theme.bg;
    /// cadre des lignes
    out property <color> zone: Theme.surface;
    out property <color> entete: Theme.surface-2;
    out property <color> bord: Theme.border;
    out property <color> titre: Theme.ink-strong;
    out property <color> sous-titre: Theme.ink-3;
    out property <color> discret: Theme.ink-3;
    out property <color> vide: Theme.ink-4;
    // boutons et filtres
    out property <color> bouton: Theme.control;
    out property <color> bouton-survol: Theme.border-strong;
    out property <color> bouton-appui: Theme.border-strong;
    out property <color> bouton-bord: Theme.border-strong;
    out property <color> encre: Theme.ink;
    out property <color> danger: d ? #FF8A98 : #C8243A;
    out property <color> filtre-actif: Theme.active;
    out property <color> filtre-survol: Theme.control;
    out property <color> filtre-bord: transparent;
    out property <color> filtre-texte: Theme.ink-4;
    // lignes
    out property <color> info: Theme.ink-2;
    out property <color> avert: d ? #FFC46B : #A85F00;
    out property <color> erreur: d ? #FF7A8A : #C8243A;
    out property <color> misty: Theme.ink-strong;
    out property <color> succes: Theme.online-text;
    out property <color> bleu: Theme.ink-3;
    /// lignes sélectionnées
    out property <color> selection: d ? #FFFFFF1F : #1C23351A;
}

/// Bouton de la console (texte et/ou icône).
component BoutonConsole inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> danger;
    in property <bool> enabled: true;
    in property <length> taille: 34px;
    callback clicked;
    height: root.taille;
    width: root.text == "" ? root.taille : contenu.preferred-width + 24px;
    border-radius: 14px;
    background: zone.pressed && root.enabled ? CC.bouton-appui : zone.has-hover && root.enabled ? (root.danger ? #FF5A6E33 : CC.bouton-survol) : CC.bouton;
    border-width: 1.5px;
    border-color: root.danger ? #FF5A6E66 : CC.bouton-bord;
    opacity: root.enabled ? 1 : 0.5;
    animate background { duration: 120ms; }
    contenu := HorizontalLayout {
        alignment: center;
        spacing: 7px;
        if root.icon != "": Icon {
            text: root.icon;
            font-size: root.taille * 0.38;
            color: root.danger ? CC.danger : CC.encre;
            vertical-alignment: center;
        }
        if root.text != "": Text {
            text: root.text;
            font-family: Theme.ui-font;
            font-size: 12.5px;
            font-weight: 600;
            color: root.danger ? CC.danger : CC.encre;
            vertical-alignment: center;
        }
    }
    zone := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Filtre (Tout, Avertissements, Erreurs), avec son compteur.
component FiltreConsole inherits Rectangle {
    in property <string> text;
    in property <string> count;
    in property <color> pastille;
    in property <bool> checked;
    callback clicked;
    height: 34px;
    width: ligne.preferred-width + 28px;
    border-radius: 17px;
    // le fond blanc est la pastille qui glisse (ConsoleOverlay) ; ici, seulement le survol
    background: !root.checked && zone.has-hover ? Theme.control : transparent;
    animate background { duration: Theme.fast; }
    ligne := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        Text {
            text: root.text;
            font-family: Theme.sans-font;
            font-size: 13px;
            font-weight: 500;
            color: root.checked ? Theme.on-active : Theme.ink-4;
            animate color { duration: 200ms; }
            vertical-alignment: center;
        }
        if root.count != "": Text {
            text: root.count;
            font-family: Theme.mono-font;
            font-size: 12px;
            color: root.checked ? Theme.on-active : root.pastille;
            vertical-alignment: center;
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Le panneau d'une partie : en-tête (état, compteurs, actions) et ses lignes.
component PanneauLogs inherits Rectangle {
    in property <LogPane> p;
    in property <int> index;
    /// hauteur d'une ligne de journal
    property <length> pas: 25px;
    property <bool> suivre: true;
    property <bool> agrandi: ConsoleState.focused == root.index;
    /// panneau étroit (4 ou 6 parties) : boutons sans texte
    property <bool> compact: root.width < 620px;
    /// lignes sélectionnées (ancre : là où le clic a commencé), -1 : aucune
    property <int> ancre: -1;
    property <int> fin: -1;
    property <int> sel-debut: min(root.ancre, root.fin);
    property <int> sel-fin: max(root.ancre, root.fin);
    property <bool> a-selection: root.ancre >= 0 && root.fin >= 0;
    // filtre ou recherche changés : les numéros de ligne aussi, la sélection s'en va
    property <int> filtre: ConsoleState.filter;
    property <string> recherche: ConsoleState.search;
    changed filtre => { root.deselectionner(); }
    changed recherche => { root.deselectionner(); }
    function deselectionner() {
        root.ancre = -1;
        root.fin = -1;
    }
    /// Copier : la sélection, sinon tout le journal
    function copier() {
        if (root.a-selection) {
            ConsoleState.copy-lines(root.p.id, root.sel-debut, root.sel-fin);
        } else {
            ConsoleState.copy(root.p.id);
        }
    }

    border-radius: 24px;
    background: CC.zone;
    border-width: 1.5px;
    border-color: root.p.crashed ? #FF5A6E66 : CC.bord;
    clip: true;

    VerticalLayout {
        // ── en-tête de la partie (plusieurs parties : seule, ses actions sont en haut) ──
        if ConsoleState.panes.length > 1: Rectangle {
            height: 46px;
            background: CC.entete;
            TouchArea {
                double-clicked => { ConsoleState.focused = root.agrandi ? -1 : root.index; }
            }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 8px;
                spacing: 10px;
                Rectangle {
                    width: 9px;
                    height: 9px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 8px;
                    background: root.p.running ? #4ADE80 : root.p.crashed ? #FF5A6E : CC.discret;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: root.p.title;
                        font-family: Theme.ui-font;
                        font-size: 13.5px;
                        font-weight: 600;
                        color: CC.titre;
                        overflow: elide;
                    }
                    Text {
                        text: root.p.report-text != "" ? root.p.report-text : root.p.state-text;
                        font-family: Theme.ui-font;
                        font-size: 11.5px;
                        color: root.p.report-text != "" ? CC.succes : root.p.crashed ? CC.danger : CC.sous-titre;
                        overflow: elide;
                    }
                }
                // compteurs
                if root.p.warnings > 0 && !root.compact: HorizontalLayout {
                    spacing: 4px;
                    Icon {
                        text: "\u{E7BA}";
                        font-size: 11px;
                        color: CC.avert;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.p.warnings;
                        font-family: Theme.mono-font;
                        font-size: 11.5px;
                        color: CC.avert;
                        vertical-alignment: center;
                    }
                }
                if root.p.errors > 0: HorizontalLayout {
                    spacing: 4px;
                    Icon {
                        text: "\u{E783}";
                        font-size: 11px;
                        color: CC.erreur;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.p.errors;
                        font-family: Theme.mono-font;
                        font-size: 11.5px;
                        color: CC.erreur;
                        vertical-alignment: center;
                    }
                }
                // actions
                HorizontalLayout {
                    spacing: 5px;
                    alignment: end;
                    VerticalLayout {
                        alignment: center;
                        BoutonConsole {
                            taille: 30px;
                            icon: "\u{E8C8}";
                            text: root.a-selection && !root.compact ? Tr.t("Console_CopierSelection") : "";
                            clicked => { root.copier(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        BoutonConsole {
                            taille: 30px;
                            icon: "\u{E898}";
                            text: root.compact ? "" : root.p.sending ? Tr.t("Console_Envoi") : Tr.t("Console_Envoyer");
                            enabled: !root.p.sending;
                            clicked => { ConsoleState.send-report(root.p.id); }
                        }
                    }
                    if root.p.running: VerticalLayout {
                        alignment: center;
                        BoutonConsole {
                            taille: 30px;
                            icon: "\u{E71A}";
                            text: root.compact ? "" : Tr.t("Console_Arreter");
                            danger: true;
                            clicked => { ConsoleState.kill(root.p.id); }
                        }
                    }
                    if ConsoleState.panes.length > 1: VerticalLayout {
                        alignment: center;
                        BoutonConsole {
                            taille: 30px;
                            icon: root.agrandi ? "\u{E73F}" : "\u{E740}";
                            clicked => { ConsoleState.focused = root.agrandi ? -1 : root.index; }
                        }
                    }
                    if !root.p.running: VerticalLayout {
                        alignment: center;
                        BoutonConsole {
                            taille: 30px;
                            icon: "\u{E711}";
                            clicked => { ConsoleState.close-pane(root.p.id); }
                        }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: CC.bord;
            }
        }

        // ── lignes ──
        Rectangle {
            vertical-stretch: 1;
            clavier := FocusScope {
                key-pressed(e) => {
                    if (e.modifiers.control && (e.text == "c" || e.text == "C")) {
                        root.copier();
                        return accept;
                    }
                    if (e.modifiers.control && (e.text == "a" || e.text == "A") && root.p.lines.length > 0) {
                        root.ancre = 0;
                        root.fin = root.p.lines.length - 1;
                        return accept;
                    }
                    if (e.text == Key.Escape && root.a-selection) {
                        root.deselectionner();
                        return accept;
                    }
                    return reject;
                }
            }
            liste := ListView {
                x: 10px;
                y: 14px;
                width: parent.width - 20px;
                height: parent.height - 28px;
                // clic : une ligne ; glisser ou Maj+clic : plusieurs ; Ctrl+C copie, Ctrl+A tout
                for l[i] in root.p.lines: Rectangle {
                    height: root.pas;
                    border-radius: 3px;
                    background: root.a-selection && i >= root.sel-debut && i <= root.sel-fin ? CC.selection : transparent;
                    TouchArea {
                        mouse-cursor: text;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                if (e.modifiers.shift && root.ancre >= 0) {
                                    root.fin = i;
                                } else {
                                    root.ancre = i;
                                    root.fin = i;
                                }
                                clavier.focus();
                            }
                        }
                        // le glisser reste à la ligne où il a commencé : la ligne visée se déduit de la hauteur
                        moved => {
                            if (self.pressed) {
                                root.fin = clamp(i + floor(self.mouse-y / root.pas), 0, root.p.lines.length - 1);
                            }
                        }
                    }
                    // avertissements et erreurs : la ligne entière teintée
                    if l.level == 1 || l.level == 2: Rectangle {
                        border-radius: 3px;
                        background: (l.level == 2 ? CC.erreur : CC.avert).with-alpha(0.07);
                    }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 10px;
                        spacing: 18px;
                        Text {
                            width: 34px;
                            text: i + 1;
                            font-family: Theme.mono-font;
                            font-size: 12px;
                            color: CC.vide.with-alpha(0.6);
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        Text {
                            width: root.compact ? 0px : 62px;
                            visible: !root.compact;
                            text: l.time;
                            font-family: Theme.mono-font;
                            font-size: 12.5px;
                            color: CC.discret;
                            vertical-alignment: center;
                        }
                        Text {
                            width: 50px;
                            text: l.time == "" && l.lvl == "INFO" ? "" : l.lvl;
                            font-family: Theme.mono-font;
                            font-size: 12.5px;
                            color: l.level == 2 ? CC.erreur : l.level == 1 ? CC.avert : l.level == 3 ? CC.misty : CC.discret;
                            vertical-alignment: center;
                            overflow: clip;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: l.msg;
                            font-family: Theme.mono-font;
                            font-size: 12.5px;
                            color: l.level == 2 ? CC.erreur : l.level == 1 ? CC.avert : l.level == 3 ? CC.misty : CC.encre;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
                scrolled => {
                    // on suit le bas tant que le joueur n'est pas remonté
                    root.suivre = self.content-y <= self.visible-height - self.content-height + root.pas;
                }
            }
            if root.p.lines.length == 0: Text {
                text: ConsoleState.search != "" || ConsoleState.filter != 0 ? Tr.t("Console_RienTrouve") : Tr.t("Console_Attente");
                font-family: Theme.ui-font;
                font-size: 13px;
                color: CC.vide;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            // revenir en bas
            if !root.suivre && root.p.lines.length > 0: Rectangle {
                x: parent.width - self.width - 14px;
                y: parent.height - self.height - 12px;
                width: bas.preferred-width + 24px;
                height: 32px;
                border-radius: 22px;
                background: zone-bas.has-hover ? #3B82F6 : #2563EB;
                drop-shadow-blur: 14px;
                drop-shadow-color: CC.d ? #00000088 : #1C233540;
                bas := HorizontalLayout {
                    alignment: center;
                    spacing: 7px;
                    Icon {
                        text: "\u{E74B}";
                        font-size: 12px;
                        color: white;
                        vertical-alignment: center;
                    }
                    Text {
                        text: Tr.t("Console_Suivre");
                        font-family: Theme.ui-font;
                        font-size: 12px;
                        font-weight: 600;
                        color: white;
                        vertical-alignment: center;
                    }
                }
                zone-bas := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.suivre = true;
                        liste.content-y = min(0px, liste.visible-height - root.p.lines.length * root.pas);
                    }
                }
            }
        }
    }

    // nouvelles lignes, ou panneau redimensionné : on reste collé en bas
    property <int> nb-lignes: root.p.lines.length;
    changed nb-lignes => {
        if (root.suivre) {
            liste.content-y = min(0px, liste.visible-height - root.p.lines.length * root.pas);
        }
    }
    changed height => {
        if (root.suivre) {
            liste.content-y = min(0px, liste.visible-height - root.p.lines.length * root.pas);
        }
    }
    init => {
        liste.content-y = min(0px, liste.visible-height - root.p.lines.length * root.pas);
    }
}

/// La console : une grande tuile sous la rangée du haut de la fenêtre (logo, onglets, Console,
/// boutons de la fenêtre), qui reste visible et utilisable. main.slint la place.
export component ConsoleOverlay inherits Rectangle {
    // rien ne passe au launcher derrière
    TouchArea { }
    background: Theme.bg;

    Rectangle {
        VerticalLayout {
            padding-bottom: 40px;
            // ── en-tête (Figma) : titre, état de la partie, filtres, dossier, fermer ──
            entete := HorizontalLayout {
                height: 52px;
                padding-left: 8px;
                spacing: 12px;
                Text {
                    text: Tr.t("Console_Titre");
                    font-family: Theme.sans-font;
                    font-size: 32px;
                    font-weight: 600;
                    letter-spacing: -1px;
                    color: Theme.ink-strong;
                    vertical-alignment: center;
                }
                // l'état des parties, ou le code du rapport envoyé
                property <string> puce: ConsoleState.panes.length == 1 && ConsoleState.panes[0].report-text != "" ? ConsoleState.panes[0].report-text : ConsoleState.subtitle;
                if entete.puce != "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 28px;
                        width: min(sous-titre.preferred-width, 420px) + 34px;
                        border-radius: 14px;
                        background: Theme.online-bg;
                        Rectangle {
                            x: 12px;
                            width: 7px;
                            height: 7px;
                            border-radius: 3.5px;
                            background: Theme.online;
                        }
                        sous-titre := Text {
                            x: 25px;
                            width: min(self.preferred-width, 420px);
                            text: entete.puce;
                            overflow: elide;
                            font-family: Theme.sans-font;
                            font-size: 12.5px;
                            color: Theme.online-text;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 44px;
                        width: filtres.preferred-width;
                        border-radius: 22px;
                        background: Theme.surface-2;
                        border-width: 1.5px;
                        border-color: Theme.border-field;
                        // la pastille blanche glisse vers le filtre choisi (comme le choix de l'édition)
                        property <length> pastille-x: ConsoleState.filter == 0 ? f0.x : ConsoleState.filter == 1 ? f1.x : f2.x;
                        property <length> pastille-l: ConsoleState.filter == 0 ? f0.width : ConsoleState.filter == 1 ? f1.width : f2.width;
                        Rectangle {
                            x: parent.pastille-x;
                            y: (parent.height - self.height) / 2;
                            width: parent.pastille-l;
                            height: 34px;
                            border-radius: 17px;
                            background: Theme.active;
                            animate x, width { duration: 320ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                        }
                        filtres := HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            spacing: 2px;
                            alignment: center;
                            f0 := FiltreConsole {
                                y: (parent.height - self.height) / 2;
                                text: Tr.t("Console_Tout");
                                count: "";
                                checked: ConsoleState.filter == 0;
                                clicked => { ConsoleState.filter = 0; ConsoleState.filter-changed(); }
                            }
                            f1 := FiltreConsole {
                                y: (parent.height - self.height) / 2;
                                text: Tr.t("Console_Avertissements");
                                count: ConsoleState.warnings > 0 ? "" + ConsoleState.warnings : "";
                                pastille: CC.avert;
                                checked: ConsoleState.filter == 1;
                                clicked => { ConsoleState.filter = 1; ConsoleState.filter-changed(); }
                            }
                            f2 := FiltreConsole {
                                y: (parent.height - self.height) / 2;
                                text: Tr.t("Console_Erreurs");
                                count: ConsoleState.errors > 0 ? "" + ConsoleState.errors : "";
                                pastille: CC.erreur;
                                checked: ConsoleState.filter == 2;
                                clicked => { ConsoleState.filter = 2; ConsoleState.filter-changed(); }
                            }
                        }
                    }
                }
                // une seule partie : ses actions ici (plusieurs : dans chaque panneau)
                if ConsoleState.panes.length == 1: BoutonRond {
                    icone: "copier";
                    taille: 44px;
                    tooltip: Tr.t("Console_Copier");
                    clicked => { ConsoleState.copy(ConsoleState.panes[0].id); }
                }
                BoutonRond {
                    icone: "dossier";
                    taille: 44px;
                    tooltip: Tr.t("Console_Dossier");
                    clicked => { ConsoleState.open-folder(); }
                }
                if ConsoleState.panes.length == 1 && ConsoleState.panes[0].running: BoutonRond {
                    icone: "stop";
                    taille: 44px;
                    tooltip: Tr.t("Console_Arreter");
                    clicked => { ConsoleState.kill(ConsoleState.panes[0].id); }
                }
                if ConsoleState.panes.length == 1 && !ConsoleState.panes[0].running: BoutonRond {
                    icone: "poubelle";
                    taille: 44px;
                    tooltip: Tr.t("Console_FermerPartie");
                    clicked => { ConsoleState.close-pane(ConsoleState.panes[0].id); }
                }
                BoutonRond {
                    icone: "fermer";
                    taille: 44px;
                    tooltip: Tr.t("Console_Fermer");
                    clicked => { ConsoleState.open = false; }
                }
                if ConsoleState.panes.length == 1: VerticalLayout {
                    alignment: center;
                    MButton {
                        kind: 1;
                        height: 44px;
                        text: ConsoleState.panes[0].sending ? Tr.t("Console_Envoi")
                            : ConsoleState.panes[0].report-text != "" ? Tr.t("Console_Envoye_Court")
                            : Tr.t("Console_Envoyer");
                        enabled: !ConsoleState.panes[0].sending;
                        clicked => { ConsoleState.send-report(ConsoleState.panes[0].id); }
                    }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                padding-top: 18px;
                // ── les parties, en écran partagé ──
                grille := Rectangle {
                    vertical-stretch: 1;
                    property <length> ecart: 12px;
                    property <bool> un-seul: ConsoleState.focused >= 0 && ConsoleState.focused < ConsoleState.panes.length;
                    property <int> n: self.un-seul ? 1 : ConsoleState.panes.length;
                    property <int> colonnes: self.n <= 1 ? 1 : self.n <= 4 ? 2 : 3;
                    property <int> rangees: max(1, ceil(self.n / self.colonnes));
                    property <length> h: (self.height - (self.rangees - 1) * self.ecart) / self.rangees;
        
                    for p[i] in ConsoleState.panes: PanneauLogs {
                        property <bool> cache: grille.un-seul && ConsoleState.focused != i;
                        // place dans la grille (un panneau agrandi prend la place 0)
                        property <int> k: grille.un-seul ? 0 : i;
                        property <int> rangee: floor(self.k / grille.colonnes);
                        // la dernière rangée, si elle est incomplète, partage sa largeur entre ses panneaux
                        property <int> dans-rangee: self.rangee == grille.rangees - 1 ? grille.n - self.rangee * grille.colonnes : grille.colonnes;
                        property <int> colonne: self.k - self.rangee * grille.colonnes;
                        property <length> l: (grille.width - (self.dans-rangee - 1) * grille.ecart) / self.dans-rangee;
                        visible: !self.cache;
                        p: p;
                        index: i;
                        x: self.colonne * (self.l + grille.ecart);
                        y: self.rangee * (grille.h + grille.ecart);
                        width: self.cache ? 0px : self.l;
                        height: self.cache ? 0px : grille.h;
                    }

                    if ConsoleState.panes.length == 0: Rectangle {
                        border-radius: 24px;
                        background: CC.zone;
                        border-width: 1.5px;
                        border-color: CC.bord;
                        Text {
                            text: Tr.t("Console_Vide");
                            font-family: Theme.ui-font;
                            font-size: 14px;
                            color: CC.vide;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
